+        control.write_all(&[1]).await.unwrap();
+        let _ = pty.write_input_cancellable(b"!\n").await;
+
+        let mut observed_ack = false;
+        let mut ack_code = None;
+        let drain = async {
+            while let Some(msg) = socket.next().await {
