+            .await
+            .unwrap()
+            .unwrap()
+            .unwrap();
+        assert_eq!(echoed, Message::Text("hello".into()));
+        drop(socket);
+        let head = tokio::time::timeout(LIMIT, recorded)
+            .await
+            .unwrap()
+            .unwrap();
+        let target = format!("relay.qa.invalid:{}", upstream.port());
+        assert!(
+            head.starts_with(&format!("CONNECT {target} HTTP/1.1\r\n")),
+            "{head}"
+        );
