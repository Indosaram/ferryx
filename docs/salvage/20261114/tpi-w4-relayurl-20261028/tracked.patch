+        assert_eq!(response.resolved_relay_url_source.as_deref(), Some("env"));
+        assert_eq!(response.machine_id.as_deref(), Some("m-1"));
+        let wire = serde_json::to_value(&response).unwrap();
+        assert_eq!(wire["resolvedRelayUrl"], primary);
