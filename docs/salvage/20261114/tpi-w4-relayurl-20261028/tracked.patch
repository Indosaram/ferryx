+/// How long `up` waits for a just-enabled relay tunnel before reporting its current state.
+const RELAY_CONNECT_WAIT: std::time::Duration = std::time::Duration::from_secs(10);
+
+/// The relay a gateway in `config` connects to, and where that URL came from.
+fn effective_relay_url(
+    config_mode: crate::remote::RemoteNetworkMode,
+    relay_url: Option<&str>,
+) -> (Option<String>, Option<&'static str>) {
+    if config_mode != crate::remote::RemoteNetworkMode::Relay {
+        return (None, None);
+    }
+    let (url, source) = crate::remote::state::resolve_relay_url(&crate::remote::RemoteGatewayConfig {
+        relay_url: relay_url.map(str::to_string),
+        ..Default::default()
+    });
+    (Some(url), Some(source.code()))
+}
+
+/// The relay a running daemon reports. Only the daemon's own resolution is used (it may come
+/// from the daemon's `FERRYX_RELAY_URL` or enrollment, which this CLI process cannot see). An
+/// older daemon or a relay that is not running reports none: then only a saved `relayUrl` is
+/// known for sure (it wins every other source); without one the URL is left unknown.
+fn live_status_from_daemon(status: &crate::daemon::DaemonRemoteStatus) -> RemoteLiveStatus {
+    let (relay_url, relay_url_source) = if status.mode != crate::remote::RemoteNetworkMode::Relay {
+        (None, None)
+    } else if let Some(url) = status.resolved_relay_url.clone() {
+        let source = status
+            .resolved_relay_url_source
+            .as_deref()
+            .and_then(crate::remote::state::RelayUrlSource::from_code)
+            .map(crate::remote::state::RelayUrlSource::code);
+        (Some(url), source)
+    } else {
+        match status.relay_url.as_deref().map(str::trim).filter(|url| !url.is_empty()) {
+            Some(url) => (Some(url.to_string()), Some("config")),
+            None => (None, None),
+        }
+    };
+    RemoteLiveStatus {
+        daemon: "running",
+        mode: status.mode,
+        relay_connected: status.relay_connected,
+        relay_url,
+        relay_url_source,
+    }
+}
