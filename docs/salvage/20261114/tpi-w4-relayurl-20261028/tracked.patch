+        let failed_over = status_from_state(&state, None, None, None, vec![]);
+        assert_eq!(failed_over.resolved_relay_url.as_deref(), Some(standby));
+        assert_eq!(failed_over.resolved_relay_url_source.as_deref(), Some("env"));
