+) -> RemoteLiveStatus {
+    let (relay_url, relay_url_source) = effective_relay_url(saved.mode, saved.relay_url.as_deref());
+    RemoteLiveStatus {
+        daemon,
+        mode: saved.mode,
+        relay_connected: None,
+        relay_url,
+        relay_url_source,
+    }
+}
