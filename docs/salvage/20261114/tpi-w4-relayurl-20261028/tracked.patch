+            [
+                "https://relay.ferryx.dev",
+                "https://relay.ferryx.dev/host/m-1",
+                "https://relay.checka.cc.example",
+                "https://relay.ferryx.dev",
+            ]
+        );
+        assert_eq!(migrate_retired_relay_origins(&conn).unwrap(), 0, "idempotent");
+    }
