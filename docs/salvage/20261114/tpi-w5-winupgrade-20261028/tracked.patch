+        let (reply, after) = fixture
+            .server
+            .idle_request_upgrade(
+                staged_arg.clone(),
+                Some(KEY.into()),
+                recording_successor(&started, StandIn::Announces),
+                READY_BOUND,
+            )
+            .await;
+        assert_eq!(reply, refused(Some(1), None));
+        assert!(matches!(after, AfterFlush::Nothing));
