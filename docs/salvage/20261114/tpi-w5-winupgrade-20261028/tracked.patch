+                let failure = ControlFailure {
+                    code: control::CODE_UPGRADE_REFUSED.to_string(),
+                    live: None,
+                    reason: Some(reason.to_string()),
+                };
+                (ControlReply::Failed(failure), AfterFlush::Nothing)
+            }
+        }
+    }
