+    use crate::daemon::handover::SUCCESSOR_WAITING_TOKEN;
+    command
+        .stdin(std::process::Stdio::null())
+        .stdout(std::process::Stdio::piped())
+        .stderr(std::process::Stdio::null());
+    let spawned_at = std::time::Instant::now();
