+        disabled,
+        1,
+        std::future::pending(),
+    );
+    assert!(!is_running("stun-disabled-host", 1));
+    assert!(routes.direct_for("stun-disabled-host").is_none());
+    assert_eq!(offers.load(std::sync::atomic::Ordering::SeqCst), 0);
+}
