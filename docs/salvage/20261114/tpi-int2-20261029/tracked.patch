+    let long_home = "/home/a-very-long-corporate-directory-name/firstname.lastname.contractor";
+    let host = sample_host("long-home");
+    let socket = |root: &str| format!("{root}/helper.sock");
+
+    // XDG_RUNTIME_DIR wins when the home root would overflow sun_path.
+    let mut env = sample_posix_env(long_home);
+    env.runtime_dir = Some("/run/user/1000".to_string());
+    let home_root = format!("{long_home}/.ferryx/r/2026.1027.5/{}", host_digest(&host.id));
+    assert!(socket(&home_root).len() > 103, "fixture must overflow");
+    let location = qualified_location(&host, &env, "2026.1027.5").expect("runtime dir root");
+    assert_eq!(
+        location.root,
+        format!("/run/user/1000/ferryx/r/2026.1027.5/{}", host_digest(&host.id))
+    );
+    assert!(location.executable.starts_with(long_home), "binary stays in home");
+    assert!(socket(&location.root).len() <= 103);
+
+    // No runtime dir: a single private directory directly under /tmp.
+    env.runtime_dir = None;
+    let location = qualified_location(&host, &env, "2026.1027.5").expect("tmp root");
+    assert_eq!(
+        location.root,
+        format!("/tmp/ferryx-r-2026.1027.5-{}", host_digest(&host.id))
+    );
+    assert!(socket(&location.root).len() + "/private".len() <= 103);
+
+    // A runtime dir that is itself too long is skipped in favor of /tmp.
+    env.runtime_dir = Some(format!("{long_home}/{}", "x".repeat(40)));
+    let location = qualified_location(&host, &env, "2026.1027.5").expect("tmp root");
+    assert!(location.root.starts_with("/tmp/ferryx-r-"));
+
+    // A short home keeps the home-scoped root even with a runtime dir present.
+    let mut short = sample_posix_env("/home/indo");
+    short.runtime_dir = Some("/run/user/1000".to_string());
+    let location = qualified_location(&host, &short, "2026.1027.5").unwrap();
+    assert!(location.root.starts_with("/home/indo/.ferryx/r/2026.1027.5/"));
+
+    // Windows has no Unix socket limit and ignores the fallback.
+    let mut win = sample_windows_env(&format!("C:\\Users\\{}", "w".repeat(80)));
+    win.runtime_dir = Some("/run/user/1000".to_string());
+    let location = qualified_location(&host, &win, "2026.1027.5").unwrap();
+    assert!(location.root.contains("\\.ferryx\\r\\2026.1027.5\\"));
+}
