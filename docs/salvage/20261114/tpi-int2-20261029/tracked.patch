+                        && !label.starts_with('-')
+                        && !label.ends_with('-')
+                        && label.chars().all(|c| c.is_ascii_alphanumeric() || c == '-')
+                }) && port.parse::<u16>().is_ok_and(|port| port != 0)
+            });
+            if valid {
+                Ok(entry.to_owned())
+            } else {
+                Err(StunConfigError::InvalidEntry(entry.to_owned()))
+            }
+        })
+        .collect()
+}
