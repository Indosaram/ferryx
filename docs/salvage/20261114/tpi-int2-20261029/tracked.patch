+/// The shell family decides how to ask for an interactive login shell and how to print PATH.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum LoginShellKind {
+    Posix,
+    Csh,
+    Fish,
+    Nushell,
