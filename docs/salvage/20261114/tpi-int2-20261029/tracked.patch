+          macosMinimum: extra.macosMinimum ?? "10.15",
+          env: { FERRYX_APPROVE_PUBLISH: "1", FERRYX_RELEASE_FLOOR_WAIVER: "exported waiver must not help" },
+          ghCommand: join(tmp, "no-gh"),
