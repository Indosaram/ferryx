+    param($Executable, $WorkDir)
+    if ($Executable -eq $TempExe) { $prefix = "MOCK_TEMP" } else { $prefix = "MOCK_TARGET" }
+    if ($prefix -eq "MOCK_TARGET" -and $env:MOCK_CONCURRENT) {
