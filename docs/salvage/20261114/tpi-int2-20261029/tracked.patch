+/// like supervisor_linux::capture_notify_socket: run_daemon_headless calls it first.
+pub(crate) fn consume_successor_env() -> SuccessorEnv {
+    let state = successor_env();
+    std::env::remove_var(SUCCESSOR_ENV);
