+pub(crate) struct PendingLoginPath(std::sync::Arc<LoginPathCache>);
+
+#[cfg(test)]
+impl PendingLoginPath {
+    pub(crate) fn publish(&self, path: Option<OsString>) {
+        self.0.publish(path);
+    }
