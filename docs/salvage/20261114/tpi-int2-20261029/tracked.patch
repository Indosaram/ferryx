+    // publish-time minimum, even though minos 12.0 would pass 13.0.
+    [{ waiver: null, checks: [{ kind: "cli-darwin-universal", check: "macos-minos", limit: "10.15", measured: { x86_64: "12.0", arm64: "12.0" }, pass: true }] },
