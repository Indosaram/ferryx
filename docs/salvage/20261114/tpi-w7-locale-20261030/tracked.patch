+/// The `LANG=` value of a shell-style locale file (`/etc/locale.conf`, `/etc/default/locale`).
+fn parse_lang_assignment(text: &str) -> Option<String> {
+    text.lines()
+        .map(str::trim)
+        .filter(|line| !line.starts_with('#'))
+        .filter_map(|line| {
+            line.strip_prefix("export ")
+                .unwrap_or(line)
