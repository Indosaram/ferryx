+    match relay_url.map(str::trim).filter(|url| !url.is_empty()) {
+        Some(url) => (Some(url.to_string()), Some("config")),
+        None => (
+            Some(crate::remote::state::DEFAULT_RELAY_URL.to_string()),
+            Some("default"),
+        ),
+    }
+}
