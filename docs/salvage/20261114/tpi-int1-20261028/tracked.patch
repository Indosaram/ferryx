+fn printenv_program() -> &'static str {
+    ["/usr/bin/printenv", "/bin/printenv"]
+        .into_iter()
+        .find(|path| Path::new(path).is_file())
+        // NixOS and similar ship printenv only through PATH, which the rc chain has set by now.
+        .unwrap_or("printenv")
+}
