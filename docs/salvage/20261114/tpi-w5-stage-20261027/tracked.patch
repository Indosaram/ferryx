+        Some(&exe),
+        Some(&manifest_dir),
+        false,
+    );
+    assert_eq!(release, None);
+    let debug = crate::remote::server::resolve_dist_dir_with(
+        Some(&checkout),
+        Some(&exe),
+        Some(&manifest_dir),
+        true,
+    );
+    assert_eq!(debug, Some(checkout_dist.canonicalize().unwrap()));
