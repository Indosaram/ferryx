+export async function listenSshAuthPrompts(onPrompt: (prompt: SshAuthPrompt) => void): Promise<() => void> {
+  if (!isTauri()) {
+    return () => {};
+  }
+  const unlisten = await listen<SshAuthPrompt>(SSH_AUTH_PROMPT_EVENT, event => onPrompt(event.payload));
+  try {
