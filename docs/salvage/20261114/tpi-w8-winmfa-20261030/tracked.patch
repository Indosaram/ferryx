+        let text = "Host pasted-box\n  HostName 10.9.8.7\n  User dev\n  Port 2200\n";
+        let stored = import_config_into_store(&path, text, true).expect("system import")[0].clone();
+        assert_eq!(stored.connect_target(), "dev@pasted-box");
