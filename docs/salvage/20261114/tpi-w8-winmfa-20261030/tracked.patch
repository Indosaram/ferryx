+const UPLOAD_TOOLS_WITHOUT_DECODER: [&str; 14] = [
+    "dirname", "mkdir", "chmod", "rm", "mv", "tr", "sed", "grep", "ps", "sha256sum", "shasum",
+    "wc", "cat", "kill",
+];
