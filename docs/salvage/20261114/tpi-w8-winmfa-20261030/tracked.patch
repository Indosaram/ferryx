+    let mut args = vec!["-c".to_string(), script.to_string(), "fake-ssh".to_string()];
+    args.extend(["-o", "ControlMaster=auto", "-o", "ControlPath=/gone/x-%C", "-o", "ControlPersist=60", "u@h"].map(String::from));
