+    let script = r#"case "$*" in
+  *ControlMaster=auto*) echo "unix_listener: cannot bind to path /gone/x-abc.123: No such file or directory" >&2; exit 255;;
+  *ControlMaster=no*ControlPath=none*) printf 'direct:'; cat;;
+  *) exit 9;;
