+        "vb={}; cur={}; fx=\"${{vb%/*}}\"; \
+         tags=$(ls \"$vb\" 2>/dev/null | grep -E '^[0-9]+\\.[0-9]+\\.[0-9]+$' | sort -t. -k1,1n -k2,2n -k3,3n); \
