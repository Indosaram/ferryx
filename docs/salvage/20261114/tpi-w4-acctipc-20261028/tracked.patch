+async fn remote_status_output(
+    client: &crate::daemon::DaemonClient,
+    config_path: Option<&std::path::Path>,
+) -> RemoteStatusOutput {
+    match client.remote_get_status().await {
+        Ok(status) => RemoteStatusOutput {
+            status: "ok",
+            port: status.port,
+            remote: live_status_from_daemon(&status),
