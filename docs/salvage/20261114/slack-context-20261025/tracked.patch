+#[tokio::test]
+async fn e2e_a_bare_top_level_message_sees_the_bots_last_report() {
+    // 2026-10-25: the bot posted a login alert top-level, the owner answered "ignore" top-level,
+    // and the fresh auto-thread session had never seen the alert.
+    let pool = crate::storage::memory().await.unwrap();
+    let (base, calls) = serve_scripted(
+        "UBOT",
+        vec![
+            ("conversations.info", vec![json!({"ok": true, "channel": {}})]),
+            (
+                "conversations.history",
+                vec![json!({"ok": true, "messages": [
+                    {"ts": "300.2", "user": "UOWNER", "text": "ignore"},
+                    {"ts": "300.1", "user": "UBOT", "text": "Two new logins: X and Threads"},
+                    {"ts": "299.0", "user": "UOWNER", "text": "merge to main"}
+                ]})],
+            ),
+            (
+                "users.info",
+                vec![json!({"ok": true, "user": {"real_name": "Indo"}})],
+            ),
+        ],
+    )
+    .await;
+    let payload = json!({"team_id": "T1", "authorizations": [{"user_id": "UBOT"}], "event": {
+        "type": "message", "user": "UOWNER", "channel": "CHOME", "ts": "300.2", "text": "ignore"}});
+    let admitted = admit(&config("ws://x".into()), &payload, "UBOT", false).unwrap();
+    assert_eq!(admitted.key.thread_id.as_deref(), Some("300.2"));
+    let dir = std::env::temp_dir().join(format!("ferryx-bare-top-{}", std::process::id()));
+    let prompt = with_test_api(base, "xoxb-test".into(), async {
+        prepare_prompt_in(&pool, &admitted, &dir).await
+    })
+    .await;
+    assert_eq!(
+        prompt,
+        "[Thu 1970-01-01 00:05:00 UTC] [Recent channel context]\nIndo: merge to main\n\
+         you (bot): Two new logins: X and Threads\n\nignore"
+    );
+    assert_eq!(calls_of(&calls, "conversations.history")[0]["latest"], "300.2");
+
+    // A reply inside a thread quotes its root instead and reads no channel history.
+    let (base, calls) = serve_scripted("UBOT", Vec::new()).await;
+    let reply = json!({"team_id": "T1", "authorizations": [{"user_id": "UBOT"}], "event": {
+        "type": "message", "user": "UOWNER", "channel": "CHOME", "ts": "301.2", "thread_ts": "301.1", "text": "ok"}});
+    let reply = admit(&config("ws://x".into()), &reply, "UBOT", false).unwrap();
+    with_test_api(base, "xoxb-test".into(), async {
+        prepare_prompt_in(&pool, &reply, &dir).await
+    })
+    .await;
+    assert!(calls_of(&calls, "conversations.history").is_empty());
+    let _ = std::fs::remove_dir_all(&dir);
+}
