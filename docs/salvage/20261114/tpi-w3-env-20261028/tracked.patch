+                 if (-not [System.IO.File]::Exists($exe)) {{ [Console]::Error.WriteLine('FERRYX_ERR_HELPER_MISSING'); exit 127; }}; \
+                 & $exe start --root $root --host-id $hostId 2>&1 | ForEach-Object {{ \
