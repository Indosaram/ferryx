+async function runPs1Install({ existing, plant, stale, fresh, failRestore, lockedTarget, concurrent, temp, target }) {
+  const root = mkdtempSync(join(tmpdir(), "ferryx-install-ps1-test-"));
+  sandboxes.push(root);
