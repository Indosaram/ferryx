+    utimesSync(staleBackup, twoHoursAgo, twoHoursAgo);
+  }
+  if (fresh) {
+    // A concurrent run's live backup, written moments ago.
+    writeFileSync(join(installDir, ".ferryx-cli.exe.old.fedcba9876543210"), OLD_EXE);
+  }
