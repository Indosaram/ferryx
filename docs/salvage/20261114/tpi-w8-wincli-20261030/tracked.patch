+fn daemon_absence(error: &crate::ipc::IpcError) -> &'static str {
+    if error.code == crate::ipc::IpcErrorCode::HostUnavailable
+        && error.message == crate::daemon::EXISTING_ONLY_NO_DAEMON_MESSAGE
+    {
+        "notRunning"
+    } else {
+        "unreachable"
+    }
