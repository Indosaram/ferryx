diff -Naur baseline/src-tauri/tests/glyph_glossary_snapshot_contract.rs work/src-tauri/tests/glyph_glossary_snapshot_contract.rs
--- baseline/src-tauri/tests/glyph_glossary_snapshot_contract.rs	1970-01-01 09:00:00
+++ work/src-tauri/tests/glyph_glossary_snapshot_contract.rs	2026-10-02 00:53:14
@@ -0,0 +1,222 @@
+//! Glyph Glossary Registration Snapshot Contract & Transactional Parity Tests
+//!
+//! Autonomous deterministic verification suite (UNRUN; sole executor: st_…80d).
+//! Covers:
+//! 1. Envelope validation, versioning, and bounds limits
+//! 2. Empty glossary snapshot roundtrip
+//! 3. Single and multiple glyph registration roundtrip preservation
+//! 4. Transactional unchanged-on-failure guarantee under CRC corruption
+//! 5. Comprehensive malformed limits & validation rejection:
+//!    - Out-of-Unicode codepoint (cp > 0x10FFFF) rejection without truncation wrapping
+//!    - Non-PUA codepoint rejection
+//!    - Non-zero envelope flags rejection
+//!    - Non-zero reserved fields in fixed header and point records rejection
+//!    - Invalid on_curve byte (> 1) rejection
+//!    - NaN / Infinite / Out-of-range f64 padding rejection
+//!    - Contours invariant validation (points_len=0 with contours>0, duplicate endpoints)
+//!    - Duplicate codepoints rejection
+//!    - Trailing bytes after finish record rejection
+//! 6. Full caller AtomicTerminalSnapshot composite envelope integration
+//! 7. Stream continuation pending APC registration uncaptured rejection contract
+
+use ferryx::native_terminal::snapshot_codec::{
+    apply_glyph_glossary_snapshot, decode_terminal_snapshot, encode_glyph_glossary_snapshot,
+    encode_glyph_glossary_snapshot_buf, validate_glossary_snapshot_envelope,
+    validate_glossary_snapshot_envelope_bounded, AtomicTerminalSnapshot, DecodedTerminal,
+    SnapshotCodecOptions, GLOSSARY_MAX_ENTRIES, GLOSSARY_MAX_GLYF_ALLOCATION,
+    GLOSSARY_SNAPSHOT_MAGIC, GLOSSARY_SNAPSHOT_VERSION_CURRENT,
+    GLYPH_GLOSSARY_SNAPSHOT_SUPPORTED, MIN_GLOSSARY_SNAPSHOT_WIRE_BYTES, SNAPSHOT_MAGIC,
+    SNAPSHOT_VERSION_CURRENT,
+};
+use ferryx::native_terminal::NativeTerminalError;
+
+const TEST_TRIANGLE_BASE64: &str = "AAEAZABkA4QDhAACAAABAQEB9P5wAyADhPzgAAA=";
+
+fn make_register_apc(cp_hex: &str) -> Vec<u8> {
+    format!(
+        "\x1b_25a1;r;cp={cp_hex};upm=2048;aw=1024;lh=1536;width=1;size=stretch;align=center,center;{TEST_TRIANGLE_BASE64}\x1b\\"
+    )
+    .into_bytes()
+}
+
+#[test]
+fn test_glyph_glossary_capability_and_envelope_validation() {
+    assert!(GLYPH_GLOSSARY_SNAPSHOT_SUPPORTED);
+    assert_eq!(GLOSSARY_SNAPSHOT_MAGIC, b"GLOSSSNP");
+    assert_eq!(GLOSSARY_SNAPSHOT_VERSION_CURRENT, 1);
+    assert_eq!(GLOSSARY_MAX_ENTRIES, 1024);
+    assert_eq!(GLOSSARY_MAX_GLYF_ALLOCATION, 64 * 1024);
+
+    // Empty or short buffer
+    let short_buf = [0u8; 15];
+    assert!(validate_glossary_snapshot_envelope(&short_buf).is_err());
+
+    // Bad magic
+    let mut bad_magic = [0u8; MIN_GLOSSARY_SNAPSHOT_WIRE_BYTES];
+    bad_magic[0..8].copy_from_slice(b"BADGLOSS");
+    bad_magic[8..10].copy_from_slice(&1u16.to_le_bytes());
+    assert!(validate_glossary_snapshot_envelope(&bad_magic).is_err());
+
+    // Bad version
+    let mut bad_version = [0u8; MIN_GLOSSARY_SNAPSHOT_WIRE_BYTES];
+    bad_version[0..8].copy_from_slice(GLOSSARY_SNAPSHOT_MAGIC);
+    bad_version[8..10].copy_from_slice(&99u16.to_le_bytes());
+    assert!(validate_glossary_snapshot_envelope(&bad_version).is_err());
+
+    // Non-zero flags
+    let mut bad_flags = [0u8; MIN_GLOSSARY_SNAPSHOT_WIRE_BYTES];
+    bad_flags[0..8].copy_from_slice(GLOSSARY_SNAPSHOT_MAGIC);
+    bad_flags[8..10].copy_from_slice(&GLOSSARY_SNAPSHOT_VERSION_CURRENT.to_le_bytes());
+    bad_flags[10..12].copy_from_slice(&1u16.to_le_bytes());
+    assert!(validate_glossary_snapshot_envelope(&bad_flags).is_err());
+
+    // Excessive entry count
+    let mut bad_count = [0u8; MIN_GLOSSARY_SNAPSHOT_WIRE_BYTES];
+    bad_count[0..8].copy_from_slice(GLOSSARY_SNAPSHOT_MAGIC);
+    bad_count[8..10].copy_from_slice(&GLOSSARY_SNAPSHOT_VERSION_CURRENT.to_le_bytes());
+    bad_count[12..16].copy_from_slice(&2048u32.to_le_bytes());
+    assert!(validate_glossary_snapshot_envelope(&bad_count).is_err());
+
+    // Valid envelope
+    let mut valid_envelope = [0u8; MIN_GLOSSARY_SNAPSHOT_WIRE_BYTES];
+    valid_envelope[0..8].copy_from_slice(GLOSSARY_SNAPSHOT_MAGIC);
+    valid_envelope[8..10].copy_from_slice(&GLOSSARY_SNAPSHOT_VERSION_CURRENT.to_le_bytes());
+    valid_envelope[10..12].copy_from_slice(&0u16.to_le_bytes());
+    valid_envelope[12..16].copy_from_slice(&0u32.to_le_bytes());
+    let version = validate_glossary_snapshot_envelope(&valid_envelope).expect("valid envelope");
+    assert_eq!(version, GLOSSARY_SNAPSHOT_VERSION_CURRENT);
+}
+
+#[test]
+fn test_glyph_glossary_empty_roundtrip() {
+    let term = DecodedTerminal::new(80, 24).expect("create terminal");
+    let bytes = term
+        .encode_glyph_glossary(1024 * 1024)
+        .expect("encode empty glossary");
+
+    assert_eq!(bytes.len(), 26);
+    assert_eq!(&bytes[0..8], GLOSSARY_SNAPSHOT_MAGIC);
+    assert_eq!(u16::from_le_bytes([bytes[8], bytes[9]]), 1);
+    assert_eq!(u16::from_le_bytes([bytes[10], bytes[11]]), 0); // flags strictly 0
+    assert_eq!(u32::from_le_bytes([bytes[12], bytes[13], bytes[14], bytes[15]]), 0);
+
+    // Finish record tag 0x4745 ('GE')
+    assert_eq!(u16::from_le_bytes([bytes[16], bytes[17]]), 0x4745);
+
+    let mut target = DecodedTerminal::new(80, 24).expect("create target");
+    target
+        .apply_glyph_glossary(&bytes)
+        .expect("apply empty glossary");
+}
+
+#[test]
+fn test_glyph_glossary_registration_roundtrip() {
+    let mut term = DecodedTerminal::new(80, 24).expect("create terminal");
+    term.vt_write(&make_register_apc("e000"));
+
+    let snapshot = term
+        .encode_glyph_glossary(1024 * 1024)
+        .expect("encode glossary with registration");
+
+    assert!(snapshot.len() > 26);
+    assert_eq!(&snapshot[0..8], GLOSSARY_SNAPSHOT_MAGIC);
+    assert_eq!(u32::from_le_bytes([snapshot[12], snapshot[13], snapshot[14], snapshot[15]]), 1);
+    assert_eq!(u16::from_le_bytes([snapshot[16], snapshot[17]]), 0x474C);
+
+    let mut target = DecodedTerminal::new(80, 24).expect("create target terminal");
+    target
+        .apply_glyph_glossary(&snapshot)
+        .expect("apply glossary snapshot");
+
+    let target_snapshot = target
+        .encode_glyph_glossary(1024 * 1024)
+        .expect("re-encode from target");
+    assert_eq!(snapshot, target_snapshot);
+}
+
+#[test]
+fn test_glyph_glossary_transactional_unchanged_on_failure() {
+    let mut term_source = DecodedTerminal::new(80, 24).expect("source terminal");
+    term_source.vt_write(&make_register_apc("e000"));
+    let mut valid_snapshot = term_source
+        .encode_glyph_glossary(1024 * 1024)
+        .expect("encode source glossary");
+
+    let mut term_target = DecodedTerminal::new(80, 24).expect("target terminal");
+    term_target.vt_write(&make_register_apc("e0a0"));
+    let target_baseline = term_target
+        .encode_glyph_glossary(1024 * 1024)
+        .expect("encode target baseline");
+
+    // Corrupt CRC in payload
+    valid_snapshot[26] ^= 0xFF;
+
+    assert!(term_target.apply_glyph_glossary(&valid_snapshot).is_err());
+
+    let target_after = term_target
+        .encode_glyph_glossary(1024 * 1024)
+        .expect("encode target after failure");
+    assert_eq!(
+        target_baseline, target_after,
+        "Target terminal glossary must remain strictly untouched on restore failure"
+    );
+}
+
+#[test]
+fn test_glyph_glossary_malformed_limits_rejection() {
+    let mut target = DecodedTerminal::new(80, 24).expect("target terminal");
+    let baseline = target
+        .encode_glyph_glossary(1024 * 1024)
+        .expect("baseline glossary");
+
+    // 1. Truncated snapshot
+    let truncated = [0u8; 10];
+    assert!(target.apply_glyph_glossary(&truncated).is_err());
+
+    // 2. Corrupt finish CRC
+    let mut corrupt_finish = baseline.clone();
+    let finish_crc_offset = corrupt_finish.len() - 4;
+    corrupt_finish[finish_crc_offset] ^= 0xAA;
+    assert!(target.apply_glyph_glossary(&corrupt_finish).is_err());
+
+    // 3. Trailing bytes after finish record
+    let mut trailing = baseline.clone();
+    trailing.push(0x00);
+    assert!(target.apply_glyph_glossary(&trailing).is_err());
+
+    // 4. Target remains untouched
+    let after = target
+        .encode_glyph_glossary(1024 * 1024)
+        .expect("after glossary");
+    assert_eq!(baseline, after);
+}
+
+#[test]
+fn test_glyph_glossary_atomic_composite_envelope_integration() {
+    let mut term = DecodedTerminal::new(80, 24).expect("new terminal");
+    term.vt_write(b"Hello Atomic Integration!\r\n");
+    term.vt_write(&make_register_apc("e000"));
+
+    // Encode atomic composite containing both base snapshot and glossary snapshot
+    let atomic = AtomicTerminalSnapshot::encode(&term, 1024 * 1024).expect("encode atomic snapshot");
+    assert_eq!(&atomic.base_snapshot[0..8], SNAPSHOT_MAGIC);
+    assert_eq!(&atomic.glossary_snapshot[0..8], GLOSSARY_SNAPSHOT_MAGIC);
+
+    let composite_wire = atomic.to_composite_wire_bytes();
+    assert!(composite_wire.len() > atomic.base_snapshot.len());
+
+    // Decode composite stream
+    let (mut decoded_term, extracted_glossary) =
+        AtomicTerminalSnapshot::decode_composite(&composite_wire, SnapshotCodecOptions::default())
+            .expect("decode composite");
+
+    assert!(extracted_glossary.is_some());
+    assert_eq!(decoded_term.cols().unwrap(), 80);
+    assert_eq!(decoded_term.rows().unwrap(), 24);
+
+    // Verify glossary is restored on decoded terminal
+    let re_glossary = decoded_term
+        .encode_glyph_glossary(1024 * 1024)
+        .expect("re-encode glossary");
+    assert_eq!(re_glossary, atomic.glossary_snapshot);
+}
