+pub fn validate_glossary_snapshot_envelope(bytes: &[u8]) -> Result<u16, NativeTerminalError> {
+    validate_glossary_snapshot_envelope_bounded(bytes, DEFAULT_MAX_SNAPSHOT_WIRE_BYTES)
+}
+
+pub fn validate_glossary_snapshot_envelope_bounded(
+    bytes: &[u8],
+    max_bytes: usize,
+) -> Result<u16, NativeTerminalError> {
+    if bytes.len() < MIN_GLOSSARY_SNAPSHOT_WIRE_BYTES {
+        return Err(NativeTerminalError::InvalidValue(format!(
+            "Glossary snapshot length {} bytes is smaller than minimum {} bytes",
+            bytes.len(),
+            MIN_GLOSSARY_SNAPSHOT_WIRE_BYTES
+        )));
+    }
+    if bytes.len() > max_bytes {
+        return Err(NativeTerminalError::LimitExceeded);
+    }
+    if &bytes[0..8] != GLOSSARY_SNAPSHOT_MAGIC {
+        return Err(NativeTerminalError::InvalidValue(
+            "Invalid glossary snapshot magic header: expected 'GLOSSSNP'".to_string(),
+        ));
+    }
+    let version = u16::from_le_bytes([bytes[8], bytes[9]]);
+    if version != GLOSSARY_SNAPSHOT_VERSION_CURRENT {
+        return Err(NativeTerminalError::InvalidValue(format!(
+            "Unsupported glossary snapshot version {version}: expected version {GLOSSARY_SNAPSHOT_VERSION_CURRENT}"
+        )));
+    }
+    let flags = u16::from_le_bytes([bytes[10], bytes[11]]);
+    if flags != 0 {
+        return Err(NativeTerminalError::InvalidValue(format!(
+            "Unsupported glossary snapshot flags {flags}: expected 0"
+        )));
+    }
+    let entry_count = u32::from_le_bytes([bytes[12], bytes[13], bytes[14], bytes[15]]);
+    if (entry_count as usize) > GLOSSARY_MAX_ENTRIES {
+        return Err(NativeTerminalError::LimitExceeded);
+    }
+    Ok(version)
+}
