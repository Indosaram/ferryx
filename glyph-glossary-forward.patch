+        ));
+    }
+    let mut out = Vec::new();
+    let mut ctx = BoundedWriterContext {
+        buffer: &mut out,
+        max_bytes: max_wire_bytes,
+        overflow: false,
+    };
+    let writer = GhosttyWriter {
+        write: bounded_writer_callback,
+        userdata: (&mut ctx as *mut BoundedWriterContext).cast(),
+    };
+    let res = ghostty_glossary_snapshot_encode(terminal, writer);
+    if ctx.overflow {
+        return Err(NativeTerminalError::LimitExceeded);
+    }
+    NativeTerminalError::from_c_result(res, "ghostty_glossary_snapshot_encode")?;
+    validate_glossary_snapshot_envelope_bounded(&out, max_wire_bytes)?;
+    Ok(out)
+}
