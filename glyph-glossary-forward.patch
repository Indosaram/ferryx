+/// Encode complete glyph glossary snapshot to a synchronous C writer callback.
+pub fn glossary_snapshot_encode(
+    terminal: terminal_c.Terminal,
+    writer: io_c.Writer,
+) callconv(lib.calling_conv) Result {
+    const native = terminal_c.zigTerminal(terminal) orelse return .invalid_value;
+    if (writer.write == null) return .invalid_value;
+
+    const continuation = continuationOwned(terminal);
+    if (continuation.result != .success) return continuation.result;
+    defer native.gpa().free(continuation.bytes);
+
+    var buffer: [io_c.WriterAdapter.recommended_buffer_len]u8 = undefined;
+    var adapter: io_c.WriterAdapter = .initBuffered(writer, &buffer);
+    snapshot_core.glossary.encode(
+        native,
+        &adapter.interface,
+        .{
+            .stream_continuation = continuation.bytes,
+            .allow_pending = false,
+        },
+    ) catch |err| switch (err) {
+        error.PendingRegistrationUncaptured => return .invalid_value,
+        error.LimitExceeded => return .limit_exceeded,
+        error.OutOfMemory => return .out_of_memory,
+        else => return .io_error,
+    };
+    adapter.interface.flush() catch return .io_error;
+    return .success;
+}
+
+/// Encode complete glyph glossary snapshot to a caller-provided buffer.
+pub fn glossary_snapshot_encode_buf(
+    terminal: terminal_c.Terminal,
+    buf: ?[*]u8,
+    buf_len: usize,
+    out_written_: ?*usize,
+) callconv(lib.calling_conv) Result {
+    const out_written = out_written_ orelse return .invalid_value;
+    out_written.* = 0;
+    if (buf == null and buf_len != 0) return .invalid_value;
+    const native = terminal_c.zigTerminal(terminal) orelse return .invalid_value;
+
+    const continuation = continuationOwned(terminal);
+    if (continuation.result != .success) return continuation.result;
+    defer native.gpa().free(continuation.bytes);
+
+    const destination: []u8 = if (buf) |ptr| ptr[0..buf_len] else &.{};
+    var writer: std.Io.Writer = .fixed(destination);
+    snapshot_core.glossary.encode(
+        native,
+        &writer,
+        .{
+            .stream_continuation = continuation.bytes,
+            .allow_pending = false,
+        },
+    ) catch |err| switch (err) {
+        error.WriteFailed => {
+            var counter: std.Io.Writer.Discarding = .init(&.{});
+            snapshot_core.glossary.encode(
+                native,
+                &counter.writer,
+                .{
+                    .stream_continuation = continuation.bytes,
+                    .allow_pending = false,
+                },
+            ) catch |count_err| switch (count_err) {
+                error.PendingRegistrationUncaptured => return .invalid_value,
+                error.LimitExceeded => return .limit_exceeded,
+                error.OutOfMemory => return .out_of_memory,
+                else => return .io_error,
+            };
+            out_written.* = std.math.cast(usize, counter.count) orelse
+                return .limit_exceeded;
+            return .out_of_space;
+        },
+        error.PendingRegistrationUncaptured => return .invalid_value,
+        error.LimitExceeded => return .limit_exceeded,
+        error.OutOfMemory => return .out_of_memory,
+        else => return .io_error,
+    };
+    out_written.* = writer.end;
+    return .success;
+}
+
+/// Transactionally restore glyph glossary registrations from snapshot bytes.
+pub fn glossary_snapshot_apply(
+    terminal: terminal_c.Terminal,
+    ptr: ?[*]const u8,
+    len: usize,
+) callconv(lib.calling_conv) Result {
+    const native = terminal_c.zigTerminal(terminal) orelse return .invalid_value;
+    if (len == 0 or ptr == null) return .invalid_value;
+    const bytes = ptr.?[0..len];
+
+    snapshot_core.glossary.apply(native, bytes) catch |err| switch (err) {
+        error.OutOfMemory => return .out_of_memory,
+        error.LimitExceeded => return .limit_exceeded,
+        error.BufferTooShort,
+        error.InvalidMagic,
+        error.UnsupportedVersion,
+        error.CorruptCrc,
+        error.InvalidTag,
+        error.MalformedPayload,
+        error.InvalidCodepoint,
+        error.DuplicateCodepoint,
+        error.InvalidWidth,
+        error.InvalidMetrics,
+        error.InvalidConstraint,
+        error.InvalidContours,
+        error.InvalidPoints,
+        => return .invalid_value,
+        else => return .invalid_value,
+    };
+    return .success;
+}
