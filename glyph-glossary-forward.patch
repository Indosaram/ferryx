+//! Glyph Glossary Snapshot Encoding and Transactional Restoration.
+//!
+//! Provides versioned export and transactional import of the per-session
+//! Glyph Protocol glossary (`Terminal.glyph_glossary`).
+//!
+//! ## Wire Format
+//!
+//! All multi-byte integers and IEEE-754 floats are strictly little-endian.
+//!
+//! 1. Envelope (16 bytes fixed):
+//!    - Magic (8 bytes): "GLOSSSNP"
+//!    - Version (u16): 1
+//!    - Flags (u16): 0 (must be strictly 0; non-zero rejected)
+//!    - Entry count (u32): number of registered entries (<= 1024)
+//!
+//! 2. Entry Records (repeated `entry_count` times):
+//!    - Tag (u16): 0x474C ('GL')
+//!    - Payload length (u32): 64 + contours_len * 2 + points_len * 12
+//!    - CRC32C (u32): covers Tag, Payload length, and Payload bytes
+//!    - Payload (explicit little-endian field serialization):
+//!        - cp (u32): Private Use Area codepoint (<= 0x10FFFF, PUA verified)
+//!        - width (u8): 1 (narrow) or 2 (wide)
+//!        - reserved0 (u8): 0 (must be strictly 0)
+//!        - reserved1 (u16): 0 (must be strictly 0)
+//!        - units_per_em (u32): > 0
+//!        - advance_width (u32): > 0
+//!        - line_height (u32): > 0
+//!        - constraint_size (u8): 0=none, 1=cover, 2=stretch
+//!        - constraint_align_h (u8): 0=none, 1=start, 2=center, 3=end
+//!        - constraint_align_v (u8): 0=none, 1=start, 2=center, 3=end
+//!        - reserved2 (u8): 0 (must be strictly 0)
+//!        - pad_top (f64): finite, non-NaN, in [0.0, 1.0]
+//!        - pad_right (f64): finite, non-NaN, in [0.0, 1.0]
+//!        - pad_bottom (f64): finite, non-NaN, in [0.0, 1.0]
+//!        - pad_left (f64): finite, non-NaN, in [0.0, 1.0]
+//!        - contours_len (u32): number of contour endpoints (<= 512)
+//!        - points_len (u32): number of points (<= 4096)
+//!        - contours (contours_len * u16): strictly increasing, last == points_len - 1
+//!        - points (points_len * PointWire): x (i32), y (i32), on_curve (0 or 1), reserved (0,0,0)
+//!
+//! 3. Finish Record:
+//!    - Tag (u16): 0x4745 ('GE')
+//!    - Payload length (u32): 0
+//!    - CRC32C (u32): 0x9bcc1fe5 (CRC32C over Tag + length)
+//!    - Trailing bytes: strictly forbidden; trailing bytes trigger MalformedPayload.
+//!
+//! ## Transactional Restoration Guarantee
+//!
+//! Restoration decodes all records into a temporary staging Glossary.
+//! Any failure (CRC mismatch, bounds breach, non-PUA codepoint, truncation, or OOM)
+//! deinitializes and discards the staging glossary via `errdefer`. The target
+//! terminal's glossary is only mutated via atomic swap once validation completes.
+
+const std = @import("std");
+const assert = std.debug.assert;
+const Allocator = std.mem.Allocator;
+const Crc32c = @import("../../crc32c.zig").Crc32c;
+const Terminal = @import("../Terminal.zig");
+const Glossary = @import("../apc/glyph/Glossary.zig");
+const FontGlyph = @import("../../../font/Glyph.zig");
+const Glyf = @import("../../../font/opentype/glyf.zig").Glyf;
+const request = @import("../apc/glyph/request.zig");
+const sfnt = @import("../../../font/opentype/sfnt.zig");
+
+pub const MAGIC: *const [8]u8 = "GLOSSSNP";
+pub const VERSION_1: u16 = 1;
+pub const ENVELOPE_LEN: usize = 16;
+pub const RECORD_HEADER_LEN: usize = 10;
+pub const ENTRY_FIXED_PAYLOAD_LEN: usize = 64;
+pub const FINISH_RECORD_LEN: usize = 10;
+pub const MIN_SNAPSHOT_WIRE_BYTES: usize = ENVELOPE_LEN + FINISH_RECORD_LEN; // 26 bytes
+
+pub const TAG_ENTRY: u16 = 0x474C; // 'GL'
+pub const TAG_FINISH: u16 = 0x4745; // 'GE'
+
+pub const MAX_CONTOURS: u32 = 512;
+pub const MAX_POINTS: u32 = 4096;
+
+pub const EncodeOptions = struct {
+    /// In-flight stream continuation bytes from terminal.
+    stream_continuation: ?[]const u8 = null,
+    /// If false, encode will reject if uncommitted glyph APC sequences are detected.
+    allow_pending: bool = false,
+};
+
+pub const EncodeError = Allocator.Error || error{
+    WriteFailed,
+    PayloadTooLarge,
+    LimitExceeded,
+    PendingRegistrationUncaptured,
+};
+
+pub const ApplyError = Allocator.Error || error{
+    BufferTooShort,
+    InvalidMagic,
+    UnsupportedVersion,
+    CorruptCrc,
+    InvalidTag,
+    MalformedPayload,
+    LimitExceeded,
+    InvalidCodepoint,
+    DuplicateCodepoint,
+    InvalidWidth,
+    InvalidMetrics,
+    InvalidConstraint,
+    InvalidContours,
+    InvalidPoints,
+};
+
+fn writeF64Le(dest: []u8, val: f64) void {
+    const bits: u64 = @bitCast(val);
+    std.mem.writeInt(u64, dest[0..8], bits, .little);
+}
+
+fn readF64Le(src: []const u8) f64 {
+    const bits = std.mem.readInt(u64, src[0..8], .little);
+    return @bitCast(bits);
+}
+
+fn validatePadding(val: f64) bool {
+    if (!std.math.isFinite(val)) return false;
+    if (std.math.isNan(val)) return false;
+    return val >= 0.0 and val <= 1.0;
+}
+
+/// Detects whether uncommitted APC glyph sequences are present in continuation.
+fn hasUncommittedGlyphRegistration(continuation: []const u8) bool {
+    if (continuation.len < 6) return false;
+    return std.mem.indexOf(u8, continuation, "25a1;r") != null or
+        std.mem.indexOf(u8, continuation, "25a1;c") != null;
+}
+
+/// Encode the terminal's glyph glossary into a standard `std.Io.Writer`.
+pub fn encode(
+    t: *const Terminal,
+    writer: *std.Io.Writer,
+    options: EncodeOptions,
+) EncodeError!void {
+    // 0. Preflight uncaptured in-flight registration in stream continuation
+    if (options.stream_continuation) |cont| {
+        if (!options.allow_pending and hasUncommittedGlyphRegistration(cont)) {
+            return error.PendingRegistrationUncaptured;
+        }
+    }
+
+    const glossary = &t.glyph_glossary;
+    const count = glossary.entries.count();
+    if (count > Glossary.max_entries) return error.LimitExceeded;
+
+    // 1. Write Envelope
+    try writer.writeAll(MAGIC);
+    try writer.writeInt(u16, VERSION_1, .little);
+    try writer.writeInt(u16, 0, .little); // flags (strictly 0)
+    try writer.writeInt(u32, @intCast(count), .little);
+
+    const alloc = @constCast(t).gpa();
+
+    // 2. Write Entries
+    for (glossary.entries.keys(), glossary.entries.values()) |cp, entry| {
+        switch (entry.glyph) {
+            .glyf => |outline| {
+                const contours_len = std.math.cast(u32, outline.contours.len) orelse
+                    return error.PayloadTooLarge;
+                const points_len = std.math.cast(u32, outline.points.len) orelse
+                    return error.PayloadTooLarge;
+
+                if (contours_len > MAX_CONTOURS or points_len > MAX_POINTS) {
+                    return error.LimitExceeded;
+                }
+
+                const payload_len = ENTRY_FIXED_PAYLOAD_LEN +
+                    (@as(usize, contours_len) * 2) +
+                    (@as(usize, points_len) * 12);
+
+                const u32_payload_len = std.math.cast(u32, payload_len) orelse
+                    return error.PayloadTooLarge;
+
+                const payload = try alloc.alloc(u8, payload_len);
+                defer alloc.free(payload);
+
+                const c_size: u8 = switch (entry.constraint.size) {
+                    .none => 0,
+                    .cover => 1,
+                    .stretch => 2,
+                    else => 0,
+                };
+                const c_align_h: u8 = switch (entry.constraint.align_horizontal) {
+                    .none => 0,
+                    .start => 1,
+                    .center, .center1 => 2,
+                    .end => 3,
+                };
+                const c_align_v: u8 = switch (entry.constraint.align_vertical) {
+                    .none => 0,
+                    .start, .baseline => 1,
+                    .center, .center1 => 2,
+                    .end => 3,
+                };
+
+                // Explicit portable little-endian encoding
+                std.mem.writeInt(u32, payload[0..4], @intCast(cp), .little);
+                payload[4] = switch (entry.width) {
+                    .narrow => 1,
+                    .wide => 2,
+                };
+                payload[5] = 0; // reserved0
+                std.mem.writeInt(u16, payload[6..8], 0, .little); // reserved1
+                std.mem.writeInt(u32, payload[8..12], entry.design.units_per_em, .little);
+                std.mem.writeInt(u32, payload[12..16], entry.design.advance_width, .little);
+                std.mem.writeInt(u32, payload[16..20], entry.design.line_height, .little);
+                payload[20] = c_size;
+                payload[21] = c_align_h;
+                payload[22] = c_align_v;
+                payload[23] = 0; // reserved2
+                writeF64Le(payload[24..32], entry.constraint.pad_top);
+                writeF64Le(payload[32..40], entry.constraint.pad_right);
+                writeF64Le(payload[40..48], entry.constraint.pad_bottom);
+                writeF64Le(payload[48..56], entry.constraint.pad_left);
+                std.mem.writeInt(u32, payload[56..60], contours_len, .little);
+                std.mem.writeInt(u32, payload[60..64], points_len, .little);
+
+                var offset: usize = ENTRY_FIXED_PAYLOAD_LEN;
+                for (outline.contours) |cntr| {
+                    std.mem.writeInt(u16, payload[offset..][0..2], cntr, .little);
+                    offset += 2;
+                }
+
+                for (outline.points) |pt| {
+                    std.mem.writeInt(i32, payload[offset..][0..4], pt.x, .little);
+                    std.mem.writeInt(i32, payload[offset + 4..][0..4], pt.y, .little);
+                    payload[offset + 8] = if (pt.on_curve) 1 else 0;
+                    payload[offset + 9] = 0;
+                    payload[offset + 10] = 0;
+                    payload[offset + 11] = 0;
+                    offset += 12;
+                }
+                assert(offset == payload_len);
+
+                // Compute CRC32C over (Tag, payload_len, payload)
+                var crc = Crc32c.init();
+                var tag_bytes: [2]u8 = undefined;
+                std.mem.writeInt(u16, &tag_bytes, TAG_ENTRY, .little);
+                crc.update(&tag_bytes);
+
+                var len_bytes: [4]u8 = undefined;
+                std.mem.writeInt(u32, &len_bytes, u32_payload_len, .little);
+                crc.update(&len_bytes);
+
+                crc.update(payload);
+                const crc_val = crc.final();
+
+                // Emit record header
+                try writer.writeAll(&tag_bytes);
+                try writer.writeAll(&len_bytes);
+                try writer.writeInt(u32, crc_val, .little);
+
+                // Emit payload
+                try writer.writeAll(payload);
+            },
+        }
+    }
+
+    // 3. Write Finish Record (Tag: TAG_FINISH, payload_len: 0)
+    var finish_tag_bytes: [2]u8 = undefined;
+    std.mem.writeInt(u16, &finish_tag_bytes, TAG_FINISH, .little);
+    var finish_len_bytes: [4]u8 = undefined;
+    std.mem.writeInt(u32, &finish_len_bytes, 0, .little);
+
+    var finish_crc_calc = Crc32c.init();
+    finish_crc_calc.update(&finish_tag_bytes);
+    finish_crc_calc.update(&finish_len_bytes);
+    const finish_crc = finish_crc_calc.final();
+
+    try writer.writeAll(&finish_tag_bytes);
+    try writer.writeAll(&finish_len_bytes);
+    try writer.writeInt(u32, finish_crc, .little);
+}
+
+/// Transactionally apply glyph glossary registrations from snapshot bytes.
+///
+/// If any error occurs during parsing or staging, the staging glossary is
+/// deinitialized and destroyed, leaving `target.glyph_glossary` unchanged.
+pub fn apply(
+    target: *Terminal,
+    bytes: []const u8,
+) ApplyError!void {
+    if (bytes.len < MIN_SNAPSHOT_WIRE_BYTES) {
+        return error.BufferTooShort;
+    }
+
+    // 1. Validate Envelope
+    if (!std.mem.eql(u8, bytes[0..8], MAGIC)) {
+        return error.InvalidMagic;
+    }
+
+    const version = std.mem.readInt(u16, bytes[8..10], .little);
+    if (version != VERSION_1) {
+        return error.UnsupportedVersion;
+    }
+
+    const flags = std.mem.readInt(u16, bytes[10..12], .little);
+    if (flags != 0) {
+        return error.UnsupportedVersion;
+    }
+
+    const entry_count = std.mem.readInt(u32, bytes[12..16], .little);
+    if (entry_count > Glossary.max_entries) {
+        return error.LimitExceeded;
+    }
+
+    const alloc = target.gpa();
+
+    // 2. Stage entries in temporary Glossary
+    var staging: Glossary = .empty;
+    errdefer staging.deinit(alloc);
+
+    var offset: usize = ENVELOPE_LEN;
+
+    for (0..entry_count) |_| {
+        if (offset + RECORD_HEADER_LEN > bytes.len) {
+            return error.BufferTooShort;
+        }
+
+        const tag = std.mem.readInt(u16, bytes[offset..][0..2], .little);
+        if (tag != TAG_ENTRY) {
+            return error.InvalidTag;
+        }
+
+        const payload_len = std.mem.readInt(u32, bytes[offset + 2..][0..4], .little);
+        const stored_crc = std.mem.readInt(u32, bytes[offset + 6..][0..4], .little);
+
+        if (offset + RECORD_HEADER_LEN + payload_len > bytes.len) {
+            return error.BufferTooShort;
+        }
+
+        const payload = bytes[offset + RECORD_HEADER_LEN .. offset + RECORD_HEADER_LEN + payload_len];
+
+        // Check CRC32C
+        var crc = Crc32c.init();
+        crc.update(bytes[offset .. offset + 6]);
+        crc.update(payload);
+        if (crc.final() != stored_crc) {
+            return error.CorruptCrc;
+        }
+
+        if (payload_len < ENTRY_FIXED_PAYLOAD_LEN) {
+            return error.MalformedPayload;
+        }
+
+        // Validate codepoint without premature truncation wrapping
+        const cp_u32 = std.mem.readInt(u32, payload[0..4], .little);
+        if (cp_u32 > 0x10FFFF) {
+            return error.InvalidCodepoint;
+        }
+        const cp: u21 = @intCast(cp_u32);
+        if (!Glossary.isPrivateUse(cp)) {
+            return error.InvalidCodepoint;
+        }
+        if (staging.entries.contains(cp)) {
+            return error.DuplicateCodepoint;
+        }
+
+        const width_raw = payload[4];
+        const width: request.Width = switch (width_raw) {
+            1 => .narrow,
+            2 => .wide,
+            else => return error.InvalidWidth,
+        };
+
+        // Strict validation of reserved padding fields
+        const reserved0 = payload[5];
+        const reserved1 = std.mem.readInt(u16, payload[6..8], .little);
+        const reserved2 = payload[23];
+        if (reserved0 != 0 or reserved1 != 0 or reserved2 != 0) {
+            return error.MalformedPayload;
+        }
+
+        const units_per_em = std.mem.readInt(u32, payload[8..12], .little);
+        const advance_width = std.mem.readInt(u32, payload[12..16], .little);
+        const line_height = std.mem.readInt(u32, payload[16..20], .little);
+        if (units_per_em == 0 or advance_width == 0 or line_height == 0) {
+            return error.InvalidMetrics;
+        }
+
+        const constraint_size: FontGlyph.RenderOptions.Constraint.Size = switch (payload[20]) {
+            0 => .none,
+            1 => .cover,
+            2 => .stretch,
+            else => return error.InvalidConstraint,
+        };
+
+        const constraint_align_h: FontGlyph.RenderOptions.Constraint.Align = switch (payload[21]) {
+            0 => .none,
+            1 => .start,
+            2 => .center,
+            3 => .end,
+            else => return error.InvalidConstraint,
+        };
+
+        const constraint_align_v: FontGlyph.RenderOptions.Constraint.Align = switch (payload[22]) {
+            0 => .none,
+            1 => .start,
+            2 => .center,
+            3 => .end,
+            else => return error.InvalidConstraint,
+        };
+
+        const pad_top = readF64Le(payload[24..32]);
+        const pad_right = readF64Le(payload[32..40]);
+        const pad_bottom = readF64Le(payload[40..48]);
+        const pad_left = readF64Le(payload[48..56]);
+        if (!validatePadding(pad_top) or
+            !validatePadding(pad_right) or
+            !validatePadding(pad_bottom) or
+            !validatePadding(pad_left))
+        {
+            return error.InvalidConstraint;
+        }
+
+        const contours_len = std.mem.readInt(u32, payload[56..60], .little);
+        const points_len = std.mem.readInt(u32, payload[60..64], .little);
+
+        if (contours_len > MAX_CONTOURS or points_len > MAX_POINTS) {
+            return error.LimitExceeded;
+        }
+
+        const required_payload = ENTRY_FIXED_PAYLOAD_LEN +
+            (@as(usize, contours_len) * 2) +
+            (@as(usize, points_len) * 12);
+
+        if (payload_len != required_payload) {
+            return error.MalformedPayload;
+        }
+
+        // Bounded allocation check (64 KiB ceiling)
+        const total_alloc_bytes = (@as(usize, contours_len) * @sizeOf(sfnt.uint16)) +
+            (@as(usize, points_len) * @sizeOf(Glyf.Outline.Point));
+        if (total_alloc_bytes > Glossary.max_glyf_allocation) {
+            return error.LimitExceeded;
+        }
+
+        // Allocate contours and points with safe ownership
+        const contours_slice = try alloc.alloc(sfnt.uint16, contours_len);
+        errdefer alloc.free(contours_slice);
+
+        const points_slice = try alloc.alloc(Glyf.Outline.Point, points_len);
+        errdefer alloc.free(points_slice);
+
+        var p_offset: usize = ENTRY_FIXED_PAYLOAD_LEN;
+        for (0..contours_len) |ci| {
+            contours_slice[ci] = std.mem.readInt(u16, payload[p_offset..][0..2], .little);
+            p_offset += 2;
+        }
+
+        // Validate contour end points invariant:
+        // non-empty contours require points; endpoints must be strictly increasing and last == points_len - 1
+        if (contours_len == 0) {
+            if (points_len != 0) return error.InvalidContours;
+        } else {
+            if (points_len == 0) return error.InvalidContours;
+            var prev: ?u16 = null;
+            for (contours_slice) |end_pt| {
+                if (end_pt >= points_len) {
+                    return error.InvalidContours;
+                }
+                if (prev) |p| {
+                    if (end_pt <= p) {
+                        return error.InvalidContours;
+                    }
+                }
+                prev = end_pt;
+            }
+            if (contours_slice[contours_len - 1] != points_len - 1) {
+                return error.InvalidContours;
+            }
+        }
+
+        for (0..points_len) |pi| {
+            const pt_x = std.mem.readInt(i32, payload[p_offset..][0..4], .little);
+            const pt_y = std.mem.readInt(i32, payload[p_offset + 4..][0..4], .little);
+            const on_curve_byte = payload[p_offset + 8];
+            if (on_curve_byte != 0 and on_curve_byte != 1) {
+                return error.MalformedPayload;
+            }
+            if (payload[p_offset + 9] != 0 or
+                payload[p_offset + 10] != 0 or
+                payload[p_offset + 11] != 0)
+            {
+                return error.MalformedPayload;
+            }
+            p_offset += 12;
+
+            points_slice[pi] = .{
+                .x = pt_x,
+                .y = pt_y,
+                .on_curve = (on_curve_byte == 1),
+            };
+        }
+
+        // Infallible insertion into staging: allocate hash map node first
+        try staging.entries.ensureUnusedCapacity(alloc, 1);
+
+        const entry: Glossary.Entry = .{
+            .glyph = .{
+                .glyf = .{
+                    .contours = contours_slice,
+                    .points = points_slice,
+                },
+            },
+            .design = .{
+                .units_per_em = units_per_em,
+                .advance_width = advance_width,
+                .line_height = line_height,
+            },
+            .width = width,
+            .constraint = .{
+                .size = constraint_size,
+                .align_horizontal = constraint_align_h,
+                .align_vertical = constraint_align_v,
+                .pad_top = pad_top,
+                .pad_right = pad_right,
+                .pad_bottom = pad_bottom,
+                .pad_left = pad_left,
+            },
+        };
+
+        // Ownership transferred into staging
+        staging.entries.putAssumeCapacity(cp, entry);
+
+        offset += RECORD_HEADER_LEN + payload_len;
+    }
+
+    // 3. Validate Finish Record
+    if (offset + RECORD_HEADER_LEN > bytes.len) {
+        return error.BufferTooShort;
+    }
+
+    const finish_tag = std.mem.readInt(u16, bytes[offset..][0..2], .little);
+    if (finish_tag != TAG_FINISH) {
+        return error.InvalidTag;
+    }
+
+    const finish_payload_len = std.mem.readInt(u32, bytes[offset + 2..][0..4], .little);
+    if (finish_payload_len != 0) {
+        return error.MalformedPayload;
+    }
+
+    const finish_stored_crc = std.mem.readInt(u32, bytes[offset + 6..][0..4], .little);
+    var finish_crc_calc = Crc32c.init();
+    finish_crc_calc.update(bytes[offset .. offset + 6]);
+    if (finish_crc_calc.final() != finish_stored_crc) {
+        return error.CorruptCrc;
+    }
+
+    // 4. Strict EOF: trailing bytes after finish are forbidden
+    if (offset + RECORD_HEADER_LEN != bytes.len) {
+        return error.MalformedPayload;
+    }
+
+    // 5. ATOMIC COMMIT (Swap staging into target terminal)
+    target.glyph_glossary.deinit(alloc);
+    target.glyph_glossary = staging;
+    target.flags.dirty.glyph_glossary = true;
+}
