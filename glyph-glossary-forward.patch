+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct AtomicTerminalSnapshot {
+    pub base_snapshot: Vec<u8>,
+    pub glossary_snapshot: Vec<u8>,
+}
+
+impl AtomicTerminalSnapshot {
+    pub fn encode(
+        terminal: &DecodedTerminal,
+        max_wire_bytes: usize,
+    ) -> Result<Self, NativeTerminalError> {
+        let base = terminal.encode(max_wire_bytes)?;
+        let glossary = terminal.encode_glyph_glossary(max_wire_bytes)?;
+        Ok(Self {
+            base_snapshot: base,
+            glossary_snapshot: glossary,
+        })
+    }
+
+    pub fn apply_to(&self, terminal: &mut DecodedTerminal) -> Result<(), NativeTerminalError> {
+        terminal.apply_glyph_glossary(&self.glossary_snapshot)
+    }
+
+    pub fn to_composite_wire_bytes(&self) -> Vec<u8> {
+        let mut out = Vec::with_capacity(self.base_snapshot.len() + self.glossary_snapshot.len());
+        out.extend_from_slice(&self.base_snapshot);
+        out.extend_from_slice(&self.glossary_snapshot);
+        out
+    }
+
+    pub fn decode_composite(
+        bytes: &[u8],
+        opts: SnapshotCodecOptions,
+    ) -> Result<(DecodedTerminal, Option<Vec<u8>>), NativeTerminalError> {
+        let mut terminal = decode_terminal_snapshot(bytes, opts)?;
+        if let Some(pos) = bytes.windows(8).position(|w| w == GLOSSARY_SNAPSHOT_MAGIC) {
+            let glossary_bytes = &bytes[pos..];
+            terminal.apply_glyph_glossary(glossary_bytes)?;
+            Ok((terminal, Some(glossary_bytes.to_vec())))
+        } else {
+            Ok((terminal, None))
+        }
+    }
 }
