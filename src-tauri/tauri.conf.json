{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orca Lite",
  "version": "0.1.0",
  "identifier": "com.orca.lite",
  "build": {
    "beforeDevCommand": "sh -c 'cd ui && bun run dev'",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "sh -c 'cd ui && bun run build'",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orca Lite",
        "width": 1280,
        "height": 850,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
