{
  "name": "ferryx-site",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "ferryx.dev",
      "custom_domain": true
    },
    {
      "pattern": "www.ferryx.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
