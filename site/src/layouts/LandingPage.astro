---
import landingStyles from '../index.css?inline';
import { getLocale, type LocaleCode } from '../lib/locale';
import { Navbar } from '../components/Navbar';
import { Hero } from '../components/Hero';
import { Features } from '../components/Features';
import { Benchmarks } from '../components/Benchmarks';
import { Footer } from '../components/Footer';
import LiveFerryxDemo from '../components/LazyLiveDemo';
import SiteAnalytics from '../components/SiteAnalytics.astro';
import { THEME_STORAGE_KEY } from '../lib/theme';

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const { language = 'en' } = Astro.props as { language?: LocaleCode };
const locale = getLocale(language, baseUrl);
const title = language === 'en' ? 'Ferryx — Run Parallel AI Coding Agents in Git Worktrees' : 'Ferryx — 在 Git Worktree 中并行运行 AI 编码智能体';
// Concrete over evocative: the words a crawler and an answer engine need are the ones a
// person would search for — the agents, the isolation mechanism, and the platforms.
const description = language === 'en'
  ? 'Run Claude Code, Codex, and other CLI coding agents in parallel, each in its own Git worktree. Native Rust terminal workspace for macOS, Windows, Linux.'
  : '在独立 Git worktree 中并行运行 Claude Code、Codex 等 CLI 编码智能体。适用于 macOS、Windows 和 Linux 的原生 Rust 终端工作区。';
const socialDescription = language === 'en' ? 'Run Claude Code, Codex, and other CLI coding agents side by side, each isolated in its own Git worktree. Native Rust, no Electron.' : description;
// Crawlers reject relative social URLs, so resolve everything against the deployed origin.
const canonical = new URL(locale.basePath, Astro.site ?? Astro.url).href;
const socialImage = new URL(`${baseUrl}og-image.png`, Astro.site ?? Astro.url).href;

// Every value below is checkable against the repository or a release artifact; see
// /docs/facts/ for the same inventory in prose with its sources.
const repoUrl = 'https://github.com/Indosaram/ferryx';
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'Ferryx',
      applicationCategory: 'DeveloperApplication',
      applicationSubCategory: 'Terminal emulator',
      operatingSystem: ['macOS', 'Windows', 'Linux'],
      url: canonical,
      description,
      image: socialImage,
      license: `${repoUrl}/blob/main/LICENSE`,
      isAccessibleForFree: true,
      downloadUrl: `${repoUrl}/releases/latest`,
      softwareHelp: new URL(`${baseUrl}docs/introduction/`, Astro.site ?? Astro.url).href,
      featureList: [
        'Runs CLI coding agents such as Claude Code, Codex, and Gemini CLI in parallel terminal panes',
        'Managed Git worktree per agent, created and removed by the app and jailed to the repository root',
        'Headless Rust PTY daemon keeps sessions alive when the window closes, and replays missed output on reconnect',
        'libghostty-vt terminal parsing with WGPU native-surface rendering, on Tauri v2 instead of Electron',
        'Embedded native WebView browser tabs beside the terminal panes',
        'Authenticated mobile web client paired with a 6-digit PIN',
      ],
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', availability: 'https://schema.org/InStock' },
      publisher: { '@id': repoUrl },
    },
    { '@type': 'WebSite', name: 'Ferryx', url: canonical, description, publisher: { '@id': repoUrl } },
    { '@type': 'Organization', '@id': repoUrl, name: 'Ferryx', url: repoUrl, sameAs: [repoUrl, 'https://discord.gg/Z2hBkQEHUG'], logo: new URL(`${baseUrl}apple-touch-icon.png`, Astro.site ?? Astro.url).href }
  ]
};
---

<!doctype html>
<html lang={locale.lang}>
  <head>
    <meta charset="UTF-8" />
    <style is:inline set:html={landingStyles} />
    <style is:inline>
      @font-face { font-family: 'Inter Fallback'; src: local('Arial'); size-adjust: 107.31%; }
      body { font-family: Inter, 'Inter Fallback', sans-serif; }
    </style>
    <script is:inline define:vars={{ THEME_STORAGE_KEY }}>
      // Runs before first paint so a dark-theme visitor never sees a light flash.
      const stored = localStorage.getItem(THEME_STORAGE_KEY);
      const theme = stored === 'dark' || stored === 'light'
        ? stored
        : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.classList.toggle('dark', theme === 'dark');
      document.documentElement.style.colorScheme = theme;
    </script>
    <link rel="icon" type="image/x-icon" href={`${baseUrl}favicon.ico`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${baseUrl}favicon-32x32.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${baseUrl}apple-touch-icon.png`} />
    <link rel="manifest" href={`${baseUrl}site.webmanifest`} />
    <link rel="sitemap" type="application/xml" href={`${baseUrl}sitemap-index.xml`} />
    <SiteAnalytics />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(baseUrl, Astro.site ?? Astro.url).href} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(baseUrl + 'zh-cn/', Astro.site ?? Astro.url).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(baseUrl, Astro.site ?? Astro.url).href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ferryx" />
    <meta property="og:locale" content={language === 'en' ? 'en_US' : 'zh_CN'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={language === 'en' ? 'Ferryx — parallel agentic development workspace' : 'Ferryx — 并行智能体开发工作区'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={language === 'en' ? 'Ferryx — parallel agentic development workspace' : 'Ferryx — 并行智能体开发工作区'} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <meta name="theme-color" content="#f6f4f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0b0d" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
  </head>
  <body class="bg-page text-ink antialiased selection:bg-ink selection:text-page min-h-screen">
    <div class="min-h-screen bg-page text-ink flex flex-col selection:bg-ink selection:text-page">
      <Navbar client:load basePath={baseUrl} locale={locale} />
      <main class="flex-1">
        <Hero client:load basePath={baseUrl} locale={locale} />
        <section id="preview" class="relative z-0 overflow-hidden pb-8 sm:pb-12">
          <a href="#features" class="sr-only focus-visible:not-sr-only focus-visible:absolute focus-visible:left-4 focus-visible:top-4 focus-visible:z-30 focus-visible:rounded-full focus-visible:border focus-visible:border-line focus-visible:bg-surface focus-visible:px-3 focus-visible:py-1 focus-visible:text-[13px] focus-visible:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink/30">{locale.labels.skipPreview}</a>
          <div class="relative mx-auto max-w-5xl px-4 sm:px-6 pt-24 pb-14 text-center">
            <h2 class="text-[clamp(1.75rem,3.2vw,2.5rem)] font-medium tracking-[-0.03em] leading-[1.1] text-ink">{locale.copy.previewTitle}</h2>
            <p class="mx-auto mt-4 max-w-2xl text-[15px] leading-relaxed text-ink-soft">{locale.copy.previewDescription}</p>
          </div>
          <div class="relative">
            <!-- The clip matters: scale-105 exists to hide the blur's soft edges, and without it
                 the image overflows the wash below and leaves an unwashed bright band on top. -->
            <div class="absolute inset-x-0 top-0 h-[860px] overflow-hidden">
              <picture>
                <source srcset={baseUrl + 'demo-bg.avif'} type="image/avif" />
                <source srcset={baseUrl + 'demo-bg.webp'} type="image/webp" />
                <img src={baseUrl + 'demo-bg.jpg'} alt="" loading="lazy" decoding="async" width="1024" height="683" class="h-full w-full object-cover object-center scale-105 blur-[1px]" />
              </picture>
            </div>
            <div class="absolute inset-x-0 top-0 h-[860px] bg-demo-wash" />
            <div class="relative mx-auto max-w-5xl px-4 sm:px-6 pt-20">
              <LiveFerryxDemo client:visible locale={locale} />
            </div>
          </div>
        </section>
        <Features client:visible locale={locale} basePath={baseUrl} />
        <Benchmarks client:visible locale={locale} />
      </main>
      <Footer client:visible basePath={baseUrl} locale={locale} />
    </div>
  </body>
</html>
