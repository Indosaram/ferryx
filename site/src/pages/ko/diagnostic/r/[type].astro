---
import DiagnosticLayout from '../../../../layouts/DiagnosticLayout.astro';
import { RESULT_PROFILES } from '../../../../lib/diagnostic/profiles';
import type { ResultProfile } from '../../../../lib/diagnostic/types';
import { ProfileResultApp } from '../../../../components/diagnostic/ProfileResultApp';

export function getStaticPaths() {
  return Object.values(RESULT_PROFILES).map((profile) => ({
    params: { type: profile.slug },
    props: { profile },
  }));
}

interface Props {
  readonly profile: ResultProfile;
}

const { profile } = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const title = `${profile.titleKo} — 코딩 에이전트 워크플로 진단 결과`;
const description = profile.summaryKo;
---

<DiagnosticLayout title={title} description={description} lang="ko">
  <ProfileResultApp client:load profile={profile} lang="ko" basePath={baseUrl} />
</DiagnosticLayout>
