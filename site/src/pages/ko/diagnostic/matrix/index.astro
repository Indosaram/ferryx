---
import DiagnosticLayout from '../../../../layouts/DiagnosticLayout.astro';
import { MatrixTable } from '../../../../components/diagnostic/MatrixTable';

const title = '코딩 에이전트 도구 비교 행렬 — 6축 채점 및 1차 근거';
const description =
  '인터페이스 기저, 프로세스 지속성, 작업 공간 격리, 감독 구조, 플랫폼 지원, 성숙도 6개 축에 걸친 12개 도구의 전수 사실 비교 행렬입니다.';
---

<DiagnosticLayout title={title} description={description} lang="ko">
  <div class="flex flex-col gap-6">
    <div class="flex flex-col gap-2 border-b border-line pb-4">
      <span class="text-xs font-mono uppercase tracking-wider text-ink-soft">
        1차 출처 기반 사실 행렬
      </span>
      <h1 class="text-3xl font-bold tracking-tight text-ink">
        코딩 에이전트 도구 비교 행렬
      </h1>
      <p class="text-sm text-ink-soft max-w-3xl">
        모든 12개 도구를 6개 기술 축으로 평가하며 소스 코드 라인 번호와 1차 출처를 표기했습니다.
        단면적인 초록색 체크마크를 배제하고 실측 제약을 기록합니다.
      </p>
    </div>

    <MatrixTable client:load lang="ko" />
  </div>
</DiagnosticLayout>
