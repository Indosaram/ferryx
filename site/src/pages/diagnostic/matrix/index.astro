---
import DiagnosticLayout from '../../../layouts/DiagnosticLayout.astro';
import { MatrixTable } from '../../../components/diagnostic/MatrixTable';

const title = 'Coding Agent Tools Comparison Matrix — 6-Axis Scored Evidence';
const description =
  'Full factual comparison of 12 coding agent tools across interface substrate, process persistence, workspace isolation, supervision, platform, and maturity.';
---

<DiagnosticLayout title={title} description={description} lang="en">
  <div class="flex flex-col gap-6">
    <div class="flex flex-col gap-2 border-b border-line pb-4">
      <span class="text-xs font-mono uppercase tracking-wider text-ink-soft">
        Factual Verification Matrix
      </span>
      <h1 class="text-3xl font-bold tracking-tight text-ink">
        Coding Agent Environment Matrix
      </h1>
      <p class="text-sm text-ink-soft max-w-3xl">
        All 12 competitor tools evaluated against 6 technical axes with primary citations
        and source code line numbers. No one-sided checkmarks.
      </p>
    </div>

    <MatrixTable client:load lang="en" />
  </div>
</DiagnosticLayout>
