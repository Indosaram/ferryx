+export function slackBlocks(draftId: string, items: readonly Item[]): unknown[] {
+  const quote = (text: string) =>
+    text
+      .split("\n")
+      .map((line) => `>${line}`)
+      .join("\n");
+  const buttons = (item: Item) => ({
+    type: "actions",
+    elements: [
+      ["publish", item.kind === "post" ? "X 발행" : "답글 발행", "primary"],
+      ["preview", "작성창 미리보기", undefined],
+      ["pass", "패스", "danger"],
+    ].map(([action, label, style]) => ({
+      type: "button",
+      text: { type: "plain_text", text: label, emoji: true },
+      action_id: `${action}:${item.id}`,
+      value: `omon:btn:${NAMESPACE}:${action}:${item.id}:${item.token}`,
+      ...(style ? { style } : {}),
