+async function ownerReport(report?: Report): Promise<string> {
+  const db = openDb();
+  try {
+    const outbox = new ReportOutbox(db, defaultReportGate());
+    for (const id of outbox.open("x-growth")) {
+      const row = await outbox.drive(id);
+      if (row.state === "delivered") outbox.complete(id);
+    }
+    if (!report) return "";
+    const row = await outbox.drive(outbox.enqueue(report));
+    if (row.state === "delivered") {
+      outbox.complete(row.id);
+      return "허브 전달 완료 (" + row.ref + ")";
+    }
+    return "허브 " + row.state + " (" + (row.reason ?? row.outboxId ?? row.id) + ")";
+  } finally {
+    db.close();
+  }
