+export type ReplyPlan = {
+  date: string;
+  slots: {
+    at: string;
+    kind: "post" | "reply";
+    status: "planned" | "running" | "done" | "skipped";
+    note?: string;
+  }[];
+};
+
+export function kstDate(date: Date): string {
+  return new Date(date.getTime() + 9 * 3600 * 1000).toISOString().slice(0, 10);
+}
+
+export function makePlan(day: string, random: () => number = Math.random): ReplyPlan {
+  const roll = random();
+  const count = roll < 0.2 ? 0 : roll < 0.65 ? 1 : 2;
+  const startMin = 9 * 60;
+  const endMin = 23 * 60 + 30;
+  const minutes: number[] = [];
+  for (let guard = 0; minutes.length < count && guard < 50; guard += 1) {
+    const m = startMin + Math.floor(random() * (endMin - startMin));
+    if (minutes.every((x) => Math.abs(x - m) >= 90)) minutes.push(m);
+  }
+  const base = Date.parse(`${day}T00:00:00+09:00`);
+  const slots: ReplyPlan["slots"] = minutes.map((m) => ({
+    at: new Date(base + m * 60_000).toISOString(),
+    kind: "reply" as const,
+    status: "planned" as const,
+  }));
+  if (random() < 0.85) {
+    const m = 9 * 60 + Math.floor(random() * (21 * 60 - 9 * 60));
+    slots.push({ at: new Date(base + m * 60_000).toISOString(), kind: "post", status: "planned" });
+  }
+  return { date: day, slots: slots.sort((a, b) => Date.parse(a.at) - Date.parse(b.at)) };
+}
+
+export function dueSlot(plan: ReplyPlan, now: Date): { index: number; stale: boolean } | null {
+  const index = plan.slots.findIndex(
+    (slot) => slot.status === "planned" && Date.parse(slot.at) <= now.getTime(),
+  );
+  if (index < 0) return null;
+  const at = Date.parse(plan.slots[index]?.at ?? "");
+  return { index, stale: now.getTime() - at > STALE_SLOT_MS };
+}
+
+function readPlan(): ReplyPlan | null {
+  return existsSync(PLAN_PATH) ? (JSON.parse(readFileSync(PLAN_PATH, "utf8")) as ReplyPlan) : null;
+}
+
+function savePlan(plan: ReplyPlan) {
+  mkdirSync(DIR, { recursive: true });
+  writeFileSync(PLAN_PATH, JSON.stringify(plan, null, 2));
+}
