-export function parseCount(raw: string): number {
-  const n = Number.parseFloat(raw.replace(/,/g, ""));
-  if (Number.isNaN(n)) return 0;
-  if (raw.endsWith("K")) return Math.round(n * 1000);
-  if (raw.endsWith("M")) return Math.round(n * 1_000_000);
-  return Math.round(n);
