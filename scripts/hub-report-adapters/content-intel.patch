diff --git a/lib/ferryx-report-gate.ts b/lib/ferryx-report-gate.ts
new file mode 100644
index 0000000..f8c9057
--- /dev/null
+++ b/lib/ferryx-report-gate.ts
@@ -0,0 +1,169 @@
+/**
+ * Client for the Ferryx hub control socket `report` / `report_status` operations
+ * (crates/ferryx-hub/src/control.rs). The hub owns owner-facing Slack delivery; a producer
+ * learns it only from a real receipt, never from admission.
+ */
+import { createConnection } from "node:net";
+import { homedir } from "node:os";
+import { join } from "node:path";
+
+export type Report = {
+  readonly source: string;
+  readonly topic: string;
+  readonly salience: "action" | "decision" | "result" | "fyi" | "internal";
+  readonly body: string;
+  readonly state: string;
+  readonly quote?: string;
+  readonly sender?: string;
+  readonly origin?: string;
+  readonly thread?: string;
+  readonly blocks?: readonly Record<string, unknown>[];
+  readonly blocked_reason?: string;
+};
+
+export type Delivery =
+  | { readonly kind: "pending"; readonly outboxId: number }
+  | { readonly kind: "delivered"; readonly outboxId: number; readonly ref: string }
+  | { readonly kind: "suppressed"; readonly reason: string };
+
+/** `in_flight`/`recovering`: the hub still settles this identity; `uncertain` and card-only `superseded` are final. */
+export type MutationState = "delivered" | "suppressed" | "pending" | "uncertain" | "superseded" | "in_flight" | "recovering";
+
+export class GateError extends Error {
+  constructor(
+    readonly code: "unavailable" | "protocol" | "rejected",
+    message: string,
+  ) {
+    super(message);
+    this.name = "GateError";
+  }
+}
+
+export type Transport = (request: Readonly<Record<string, unknown>>) => Promise<unknown>;
+
+export function socketTransport(path: string): Transport {
+  return (request) =>
+    new Promise((resolve, reject) => {
+      const socket = createConnection(path);
+      let buffer = "";
+      let settled = false;
+      const fail = (error: GateError) => {
+        if (settled) return;
+        settled = true;
+        socket.destroy();
+        reject(error);
+      };
+      socket.setEncoding("utf8");
+      socket.setTimeout(20_000, () => fail(new GateError("unavailable", "Hub reply timed out")));
+      socket.once("connect", () => socket.write(`${JSON.stringify(request)}\n`));
+      socket.on("data", (chunk) => {
+        buffer += chunk;
+        if (buffer.length > 1_048_576) {
+          fail(new GateError("protocol", "Hub reply exceeds 1 MiB"));
+          return;
+        }
+        const end = buffer.indexOf("\n");
+        if (end < 0 || settled) return;
+        try {
+          const reply: unknown = JSON.parse(buffer.slice(0, end));
+          settled = true;
+          socket.destroy();
+          resolve(reply);
+        } catch (error) {
+          fail(new GateError("protocol", error instanceof Error ? error.message : "Invalid JSON"));
+        }
+      });
+      socket.once("error", (error) => fail(new GateError("unavailable", error.message)));
+      socket.once("close", () => fail(new GateError("unavailable", "Hub closed before its reply")));
+    });
+}
+
+function reply(value: unknown, op: string): Readonly<Record<string, unknown>> {
+  if (typeof value !== "object" || value === null || Array.isArray(value))
+    throw new GateError("protocol", "Expected a hub reply object");
+  const parsed = value as Readonly<Record<string, unknown>>;
+  if (parsed["status"] === "failed") {
+    const error = parsed["error"];
+    throw new GateError("rejected", typeof error === "string" ? error : String(parsed["code"]));
+  }
+  if (parsed["status"] !== "ok" || parsed["op"] !== op)
+    throw new GateError("protocol", "Unexpected hub reply operation or status");
+  return parsed;
+}
+
+function positiveId(value: unknown): number {
+  if (typeof value !== "number" || !Number.isSafeInteger(value) || value <= 0)
+    throw new GateError("protocol", "Missing positive outbox ID");
+  return value;
+}
+
+export class ReportGate {
+  constructor(private readonly transport: Transport) {}
+
+  async mutate(outboxId: number, mutationId: string, change: Record<string, unknown>): Promise<MutationState> {
+    const value = reply(await this.transport({ op: "report_mutate", outbox_id: positiveId(outboxId), mutation_id: mutationId, change }), "report_mutate");
+    if (value["outbox_id"] !== outboxId || value["mutation_id"] !== mutationId) throw new GateError("protocol", "Mutation identity mismatch");
+    const delivery = value["delivery"];
+    if (delivery !== "delivered" && delivery !== "suppressed" && delivery !== "pending" && delivery !== "uncertain" && delivery !== "superseded") throw new GateError("protocol", "Unknown mutation state");
+    const progress = value["progress"];
+    if (delivery !== "pending" || progress === undefined) return delivery;
+    // The hub is still settling this identity itself: ask again with it, never give it up.
+    if ((progress === "in_flight" || progress === "recovering") && value["blocked_by"] === mutationId) return progress;
+    throw new GateError("protocol", "Unknown mutation progress");
+  }
+
+  async status(outboxId: number): Promise<Delivery> {
+    const id = positiveId(outboxId);
+    const value = reply(
+      await this.transport({ op: "report_status", outbox_id: id }),
+      "report_status",
+    );
+    if (value["outbox_id"] !== id)
+      throw new GateError("protocol", "Receipt belongs to another outbox row");
+    switch (value["delivery"]) {
+      case "pending":
+        return { kind: "pending", outboxId: id };
+      case "cancelled":
+        return { kind: "suppressed", reason: "cancelled" };
+      case "delivered": {
+        const channel = value["channel"];
+        const ts = value["ts"];
+        if (typeof channel !== "string" || !channel.trim() || typeof ts !== "string" || !ts.trim())
+          throw new GateError("protocol", "Delivered report has no Slack receipt");
+        return { kind: "delivered", outboxId: id, ref: `${channel}:${ts}` };
+      }
+      default:
+        throw new GateError("protocol", "Unknown delivery state");
+    }
+  }
+
+  async submit(report: Report): Promise<Delivery> {
+    const value = reply(await this.transport({ op: "report", ...report }), "report");
+    const decision = value["decision"];
+    switch (decision) {
+      case "sent":
+        return this.status(positiveId(value["outbox_id"]));
+      // A duplicate recovers the original row; a deferred card (digest with blocks) keeps its
+      // own pending row. Only a null outbox_id means nothing will be posted for this request.
+      case "duplicate":
+      case "digest":
+        return value["outbox_id"] === null
+          ? { kind: "suppressed", reason: decision }
+          : this.status(positiveId(value["outbox_id"]));
+      case "muted":
+      case "internal":
+      case "empty":
+      case "stale":
+        return { kind: "suppressed", reason: decision };
+      default:
+        throw new GateError("protocol", "Unknown gate decision");
+    }
+  }
+}
+
+/** The hub control socket (`FERRYX_HUB_CONTROL_SOCKET`, else `~/.ferryx/hub/control.sock`). */
+export function defaultReportGate(env: Readonly<Record<string, string | undefined>> = process.env): ReportGate {
+  const path =
+    env["FERRYX_HUB_CONTROL_SOCKET"]?.trim() || join(homedir(), ".ferryx", "hub", "control.sock");
+  return new ReportGate(socketTransport(path));
+}
diff --git a/lib/report-outbox.ts b/lib/report-outbox.ts
new file mode 100644
index 0000000..0d1dc1a
--- /dev/null
+++ b/lib/report-outbox.ts
@@ -0,0 +1,294 @@
+/**
+ * Durable producer side of owner reporting. Every owner-facing message is written here before
+ * any network call, then admitted to the Ferryx hub. Only a real hub receipt (channel:ts) marks a
+ * row delivered; muted/cancelled/internal decisions are an explicit terminal `suppressed` state.
+ * Rows survive restarts: the next run resumes from the stored hub outbox ID. There is no time
+ * window; the row key is the report's source, topic and state.
+ */
+import type { Database } from "bun:sqlite";
+import { createHash } from "node:crypto";
+import { existsSync } from "node:fs";
+import { type Delivery, GateError, type Report, type ReportGate } from "./ferryx-report-gate";
+
+export type Attachment = { readonly name: string; readonly path: string };
+
+/** Thrown by an uploader when the file was certainly not shared, so retrying cannot duplicate it. */
+export class AttachmentNotShared extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "AttachmentNotShared";
+  }
+}
+
+/** Thrown by an uploader when the hub's own receipt says the share outcome is unknown. */
+export class AttachmentUncertain extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "AttachmentUncertain";
+  }
+}
+
+/**
+ * Thrown by an uploader when the hub is still settling this exact identity (its upload is in
+ * flight). The claim is kept, so the next run asks the hub again with the same identity.
+ */
+export class AttachmentInFlight extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "AttachmentInFlight";
+  }
+}
+
+/** Shares one file into the delivered parent message's thread. */
+export type Uploader = (channel: string, threadTs: string, file: Attachment, parent?: { outboxId: number; mutationId: string }) => Promise<void>;
+
+export type OutboxState = "pending" | "delivered" | "suppressed" | "failed";
+
+export type OutboxRow = {
+  readonly id: string;
+  readonly source: string;
+  readonly state: OutboxState;
+  readonly outboxId: number | null;
+  readonly ref: string | null;
+  readonly reason: string | null;
+  readonly meta: Readonly<Record<string, unknown>>;
+  readonly attachments: readonly Attachment[];
+  readonly attachmentsDone: number;
+  readonly uncertain: readonly string[];
+  readonly completed: boolean;
+};
+
+type RawRow = {
+  id: string;
+  source: string;
+  request: string;
+  meta: string;
+  state: OutboxState;
+  outbox_id: number | null;
+  ref: string | null;
+  reason: string | null;
+  attachments: string;
+  attachments_started: number;
+  attachments_done: number;
+  uncertain: string;
+  completed_at: string | null;
+};
+
+export function reportKey(report: Pick<Report, "source" | "topic" | "state">): string {
+  return createHash("sha256")
+    .update(JSON.stringify([report.source, report.topic, report.state]))
+    .digest("hex");
+}
+
+export class ReportOutbox {
+  constructor(
+    private readonly db: Database,
+    private readonly gate: ReportGate,
+  ) {
+    db.exec(`CREATE TABLE IF NOT EXISTS report_outbox (
+      id TEXT PRIMARY KEY,
+      source TEXT NOT NULL,
+      request TEXT NOT NULL,
+      meta TEXT NOT NULL DEFAULT '{}',
+      state TEXT NOT NULL DEFAULT 'pending',
+      outbox_id INTEGER,
+      ref TEXT,
+      reason TEXT,
+      attachments TEXT NOT NULL DEFAULT '[]',
+      attachments_started INTEGER NOT NULL DEFAULT 0,
+      attachments_done INTEGER NOT NULL DEFAULT 0,
+      uncertain TEXT NOT NULL DEFAULT '[]',
+      completed_at TEXT,
+      created_at TEXT NOT NULL)`);
+  }
+
+  /** Persists the delivery intent. Re-enqueueing the same source/topic/state is a no-op. */
+  enqueue(
+    report: Report,
+    meta: Readonly<Record<string, unknown>> = {},
+    attachments: readonly Attachment[] = [],
+  ): string {
+    const id = reportKey(report);
+    this.db
+      .query(
+        `INSERT OR IGNORE INTO report_outbox(id, source, request, meta, attachments, created_at)
+         VALUES(?, ?, ?, ?, ?, ?)`,
+      )
+      .run(
+        id,
+        report.source,
+        JSON.stringify(report),
+        JSON.stringify(meta),
+        JSON.stringify(attachments),
+        new Date().toISOString(),
+      );
+    return id;
+  }
+
+  exists(id: string): boolean {
+    return (
+      this.db.query<{ id: string }, [string]>("SELECT id FROM report_outbox WHERE id = ?").get(id) !==
+      null
+    );
+  }
+
+  /** Rows of `source` that still need a hub answer, producer completion or attachments. */
+  open(source: string): readonly string[] {
+    return this.db
+      .query<{ id: string }, [string]>(
+        `SELECT id FROM report_outbox WHERE source = ?
+           AND (state = 'pending' OR (state = 'delivered' AND (completed_at IS NULL
+             OR attachments_done < json_array_length(attachments))))
+         ORDER BY rowid`,
+      )
+      .all(source)
+      .map((row) => row.id);
+  }
+
+  get(id: string): OutboxRow {
+    const raw = this.db
+      .query<RawRow, [string]>("SELECT * FROM report_outbox WHERE id = ?")
+      .get(id);
+    if (raw === null) throw new GateError("protocol", `Unknown local report ${id}`);
+    return {
+      attachments: JSON.parse(raw.attachments) as Attachment[],
+      attachmentsDone: raw.attachments_done,
+      completed: raw.completed_at !== null,
+      id: raw.id,
+      meta: JSON.parse(raw.meta) as Record<string, unknown>,
+      outboxId: raw.outbox_id,
+      reason: raw.reason,
+      ref: raw.ref,
+      source: raw.source,
+      state: raw.state,
+      uncertain: JSON.parse(raw.uncertain) as string[],
+    };
+  }
+
+  /**
+   * Advances one row as far as the hub allows. An unavailable hub leaves the row pending for
+   * the next run; a rejected or malformed exchange marks it `failed` and rethrows.
+   */
+  async drive(id: string): Promise<OutboxRow> {
+    const row = this.get(id);
+    if (row.state !== "pending") return row;
+    let delivery: Delivery;
+    try {
+      delivery =
+        row.outboxId === null
+          ? await this.gate.submit(this.request(id))
+          : await this.gate.status(row.outboxId);
+    } catch (error) {
+      if (error instanceof GateError && error.code === "unavailable") return row;
+      const reason =
+        error instanceof GateError ? `${error.code}: ${error.message}` : String(error);
+      this.db
+        .query("UPDATE report_outbox SET state = 'failed', reason = ? WHERE id = ?")
+        .run(reason, id);
+      throw error;
+    }
+    this.record(id, delivery);
+    return this.get(id);
+  }
+
+  /** Marks the producer's own post-delivery bookkeeping finished. */
+  complete(id: string): void {
+    this.db
+      .query("UPDATE report_outbox SET completed_at = ? WHERE id = ? AND state = 'delivered'")
+      .run(new Date().toISOString(), id);
+  }
+
+  private request(id: string): Report {
+    const raw = this.db
+      .query<{ request: string }, [string]>("SELECT request FROM report_outbox WHERE id = ?")
+      .get(id);
+    return JSON.parse(raw?.request ?? "null") as Report;
+  }
+
+  private record(id: string, delivery: Delivery): void {
+    switch (delivery.kind) {
+      case "pending":
+        this.db
+          .query("UPDATE report_outbox SET outbox_id = ? WHERE id = ?")
+          .run(delivery.outboxId, id);
+        return;
+      case "delivered":
+        this.db
+          .query(
+            "UPDATE report_outbox SET state = 'delivered', outbox_id = ?, ref = ? WHERE id = ?",
+          )
+          .run(delivery.outboxId, delivery.ref, id);
+        return;
+      case "suppressed":
+        this.db
+          .query("UPDATE report_outbox SET state = 'suppressed', reason = ? WHERE id = ?")
+          .run(delivery.reason, id);
+        return;
+    }
+  }
+
+  /**
+   * Shares attachments into the delivered parent's thread, at most once each. The claim is
+   * persisted before the upload. A claim without a confirmation (crash or lost reply) is replayed
+   * with the same mutation identity, so the hub's receipt decides: it answers an identity it
+   * already holds without posting again. Only the hub's final `uncertain` answer records an
+   * attachment as uncertain; the producer never infers it. While the hub reports the identity in
+   * flight, the claim stays open and later attachments wait. Never runs before a real receipt.
+   */
+  async shareAttachments(id: string, upload: Uploader): Promise<OutboxRow> {
+    const row = this.get(id);
+    if (row.state !== "delivered" || row.ref === null) return row;
+    const split = row.ref.indexOf(":");
+    const channel = row.ref.slice(0, split);
+    const threadTs = row.ref.slice(split + 1);
+    const claimed = this.db
+      .query<{ attachments_started: number }, [string]>(
+        "SELECT attachments_started FROM report_outbox WHERE id = ?",
+      )
+      .get(row.id);
+    const started = claimed?.attachments_started ?? row.attachmentsDone;
+    for (let index = row.attachmentsDone; index < row.attachments.length; index += 1) {
+      const file = row.attachments[index];
+      if (file === undefined) break;
+      // A replayed claim goes to the hub even without the file: the hub may already hold it.
+      if (index >= started && !existsSync(file.path)) {
+        // Retrying cannot bring a deleted preview back; record it instead of blocking the row.
+        this.markUncertain(row.id, index, `${file.name} (missing)`);
+        continue;
+      }
+      this.db
+        .query("UPDATE report_outbox SET attachments_started = ? WHERE id = ?")
+        .run(index + 1, row.id);
+      try {
+        if (row.outboxId === null) throw new AttachmentNotShared("Missing parent outbox id");
+        await upload(channel, threadTs, file, { outboxId: row.outboxId, mutationId: `${row.id}:attachment:${index}` });
+      } catch (error) {
+        if (error instanceof AttachmentUncertain) {
+          this.markUncertain(row.id, index, file.name);
+          continue;
+        }
+        // Keep the claim: the next run re-queries the hub with this identity, in order.
+        if (error instanceof AttachmentInFlight) break;
+        if (error instanceof AttachmentNotShared) {
+          this.db
+            .query("UPDATE report_outbox SET attachments_started = ? WHERE id = ?")
+            .run(index, row.id);
+        }
+        throw error;
+      }
+      this.db
+        .query("UPDATE report_outbox SET attachments_done = ? WHERE id = ?")
+        .run(index + 1, row.id);
+    }
+    return this.get(id);
+  }
+
+  private markUncertain(id: string, index: number, name: string): void {
+    const uncertain = [...this.get(id).uncertain, name];
+    this.db
+      .query(
+        "UPDATE report_outbox SET attachments_done = ?, attachments_started = ?, uncertain = ? WHERE id = ?",
+      )
+      .run(index + 1, index + 1, JSON.stringify(uncertain), id);
+  }
+}
