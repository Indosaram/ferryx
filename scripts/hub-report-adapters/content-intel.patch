-    const tabId = openTab(`https://x.com/search?q=${q}&src=typed_query&f=top`);
-    try {
-      if (!waitFor(tabId, "article[data-testid='tweet']", 40_000)) continue;
-      Bun.sleepSync(2000);
-      const res = tryTool("page.content", { tab_id: tabId });
