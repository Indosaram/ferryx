+  const blocks: unknown[] = [
+    { type: "header", text: { type: "plain_text", text: `📈 X 성장 초안 · ${draftId}` } },
+  ];
+  for (const item of items) {
+    const head =
+      item.kind === "post"
+        ? `*새 글 · @${OWNER}* (${[...item.text].length}자)`
+        : `*답글 → <https://x.com/${item.reply_to?.author}/status/${item.reply_to?.id}|@${item.reply_to?.author}> (${item.reply_to?.likes} likes)*\n${quote((item.reply_to?.text ?? "").slice(0, 280))}\n*내 답글* (${[...item.text].length}자)`;
+    blocks.push({ type: "divider" });
+    blocks.push({
+      type: "section",
+      text: { type: "mrkdwn", text: `${head}\n${quote(item.text)}` },
+    });
+    blocks.push(buttons(item));
+  }
+  blocks.push({
+    type: "context",
+    elements: [
+      {
+        type: "mrkdwn",
+        text: "버튼을 누르기 전에는 아무것도 게시되지 않습니다. 숫자는 모두 YC 6,320 리포트에 있는 값만 씁니다.",
