+export function loadItem(itemId: string, token: string, root: string = DIR): Item {
+  const match = itemId.match(/^(\d{8}-\d{4})-(p|r\d|a)$/);
+  if (!match) throw new Error(`잘못된 항목 id: ${itemId}`);
+  const path = join(root, match[1] ?? "", "draft.json");
+  if (!existsSync(path)) throw new Error(`초안 ${match[1]}을(를) 찾을 수 없습니다.`);
+  const { items } = JSON.parse(readFileSync(path, "utf8")) as { items: Item[] };
+  const item = items.find((i) => i.id === itemId);
+  if (!item) throw new Error(`항목 ${itemId}이(가) 초안에 없습니다.`);
+  if (item.token !== token || itemToken(item.text, item.reply_to?.id ?? "") !== token)
+    throw new Error(`항목 ${itemId}의 내용이 슬랙에 보낸 것과 다릅니다. 발행하지 않았습니다.`);
