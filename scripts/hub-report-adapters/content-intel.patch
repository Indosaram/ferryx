+#!/usr/bin/env bun
+/**
+ * Daily X growth loop for @indo_yoon, scheduled from the Ferryx hub.
+ *
+ *   draft                         daily cron: write one insight post from the YC 6,320 fact bank and
+ *                                 send it to Slack with buttons. Posts are only published on click.
+ *   tick                          cron every 20 min: on a random daily plan (0-2 slots, random times),
+ *                                 write one reply to a popular startup post in a random style, gate it
+ *                                 with Jev, publish it, then report to Slack with a delete button.
+ *   publish|preview|pass|delete <item-id> <token>
+ *                                 Slack button actions (namespace x-growth).
+ *
+ * Posts need the owner's click. Replies are auto-published only when Jev scores them at or above
+ * JEV_THRESHOLD. Every number in any copy must exist in the fact bank.
+ */
+import { createHash } from "node:crypto";
+import { existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { OUTPUT_DIR } from "../lib/paths";
+import { openDb } from "../lib/db";
+import { defaultReportGate, type Report } from "../lib/ferryx-report-gate";
+import { ReportOutbox } from "../lib/report-outbox";
+
+export const NAMESPACE = "x-growth";
+export const OWNER = "indo_yoon";
+export const X_LIMIT = 280;
+const DIR = join(OUTPUT_DIR, "x-growth", "daily");
+const HISTORY_PATH = join(DIR, "history.json");
+const FACTS_PATH = join(OUTPUT_DIR, "x-growth", "yc-2027-report.md");
+const MAX_ATTEMPTS = 3;
+const MAX_REPLIES = 3;
+const PLAN_PATH = join(DIR, "reply-plan.json");
+export const JEV_BANDS = {
+  post: { auto: 0.25, ask: 0.1 },
+  reply: { auto: 0.5, ask: 0.15 },
+} as const;
+export type Verdict = "auto" | "ask" | "drop";
+
+export function verdict(kind: "post" | "reply", score: number): Verdict {
+  const band = JEV_BANDS[kind];
+  return score >= band.auto ? "auto" : score >= band.ask ? "ask" : "drop";
+}
+const AUTHOR_COOLDOWN_MS = 7 * 24 * 3600 * 1000;
+const STALE_SLOT_MS = 3 * 3600 * 1000;
+const MAX_JITTER_MS = 12 * 60 * 1000;
+const AUTO_SEARCHES = [
+  '(yc OR "y combinator") lang:en -filter:replies',
+  "(startup OR founders) (robotics OR hardware OR defense) lang:en -filter:replies",
+  '("startup idea" OR "what to build") lang:en -filter:replies',
+  '(founder OR founders) (solo OR "small team") lang:en -filter:replies',
+  "(seed OR preseed) (ai OR startup) lang:en -filter:replies",
+];
+const MIN_FAVES = [100, 200, 300];
+const REPLY_STYLES = [
+  "one short sentence under 90 characters: a sharp observation tied to their point, at most one number",
+  "two short lines: one number from the fact bank, then what it implies for their point",
+  "a mild contrarian take on their point backed by one fact, under 180 characters",
+  "agree and extend: add the one data point their readers would not know, under 160 characters",
+  "a plain observation with no numbers at all, grounded in a trend from the fact bank, under 140 characters",
+];
+const PUBLISHED_POSTS = [
+  "i ran every yc company through the same filter. all 6,320, back to 2005. share building robots, drones, chips, energy or defense: 2015: 7.5% 2023: 2.6% 2026: 17.1%",
+  "yc went physical. startups building robots, drones, chips, energy or defense: 2023: 2.6% of the batch 2026: 17.1%. defense + drone: 0 → 21. voice ai and sales tools: roughly halved.",
+];
+
+export type Candidate = {
+  readonly id: string;
+  readonly author: string;
+  readonly text: string;
+  readonly likes: number;
+};
+
+export type Item = {
+  readonly id: string;
+  readonly kind: "post" | "reply";
+  readonly text: string;
+  readonly token: string;
+  readonly reply_to?: Candidate;
+};
+
+type History = {
+  posts: string[];
+  replied: string[];
+  authors: Record<string, string>;
+  published: Record<string, { at: string; by: string; url?: string }>;
+  passed: Record<string, { at: string; by: string }>;
+};
+
+export function parseCandidates(html: string): Candidate[] {
+  const out: Candidate[] = [];
+  for (const article of html.split('data-testid="tweet"').slice(1)) {
+    const status = article.match(/href="\/([A-Za-z0-9_]+)\/status\/(\d+)"/);
+    if (!status) continue;
+    const [, author = "", id = ""] = status;
+    if (author.toLowerCase() === OWNER) continue;
+    const start = article.indexOf('data-testid="tweetText"');
+    if (start < 0) continue;
+    const rest = article.slice(start);
+    const end = rest.indexOf("data-testid=", 25);
+    const text = (end > 0 ? rest.slice(0, end) : rest.slice(0, 4000))
+      .replace(/^data-testid="tweetText"[^>]*>/, "")
+      .replace(/<img[^>]*alt="([^"]*)"[^>]*>/g, "$1")
+      .replace(/<[^>]+>/g, "")
+      .replace(/&quot;/g, '"')
+      .replace(/&#39;/g, "'")
+      .replace(/&amp;/g, "&")
+      .replace(/\\n/g, "\n")
+      .replace(/<[^>]*$/, "")
+      .trim();
+    const likesRaw = article.match(/(\d[\d,.]*[KM]?) [Ll]ikes?/)?.[1] ?? "0";
+    if (text.length < 20) continue;
+    out.push({ author, id, likes: parseCount(likesRaw), text: text.slice(0, 600) });
+  }
+  return out;
+}
+
+export function parseCount(raw: string): number {
+  const n = Number.parseFloat(raw.replace(/,/g, ""));
+  if (Number.isNaN(n)) return 0;
+  if (raw.endsWith("K")) return Math.round(n * 1000);
+  if (raw.endsWith("M")) return Math.round(n * 1_000_000);
+  return Math.round(n);
+}
+
+export function ungroundedNumbers(text: string, facts: string): string[] {
+  const numbers = text.match(/\d[\d,.]*\d%?|\d%?/g) ?? [];
+  const plain = facts.replace(/\*/g, "");
+  return numbers.filter((n) => !plain.includes(n.replace(/[.,]$/, "")));
+}
+
+export function copyProblems(text: string, facts: string): string[] {
+  const problems: string[] = [];
+  const length = [...text].length;
+  if (length > X_LIMIT) problems.push(`${length} chars (max ${X_LIMIT})`);
+  if (/#[\p{L}\d_]+/u.test(text)) problems.push("contains a hashtag");
+  if (/!/.test(text)) problems.push("contains an exclamation mark");
+  if (/[\u3131-\uD79D]/.test(text)) problems.push("X copy must be English only");
+  if (/https?:\/\//.test(text)) problems.push("no links in the copy");
+  const bad = ungroundedNumbers(text, facts);
+  if (bad.length > 0) problems.push(`numbers not in the fact bank: ${bad.join(", ")}`);
+  return problems;
+}
+
+export function buildPrompt(
+  facts: string,
+  recentPosts: readonly string[],
+  candidates: readonly Candidate[],
+  feedback: readonly string[] = [],
+): string {
+  return [
+    "You ghostwrite X posts for @indo_yoon, a solo developer who analyzed all 6,320 YC companies.",
+    "Voice: lowercase, plain, direct, like a builder thinking out loud. No hype words, no emoji, no hashtags, no exclamation marks, no closing questions that beg for engagement.",
+    "",
+    "FACT BANK (the ONLY source of facts and numbers; copy numbers exactly as written here):",
+    facts,
+    "",
+    "ALREADY POSTED (do not repeat these angles or numbers as the lead):",
+    ...recentPosts.map((p) => `- ${p.replace(/\n/g, " ")}`),
+    "",
+    "TASK 1: Write ONE new English post (<= 260 chars). Lead with a non-obvious claim someone could save or argue with, then 1-3 short lines of evidence from the fact bank. Pick a different shift, gap or idea than the already-posted ones.",
+    "",
+    ...(candidates.length === 0
+      ? []
+      : [
+          "",
+          "TASK 2: Below are today's popular posts. Choose up to 3 where a short reply backed by the fact bank genuinely adds something the author's readers would want. Skip anything off-topic, political, or where the data does not fit. Each reply is English, <= 220 chars, adds one concrete data point or contrarian angle, and never says 'great post', never asks for a follow, never links.",
+          ...candidates.map(
+            (c) => `- id=${c.id} @${c.author} (${c.likes} likes): ${c.text.replace(/\n/g, " ")}`,
+          ),
+        ]),
+    ...(feedback.length > 0
+      ? ["", "PREVIOUS ATTEMPT WAS REJECTED. Fix these:", ...feedback.map((f) => `- ${f}`)]
+      : []),
+    "",
+    "Return ONLY minified JSON:",
+    '{"post":"...","replies":[{"tweet_id":"...","text":"..."}]}',
+  ].join("\n");
