new file mode 100644
index 0000000..e182d62
--- /dev/null
+++ b/tests/helpers/fake-hub.ts
@@ -0,0 +1,50 @@
+import { GateError, type Transport } from "../../lib/ferryx-report-gate";
+
+/**
+ * In-process stand-in for the Ferryx hub control socket. It follows control.rs: `report`
+ * answers a decision and outbox_id, `report_status` answers the row's delivery receipt.
+ */
+export class FakeHub {
+  readonly requests: Record<string, unknown>[] = [];
+  readonly rows = new Map<number, { delivery: "pending" | "delivered" | "cancelled"; ts?: string }>();
+  decision: "sent" | "digest" | "muted" | "duplicate" | "internal" = "sent";
+  down = false;
+  private next = 1;
+
+  readonly transport: Transport = async (request) => {
+    if (this.down) throw new GateError("unavailable", "connect ENOENT");
+    this.requests.push({ ...request });
+    if (request["op"] === "report_status") {
+      const id = Number(request["outbox_id"]);
+      const row = this.rows.get(id);
+      if (!row) return { status: "failed", op: "report_status", code: "not_found", outbox_id: id };
+      return {
+        status: "ok",
+        op: "report_status",
+        outbox_id: id,
+        delivery: row.delivery,
+        channel: row.ts ? "D1" : null,
+        ts: row.ts ?? null,
+      };
+    }
+    if (this.decision === "sent" || this.decision === "digest") {
+      const id = this.next++;
+      this.rows.set(id, { delivery: "pending" });
+      return { status: "ok", op: "report", decision: this.decision, outbox_id: id };
+    }
+    return { status: "ok", op: "report", decision: this.decision, outbox_id: null };
+  };
+
+  /** The hub's outbox worker posting row `id` to Slack. */
+  deliver(id: number, ts: string): void {
+    this.rows.set(id, { delivery: "delivered", ts });
+  }
+
+  cancel(id: number): void {
+    this.rows.set(id, { delivery: "cancelled" });
+  }
+
+  reports(): Record<string, unknown>[] {
+    return this.requests.filter((request) => request["op"] === "report");
+  }
+}
