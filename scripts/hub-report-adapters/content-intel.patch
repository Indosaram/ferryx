+): Candidate[] {
+  return candidates.filter((c) => {
+    if (history.replied.includes(c.id)) return false;
+    const last = history.authors[c.author.toLowerCase()];
+    return !last || now.getTime() - Date.parse(last) >= AUTHOR_COOLDOWN_MS;
