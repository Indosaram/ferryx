+type ToolResult = Record<string, unknown>;
+
+function tool(id: string, args: Record<string, unknown>): ToolResult {
+  const r = Bun.spawnSync(["maho", "--json", "tool", "run", id, "--args", JSON.stringify(args)], {
+    timeout: 60_000,
+  });
+  const raw = r.stdout.toString();
+  try {
+    const parsed = JSON.parse(raw) as ToolResult;
+    if (parsed["ok"] === false) throw new Error(JSON.stringify(parsed["error"]));
+    return (parsed["result"] ?? {}) as ToolResult;
+  } catch (error) {
+    const detail = (raw + r.stderr.toString()).trim().slice(0, 300);
+    throw new Error(`maho ${id} failed (exit ${r.exitCode}): ${detail || String(error)}`);
+  }
+}
+
+function tryTool(id: string, args: Record<string, unknown>): ToolResult | null {
+  try {
+    return tool(id, args);
+  } catch {
+    return null;
+  }
+}
+
+// Maho aborts every tools/call at 15s, so poll the fast query_selector under our own deadline.
+function waitFor(tabId: number, selector: string, timeoutMs: number): boolean {
+  const deadline = Date.now() + timeoutMs;
+  for (;;) {
+    const res = tryTool("page.query_selector", { selector, tab_id: tabId });
+    if (Number(res?.["match_count"] ?? 0) > 0) return true;
+    if (Date.now() >= deadline) return false;
+    Bun.sleepSync(500);
+  }
+}
+
+function openTab(url: string): number {
+  Bun.spawnSync(["open", "-g", "-a", "Maho"]);
+  return Number((tool("tab.new", { url })["tab"] as { id: number }).id);
+}
+
+function searchCandidates(queries: readonly string[], replied: ReadonlySet<string>): Candidate[] {
+  const since = new Date(Date.now() - 36 * 3600 * 1000).toISOString().slice(0, 10);
+  const seen = new Map<string, Candidate>();
+  for (const query of queries) {
+    const q = encodeURIComponent(`${query} since:${since}`);
+    const tabId = openTab(`https://x.com/search?q=${q}&src=typed_query&f=top`);
+    try {
+      if (!waitFor(tabId, "article[data-testid='tweet']", 40_000)) continue;
+      Bun.sleepSync(2000);
+      const res = tryTool("page.content", { tab_id: tabId });
+      const raw = String(res?.["text"] ?? "").replace(/\\"/g, '"');
+      for (const c of parseCandidates(raw)) if (!replied.has(c.id)) seen.set(c.id, c);
+    } finally {
+      tryTool("tab.close", { tab_id: tabId });
+    }
+  }
+  return [...seen.values()].sort((a, b) => b.likes - a.likes).slice(0, 12);
+}
