+	if (row.state !== "delivered" || row.completed) return row;
+	const state = readState(statePath);
+	if (state.last_draft === row.meta["draft_id"])
+		writeFileSync(statePath, JSON.stringify({ ...state, slack_ts: row.ref }, null, 2));
+	outbox.complete(id);
+	return row;
+}
+
