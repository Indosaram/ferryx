+export type Generator = (prompt: string) => string;
+
+// The Ferryx Hub picks one model for every cron job (FERRYX_CRON_MODEL, provider/id).
+export function cronModel(specific?: string): string {
+  return (
+    process.env["FERRYX_CRON_MODEL"]?.trim() ||
+    (specific ? process.env[specific]?.trim() : "") ||
+    "mahoquot/gpt-6-luna"
+  );
+}
+
+// Bare completion through omo: no tools, no agent context; the prompt arrives on stdin.
+function omoComplete(
+  model: string,
+  prompt: string,
+): { exitCode: number; stdout: string; stderr: string } {
+  const result = Bun.spawnSync(
+    [
+      process.env["OMO_BIN"] ?? "/Users/indo/.bun/bin/omo",
+      "-p",
+      "--no-session",
+      "--model",
+      model,
+      "--no-tools",
+      "--no-extensions",
+      "--no-skills",
+      "--no-context-files",
+      "--system-prompt",
+      "Follow the instructions exactly. Output only what is asked.",
+      "-",
+    ],
+    { cwd: tmpdir(), stdin: new TextEncoder().encode(prompt), stdout: "pipe", stderr: "pipe" },
+  );
+  return {
+    exitCode: result.exitCode,
+    stderr: result.stderr.toString(),
+    stdout: result.stdout.toString(),
+  };
+}
+
+function omoGenerator(): Generator {
+  return (prompt) => {
+    const result = omoComplete(cronModel("X_GROWTH_MODEL"), prompt);
+    if (result.exitCode !== 0) throw new Error(`omo failed: ${result.stderr || result.stdout}`);
+    return result.stdout;
+  };
+}
+
+function parseJson(raw: string): {
+  post?: string;
+  replies?: { tweet_id?: string; text?: string }[];
+} {
+  const start = raw.indexOf("{");
+  const end = raw.lastIndexOf("}");
+  if (start < 0 || end < start) throw new Error("generator returned no JSON");
+  return JSON.parse(raw.slice(start, end + 1));
+}
+
+export function writeItems(
+  draftId: string,
+  facts: string,
+  recentPosts: readonly string[],
+  candidates: readonly Candidate[],
+  generate: Generator,
+): Item[] {
+  let feedback: string[] = [];
+  for (let attempt = 1; attempt <= MAX_ATTEMPTS; attempt += 1) {
+    try {
+      const out = parseJson(generate(buildPrompt(facts, recentPosts, candidates, feedback)));
+      const problems: string[] = [];
+      const post = (out.post ?? "").trim();
+      for (const p of copyProblems(post, facts)) problems.push(`post: ${p}`);
+      const replies: Item[] = [];
+      for (const r of (out.replies ?? []).slice(0, MAX_REPLIES)) {
+        const target = candidates.find((c) => c.id === r.tweet_id);
+        const text = (r.text ?? "").trim();
+        if (!target) {
+          problems.push(`reply targets unknown tweet_id ${r.tweet_id}`);
+          continue;
+        }
+        const rp = copyProblems(text, facts);
+        if (rp.length > 0) {
+          problems.push(...rp.map((p) => `reply to ${target.id}: ${p}`));
+          continue;
+        }
+        replies.push({
+          id: `${draftId}-r${replies.length + 1}`,
+          kind: "reply",
+          reply_to: target,
+          text,
+          token: itemToken(text, target.id),
+        });
+      }
+      if (problems.length === 0)
+        return [
+          { id: `${draftId}-p`, kind: "post", text: post, token: itemToken(post) },
+          ...replies,
+        ];
+      feedback = problems;
+    } catch (error) {
+      feedback = [error instanceof Error ? error.message : String(error)];
+    }
+  }
+  throw new Error(
+    `copy failed quality gates after ${MAX_ATTEMPTS} attempts: ${feedback.join("; ")}`,
+  );
+}
+
+export function itemToken(text: string, replyTo = ""): string {
+  return createHash("sha256").update(`${replyTo}\n\x00\n${text}`).digest("hex");
+}
+
+export function composeUrl(item: Item): string {
+  const reply = item.reply_to ? `&in_reply_to=${item.reply_to.id}` : "";
+  return `https://x.com/intent/post?text=${encodeURIComponent(item.text)}${reply}`;
+}
