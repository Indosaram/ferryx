+
+export const JEV_INSTRUCTIONS =
+  "You are a strict gate for an automated X reply from a solo developer who analyzed all 6,320 YC companies. Answer yes only if ALL hold: the reply directly engages with the original post's actual point; the data it cites is relevant to that point; it reads like a thoughtful human, not a bot or self-promotion; it is respectful and appropriate for the tone of the original (not a sensitive, personal, political or tragic post); it does not ask for follows or likes.";
+
+const jevJudge: Judge = (original, text) => {
+  const file = join(tmpdir(), `x-growth-jev-${process.pid}.txt`);
+  writeFileSync(
+    file,
+    original
+      ? `ORIGINAL POST by @${original.author}:\n${original.text}\n\nPROPOSED REPLY:\n${text}`
+      : `PROPOSED X POST:\n${text}`,
+  );
+  const r = Bun.spawnSync(
+    [
+      "typesafe-judge",
+      "noul",
+      "-q",
+      "--file",
+      file,
+      "--instructions",
+      original ? JEV_INSTRUCTIONS : JEV_POST_INSTRUCTIONS,
+    ],
+    {
+      cwd: join(import.meta.dir, ".."),
+      timeout: 60_000,
+    },
+  );
+  const score = Number.parseFloat(r.stdout.toString().trim());
+  if (Number.isNaN(score))
+    throw new Error(`Jev 판정 실패: ${(r.stdout.toString() + r.stderr.toString()).slice(0, 200)}`);
+  return score;
+};
+
+export type Review = {
+  ai_score: number;
+  verdict: "human" | "ai" | "unsure";
+  tells: string[];
+  rewrite: string;
+};
+export type Reviewer = (text: string, original: Candidate | undefined) => Review;
+export const MAX_HUMAN_AI_SCORE = 3;
+const MAX_REWRITES = 2;
+
+export function buildReviewPrompt(text: string, original: Candidate | undefined): string {
+  return [
+    `You are an expert editor who spots AI-written social media text. Review this X ${original ? "reply" : "post"} from a solo developer.`,
+    ...(original
+      ? [`ORIGINAL POST by @${original.author}: ${original.text.replace(/\n/g, " ")}`]
+      : []),
+    "TEXT:",
+    text,
+    "",
+    'Look for AI tells: tidy "X, which Y" clauses, parenthetical stat qualifiers, "so ... would be ..." inference lines, balanced setup-payoff structure, "not X, it\'s Y", em dashes, colon lists, hedge-then-precision, generic summary closers, words like landscape, crucial, notably, worth noting, the real, perfectly grammatical lowercase that still reads like a press line, and anything a real founder typing fast on a phone would not write.',
+    "Score 0 = clearly a human typed it, 10 = obviously generated.",
+    "The rewrite must keep only facts and numbers already in TEXT, add none, stay under 200 characters, use no hashtags, links, emoji, exclamation marks, slang like lol, or em dashes, and still make sense to the original author.",
+    'Return ONLY JSON: {"ai_score":0-10,"verdict":"human"|"ai"|"unsure","tells":["..."],"rewrite":"..."}',
+  ].join("\n");
+}
+
+const omoReviewer: Reviewer = (text, original) => {
+  const result = omoComplete(
+    cronModel("X_GROWTH_REVIEW_MODEL"),
+    buildReviewPrompt(text, original),
+  );
+  if (result.exitCode !== 0)
+    throw new Error(`AI 티 리뷰 실패: ${result.stderr.slice(0, 200)}`);
+  const raw = result.stdout;
+  const json = JSON.parse(raw.slice(raw.indexOf("{"), raw.lastIndexOf("}") + 1)) as Partial<Review>;
+  const score = Number(json.ai_score);
+  if (Number.isNaN(score)) throw new Error(`AI 티 리뷰 응답을 읽지 못함: ${raw.slice(0, 200)}`);
+  return {
+    ai_score: score,
+    rewrite: String(json.rewrite ?? "").trim(),
+    tells: (json.tells ?? []).map(String),
+    verdict: json.verdict === "human" || json.verdict === "ai" ? json.verdict : "unsure",
+  };
+};
+
+export type Humanized = { text: string; review: Review; rounds: number } | { failed: string };
+
+export function humanize(
+  text: string,
+  original: Candidate | undefined,
+  facts: string,
+  review: Reviewer,
+): Humanized {
+  let current = text;
+  for (let round = 0; round <= MAX_REWRITES; round += 1) {
+    const result = review(current, original);
+    if (result.ai_score <= MAX_HUMAN_AI_SCORE && result.verdict !== "ai")
+      return { review: result, rounds: round, text: current };
+    if (round === MAX_REWRITES || !result.rewrite)
+      return { failed: `AI 티 ${result.ai_score}/10 (${result.tells.slice(0, 2).join("; ")})` };
+    const problems = copyProblems(result.rewrite, facts);
+    if (problems.length > 0)
+      return { failed: `리라이트가 품질 게이트 탈락: ${problems.join("; ")}` };
+    current = result.rewrite;
+  }
+  return { failed: "리라이트 반복 초과" };
+}
+
+export type Decision = "auto" | "ask" | "drop";
+
+export function decide(kind: "post" | "reply", jev: number, review: Review): Decision {
+  const v = verdict(kind, jev);
+  if (v === "drop") return "drop";
+  if (v === "auto" && review.verdict === "human") return "auto";
+  return "ask";
+}
+
+async function slackPost(text: string, blocks: unknown[], item: Item): Promise<string> {
+  return ownerReport({ source: "x-growth", topic: "review:" + item.id, state: JSON.stringify(item),
+    salience: "decision", body: text, blocks: blocks as Record<string, unknown>[] });
+}
+
+function pick<T>(items: readonly T[], random: () => number = Math.random): T {
+  return items[Math.floor(random() * items.length)] as T;
+}
+
+export function askBlocks(item: Item, jev: number, review: Review): unknown[] {
+  return [
+    {
+      type: "section",
+      text: {
+        type: "mrkdwn",
+        text: `🤔 *판단 보류: 직접 결정해 주세요* (Jev ${jev.toFixed(2)}, AI 티 ${review.ai_score}/10 ${review.verdict})${review.tells.length > 0 ? `\n남은 지적: ${review.tells.slice(0, 2).join("; ")}` : ""}`,
+      },
+    },
+    ...(slackBlocks(item.id.replace(/-[a-z]\d*$/, ""), [item]) as unknown[]).slice(1),
+  ];
+}
+
+async function autoItem(
+  kind: "post" | "reply",
+  generate: Generator,
+  judge: Judge,
+  review: Reviewer,
+): Promise<string> {
+  const facts = readFileSync(FACTS_PATH, "utf8");
+  const history = readHistory();
+  const now = new Date();
+  const style = pick(REPLY_STYLES);
+  let target: Candidate | undefined;
+  let draft: string;
+  let query = "";
+  if (kind === "reply") {
+    query = `${pick(AUTO_SEARCHES)} min_faves:${pick(MIN_FAVES)}`;
+    const pool = eligible(searchCandidates([query], new Set(history.replied)), history, now)
+      .sort(() => Math.random() - 0.5)
+      .slice(0, 6);
+    if (pool.length === 0) return `후보 없음 (${query})`;
+    const raw = parseJson(generate(buildReplyPrompt(facts, pool, style))) as {
+      tweet_id?: string;
+      text?: string;
+      skip?: boolean;
+    };
+    if (raw.skip) return `생성기가 맞는 글이 없다고 판단 (${query})`;
+    target = pool.find((c) => c.id === raw.tweet_id);
+    if (!target) return `생성기가 후보 밖의 글을 골랐음: ${raw.tweet_id}`;
+    draft = (raw.text ?? "").trim();
+  } else {
+    const recent = [...PUBLISHED_POSTS, ...history.posts.slice(-10)];
+    const items = writeItems(kstStamp(now), facts, recent, [], generate);
+    draft = items[0]?.text ?? "";
+  }
+  const problems = copyProblems(draft, facts);
+  if (problems.length > 0) return `품질 게이트 탈락: ${problems.join("; ")}`;
+  const human = humanize(draft, target, facts, review);
+  if ("failed" in human) return `AI 티 리뷰 탈락으로 버림: ${human.failed}`;
+  const jev = judge(target, human.text);
+  const decision = decide(kind, jev, human.review);
+  const draftId = kstStamp(now);
+  const item: Item = {
+    id: `${draftId}-${kind === "post" ? "p" : "a"}`,
+    kind,
+    ...(target ? { reply_to: target } : {}),
+    text: human.text,
+    token: itemToken(human.text, target?.id ?? ""),
+  };
+  const dir = join(DIR, draftId);
+  mkdirSync(dir, { recursive: true });
+  writeFileSync(
+    join(dir, "draft.json"),
+    JSON.stringify(
+      {
+        decision,
+        first_draft: draft,
+        items: [item],
+        jev,
+        query,
+        review: human.review,
+        rounds: human.rounds,
+        style,
+      },
+      null,
+      2,
+    ),
+  );
+  const summary = `Jev ${jev.toFixed(2)}, AI 티 ${human.review.ai_score}/10, 리라이트 ${human.rounds}회`;
+  if (decision === "drop") return `게시 안 함 (${summary})`;
+  if (decision === "ask") {
+    const delivery = await slackPost(
+      `판단 보류: ${kind === "post" ? "새 글" : `@${target?.author} 답글`}`,
+      askBlocks(item, jev, human.review),
+      item,
+    );
+    return `판단 보류: ${delivery} (${summary})`;
+  }
+  if (target) {
+    const before = readHistory();
+    before.authors[target.author.toLowerCase()] = now.toISOString();
+    saveHistory(before);
+  }
+  return `${publish(item, "auto:jev+review")} (${summary})`;
+}
+
+async function runTick(
+  generate: Generator = omoGenerator(),
+  judge: Judge = jevJudge,
+  review: Reviewer = omoReviewer,
+): Promise<number> {
+  const now = new Date();
+  let plan = readPlan();
+  if (!plan || plan.date !== kstDate(now)) {
+    plan = makePlan(kstDate(now));
+    savePlan(plan);
+    console.log(`오늘 계획: ${plan.slots.map((s) => `${s.kind}@${s.at}`).join(", ") || "없음"}`);
+  }
+  const due = dueSlot(plan, now);
+  if (!due) {
+    console.log("지금 예정된 답글 없음");
+    return 0;
+  }
+  const slot = plan.slots[due.index];
+  if (!slot) return 0;
+  if (due.stale) {
+    slot.status = "skipped";
+    slot.note = "예정 시각을 3시간 넘겨 건너뜀";
+    savePlan(plan);
+    console.log(slot.note);
+    return 0;
+  }
+  slot.status = "running";
+  savePlan(plan);
+  Bun.sleepSync(Math.floor(Math.random() * MAX_JITTER_MS));
+  try {
+    slot.note = await autoItem(slot.kind ?? "reply", generate, judge, review);
+    slot.status = "done";
+  } catch (error) {
+    slot.note = error instanceof Error ? error.message : String(error);
+    slot.status = "done";
+    savePlan(plan);
+    throw error;
+  }
+  savePlan(plan);
+  console.log(slot.note);
+  return 0;
+}
+
+async function runAction(action: string, itemId: string, token: string): Promise<number> {
+  const by = authorized();
+  const item = loadItem(itemId, token);
+  if (action === "pass") {
+    const history = readHistory();
+    history.passed[item.id] = { at: new Date().toISOString(), by };
+    if (item.reply_to) history.replied.push(item.reply_to.id);
+    saveHistory(history);
+    console.log(`${item.id}을(를) 패스했습니다.`);
+    return 0;
+  }
+  if (action === "preview") {
+    const tabId = openTab(composeUrl(item));
+    console.log(`🔍 Maho 탭 ${tabId}에 작성창을 열었습니다. 게시는 하지 않았습니다.`);
+    return 0;
+  }
+  if (action === "publish") {
+    console.log(publish(item, by));
+    return 0;
+  }
+  if (action === "delete") {
+    console.log(deleteTweet(item));
+    return 0;
+  }
+  throw new Error(`알 수 없는 동작: ${action}`);
+}
+
+if (import.meta.main) {
+  const [action = "", id = "", token = ""] = process.argv.slice(2);
+  try {
+    await ownerReport();
+    process.exitCode =
+      action === "draft"
+        ? await runDraft()
+        : action === "tick"
+          ? await runTick()
+          : await runAction(action, id, token);
+  } catch (error) {
+    console.error(`⚠️ ${error instanceof Error ? error.message : String(error)}`);
+    process.exitCode = 1;
+  }
+}
