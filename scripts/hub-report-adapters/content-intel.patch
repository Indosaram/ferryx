-export function copyProblems(text: string, facts: string): string[] {
-  const problems: string[] = [];
-  const length = [...text].length;
-  if (length > X_LIMIT) problems.push(`${length} chars (max ${X_LIMIT})`);
-  if (/#[\p{L}\d_]+/u.test(text)) problems.push("contains a hashtag");
-  if (/!/.test(text)) problems.push("contains an exclamation mark");
-  if (/[\u3131-\uD79D]/.test(text)) problems.push("X copy must be English only");
-  if (/https?:\/\//.test(text)) problems.push("no links in the copy");
-  const bad = ungroundedNumbers(text, facts);
-  if (bad.length > 0) problems.push(`numbers not in the fact bank: ${bad.join(", ")}`);
-  return problems;
