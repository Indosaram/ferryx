-export function writeItems(
-  draftId: string,
-  facts: string,
-  recentPosts: readonly string[],
-  candidates: readonly Candidate[],
-  generate: Generator,
-): Item[] {
-  let feedback: string[] = [];
-  for (let attempt = 1; attempt <= MAX_ATTEMPTS; attempt += 1) {
-    try {
-      const out = parseJson(generate(buildPrompt(facts, recentPosts, candidates, feedback)));
-      const problems: string[] = [];
-      const post = (out.post ?? "").trim();
-      for (const p of copyProblems(post, facts)) problems.push(`post: ${p}`);
-      const replies: Item[] = [];
-      for (const r of (out.replies ?? []).slice(0, MAX_REPLIES)) {
-        const target = candidates.find((c) => c.id === r.tweet_id);
-        const text = (r.text ?? "").trim();
-        if (!target) {
-          problems.push(`reply targets unknown tweet_id ${r.tweet_id}`);
-          continue;
-        }
-        const rp = copyProblems(text, facts);
-        if (rp.length > 0) {
-          problems.push(...rp.map((p) => `reply to ${target.id}: ${p}`));
-          continue;
-        }
-        replies.push({
-          id: `${draftId}-r${replies.length + 1}`,
-          kind: "reply",
-          reply_to: target,
-          text,
-          token: itemToken(text, target.id),
-        });
-      }
-      if (problems.length === 0)
-        return [
-          { id: `${draftId}-p`, kind: "post", text: post, token: itemToken(post) },
-          ...replies,
-        ];
-      feedback = problems;
-    } catch (error) {
-      feedback = [error instanceof Error ? error.message : String(error)];
-    }
-  }
-  throw new Error(
-    `copy failed quality gates after ${MAX_ATTEMPTS} attempts: ${feedback.join("; ")}`,
-  );
-}
