+async function freemoa() {
+  let judged = 0;
+  for (const p of await FM.listProjects()) {
+    const id = `freemoa_project:${p.pno}:1`;
+    if (S.get(id)) continue;
+    if (judged >= FREEMOA_PER_RUN) break;
+    let { text, loggedIn, applied } = await FM.projectText(p.pno);
+    if (!loggedIn) {
+      const r = await FM.ensureLogin();
+      if (r === "PASSKEY_REQUIRED") throw new AuthRequiredError("프리모아 로그인이 풀려 다시 로그인하는데 구글 패스키 확인이 필요합니다. Aside에 떠 있는 구글 본인 확인(indoyoon93)만 승인해 주세요. 다음 수집부터 자동으로 이어집니다.");
