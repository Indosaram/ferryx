+#!/usr/bin/env bun
+import { join } from "node:path";
+import { mkdirSync } from "node:fs";
+import * as S from "./state.ts";
+import { ask } from "./llm.ts";
+import { postCard, postText, saveCard } from "./slack.ts";
+
+// The Ferryx Hub picks one model for every cron job (FERRYX_CRON_MODEL, provider/id).
+const MODEL = process.env.FERRYX_CRON_MODEL?.trim() || process.env.AUTOPILOT_DEV_MODEL?.trim() || "mahoquot/gpt-6-luna";
+const [itemId] = process.argv.slice(2);
+const item = itemId ? S.get(itemId) : null;
+if (!item) { console.error(`unknown item ${itemId}`); process.exit(2); }
+
+const dir = join(S.HOME, "orders", item.external_id);
+const work = join(dir, "work");
+mkdirSync(work, { recursive: true });
+await Bun.write(join(dir, "REQUIREMENTS.md"), `# 주문 #${item.external_id}\n\n## 주문 원문\n${item.body}\n\n## 판정\n${item.verdict}\n`);
+
+const prompt = `TASK: ${join(dir, "REQUIREMENTS.md")} 의 크몽 주문을 이 디렉터리(${work})에서 끝까지 구현하라.
+DELIVERABLE: 동작하는 소스, 실행 방법이 담긴 README.md, 그리고 ${join(work, "DELIVERY.md")} (구현 범위, 실행·테스트 결과 원문, 남은 한계).
+VERIFY: 직접 빌드·실행·테스트하고 그 출력 원문을 DELIVERY.md에 붙여라. 실행해 보지 않은 것은 '미검증'으로 적어라.
+STOP WHEN: DELIVERY.md가 쓰이고 테스트가 통과하면 즉시 멈춰라. 외부로 아무것도 보내지 마라.`;
+
+const log = Bun.file(join(dir, "develop.log"));
+const proc = Bun.spawn(["omo", "-p", "--no-session", "--model", MODEL, prompt], { cwd: work, stdout: log, stderr: log, env: process.env });
+const code = await proc.exited;
+const delivery = Bun.file(join(work, "DELIVERY.md"));
+if (code !== 0 || !(await delivery.exists())) {
+  S.update(item.id, { status: "failed", result: `develop exit ${code}` });
+  await postText(`주문 #${item.external_id} AI 개발 실패 (exit ${code}). 로그: ${join(dir, "develop.log")}`, { topic: `autopilot:item:${item.id}:develop`, state: `exit:${code}`, salience: "action" });
+  process.exit(1);
+}
+
+const zip = join(dir, `delivery-${item.external_id}.zip`);
+const z = Bun.spawn(["zip", "-qr", zip, ".", "-x", "node_modules/*", ".git/*", "target/*"], { cwd: work });
+if ((await z.exited) !== 0) { await postText(`주문 #${item.external_id} 압축 실패`, { topic: `autopilot:item:${item.id}:develop`, state: "zip_failed", salience: "action" }); process.exit(1); }
+
+const report = await delivery.text();
+const summary = await ask("한국어로 3줄 이내 요약. 과장 금지.", `납품 보고서:\n${report.slice(0, 8000)}`).catch(() => report.slice(0, 600));
+S.update(item.id, { status: "pending_approval", result: zip, draft: zip });
+const mid = await postCard(`크몽 납품 승인 · 주문 #${item.external_id}`, [
+  ["AI 개발 결과", summary], ["납품 파일", zip], ["보고서", join(work, "DELIVERY.md")],
+], item.url, S.shortId(item.id), [
+  { label: "승인·작업물 발송", action: "deliver", style: "primary" }, { label: "보류", action: "reject", style: "danger" },
+], item.id);
+saveCard(item.id, mid);
