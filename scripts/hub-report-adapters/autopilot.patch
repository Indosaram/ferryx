+    if (value.outbox_id !== id) throw new GateError("protocol", "Receipt belongs to another outbox row");
+    switch (value.delivery) {
+      case "pending": return { kind: "pending", outboxId: id };
+      case "cancelled": return { kind: "suppressed", reason: "cancelled" };
+      case "delivered": {
+        if (typeof value.channel !== "string" || !value.channel.trim()
+          || typeof value.ts !== "string" || !value.ts.trim())
+          throw new GateError("protocol", "Delivered report has no Slack receipt");
+        return { kind: "delivered", outboxId: id, ref: `${value.channel}:${value.ts}` };
+      }
+      default: throw new GateError("protocol", "Unknown delivery state");
+    }
+  }
+
+  async submit(report: Report): Promise<Delivery> {
+    const value = reply(await this.transport({ op: "report", ...report }), "report");
+    switch (value.decision) {
+      case "sent": return this.status(positiveId(value.outbox_id));
+      case "duplicate":
+        return value.outbox_id === null ? { kind: "suppressed", reason: "duplicate" }
+          : this.status(positiveId(value.outbox_id));
+      case "digest":
+        return value.outbox_id === null ? { kind: "suppressed", reason: "digest" }
+          : this.status(positiveId(value.outbox_id));
+      case "muted": case "internal": case "empty": case "stale":
+        return { kind: "suppressed", reason: value.decision };
+      default: throw new GateError("protocol", "Unknown gate decision");
+    }
+  }
+}
diff --git a/src/report-outbox.ts b/src/report-outbox.ts
new file mode 100644
--- /dev/null
+++ b/src/report-outbox.ts
@@ -0,0 +1,84 @@
+import { Database } from "bun:sqlite";
+import { createHash } from "node:crypto";
+import { GateError, ReportGate, type Delivery, type Report } from "./report-gate.ts";
+
+export type StoredDelivery = Delivery | { readonly kind: "queued"; readonly localId: string };
+export class ReportOutbox {
+  constructor(private readonly db: Database, private readonly gate: ReportGate) {
+    db.exec(`CREATE TABLE IF NOT EXISTS report_outbox (
+      id TEXT PRIMARY KEY, request TEXT NOT NULL, item_id TEXT, approval INTEGER NOT NULL,
+      ref TEXT, state TEXT NOT NULL DEFAULT 'pending', reason TEXT)`);
+  }
+
+  async enqueue(report: Report, itemId: string | null = null, approval = false): Promise<StoredDelivery> {
+    const id = createHash("sha256").update(JSON.stringify([report.source, report.topic, report.state])).digest("hex");
+    this.db.transaction(() => {
+      const inserted = this.db.query("INSERT OR IGNORE INTO report_outbox(id,request,item_id,approval) VALUES(?,?,?,?)")
+        .run(id, JSON.stringify(report), itemId, approval ? 1 : 0);
+      if (inserted.changes && approval && itemId) {
+        this.db.query("UPDATE items SET status='pending_approval',chat_ref=?,updated_at=? WHERE id=?")
+          .run(`report:${id}`, new Date().toISOString(), itemId);
+      }
+    })();
+    return this.deliver(id);
+  }
+
+  async deliver(id: string): Promise<StoredDelivery> {
+    const row = this.db.query<{ request: string; item_id: string | null; approval: number; ref: string | null; state: string; reason: string | null }, [string]>(
+      "SELECT request,item_id,approval,ref,state,reason FROM report_outbox WHERE id = ?").get(id);
+    if (!row) throw new GateError("protocol", "Unknown local report");
+    if (row.state === "suppressed") return { kind: "suppressed", reason: row.reason ?? "suppressed" };
+    if (row.state === "delivered" && row.ref) {
+      // The receipt is already durable; no new admission or network call is needed.
+      return { kind: "delivered", outboxId: Number(row.reason), ref: row.ref };
+    }
+    let delivery: Delivery;
+    try {
+      const report: Report = JSON.parse(row.request);
+      delivery = row.ref?.startsWith("outbox:")
+        ? await this.gate.status(Number(row.ref.slice(7))) : await this.gate.submit(report);
+    } catch (error) {
+      if (!(error instanceof GateError) || error.code !== "unavailable") throw error;
+      return { kind: "queued", localId: id };
+    }
+    const ref = delivery.kind === "delivered" ? delivery.ref
+      : delivery.kind === "pending" ? `outbox:${delivery.outboxId}` : null;
+    const reason = delivery.kind === "suppressed" ? delivery.reason
+      : delivery.kind === "delivered" ? String(delivery.outboxId) : null;
+    this.db.transaction(() => {
+      this.db.query("UPDATE report_outbox SET state=?,ref=?,reason=? WHERE id=?")
+        .run(delivery.kind, ref, reason, id);
+      if (row.approval && row.item_id) {
+        // A superseded draft must never overwrite the new card or reopen an executed item.
+        this.db.query(`UPDATE items SET chat_ref=?,status=?,updated_at=? WHERE id=?
+          AND status IN ('new','pending_approval') AND (chat_ref=? OR chat_ref=? OR (chat_ref IS NULL AND status='new'))`)
+          .run(ref ?? null, delivery.kind === "suppressed" ? "skipped" : "pending_approval",
+            new Date().toISOString(), row.item_id, `report:${id}`, row.ref);
+      }
+    })();
+    return delivery;
+  }
+
+  async flush(): Promise<void> {
+    const rows = this.db.query<{ id: string }, []>("SELECT id FROM report_outbox WHERE state='pending' ORDER BY rowid").all();
+    for (const row of rows) {
+      try {
+        await this.deliver(row.id);
+      } catch (error) {
+        if (!(error instanceof GateError)) throw error;
+        this.db.query("UPDATE report_outbox SET state='failed',reason=? WHERE id=?")
+          .run(`${error.code}: ${error.message}`, row.id);
+        console.error(`Report ${row.id} requires repair: ${error.message}`);
+      }
+    }
+  }
+}
+
+export function reference(delivery: StoredDelivery): string | null {
+  switch (delivery.kind) {
+    case "queued": return `report:${delivery.localId}`;
+    case "pending": return `outbox:${delivery.outboxId}`;
+    case "delivered": return delivery.ref;
+    case "suppressed": return null;
+  }
+}
diff --git a/src/report-card.test.ts b/src/report-card.test.ts
new file mode 100644
--- /dev/null
+++ b/src/report-card.test.ts
@@ -0,0 +1,63 @@
+import { expect, test } from "bun:test";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { GateError, ReportGate } from "./report-gate.ts";
+
+const change = { kind: "restore_actions" };
+const answer = (extra: Record<string, unknown>) => new ReportGate(async () => ({
+  status: "ok", op: "report_mutate", outbox_id: 7, mutation_id: "m1", ...extra }));
+
+test("superseded is a terminal mutation state; progress belongs only to the caller's identity", async () => {
+  expect(await answer({ delivery: "superseded" }).mutate(7, "m1", change)).toBe("superseded");
+  expect(await answer({ delivery: "pending", progress: "recovering", blocked_by: "m1" }).mutate(7, "m1", change)).toBe("recovering");
+  expect(await answer({ delivery: "pending", blocked_by: "m0" }).mutate(7, "m1", change)).toBe("pending");
+  await expect(answer({ delivery: "pending", progress: "in_flight", blocked_by: "m0" }).mutate(7, "m1", change)).rejects.toBeInstanceOf(GateError);
+  await expect(answer({ delivery: "sent" }).mutate(7, "m1", change)).rejects.toThrow(/Unknown mutation state/);
+});
+
+test("an unsettled card edit never blocks the newer desired card and is never called delivered", async () => {
+  const root = mkdtempSync(join(tmpdir(), "autopilot-card-"));
+  process.env.AUTOPILOT_HOME = join(root, "home");
+  process.env.FERRYX_HUB_CONTROL_SOCKET = join(root, "hub.sock");
+  // The hub's receipt per identity; an unknown identity is admitted as plain pending.
+  const receipts = new Map<string, Record<string, unknown>>();
+  const seen: string[] = [];
+  const server = Bun.listen<{ input: string }>({ unix: process.env.FERRYX_HUB_CONTROL_SOCKET, socket: {
+    open(socket) { socket.data = { input: "" }; },
+    data(socket, bytes) {
+      socket.data.input += Buffer.from(bytes).toString();
+      if (!socket.data.input.includes("\n")) return;
+      const request = JSON.parse(socket.data.input);
+      seen.push(request.mutation_id);
+      socket.end(JSON.stringify({ status: "ok", op: "report_mutate", outbox_id: request.outbox_id,
+        mutation_id: request.mutation_id, delivery: "pending", ...receipts.get(request.mutation_id) }) + "\n");
+    },
+  } });
+  const S = await import("./state.ts");
+  const slack = await import("./slack.ts");
+  const intents = () => S.db.query<{ mutation_id: string; state: string; detail: string | null }, []>(
+    "SELECT mutation_id,state,detail FROM report_card_intents ORDER BY seq").all();
+  try {
+    S.db.query("INSERT INTO report_outbox(id,request,item_id,approval,ref,state,reason) VALUES('parent','{}',NULL,1,'D1:100.1','delivered','42')").run();
+    await slack.markProcessing("D1:100.1", "bid");
+    const [older] = intents().map((intent) => intent.mutation_id);
+    receipts.set(older!, { progress: "recovering", blocked_by: older });
+    await slack.restoreButtons("D1:100.1");
+    const newer = intents()[1]!.mutation_id;
+    expect(seen).toEqual([older, older, newer]);
+    expect(intents()).toEqual([
+      { mutation_id: older!, state: "pending", detail: "recovering" },
+      { mutation_id: newer, state: "pending", detail: "pending" },
+    ]);
+    receipts.set(older!, { delivery: "superseded" });
+    receipts.set(newer, { delivery: "delivered" });
+    await slack.flushReports();
+    expect(seen.slice(3)).toEqual([older, newer]);
+    expect(intents().map((intent) => intent.state)).toEqual(["superseded", "delivered"]);
+  } finally {
+    server.stop(true);
+    S.db.close();
+    rmSync(root, { force: true, recursive: true });
+  }
+});
