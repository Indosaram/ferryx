+
+// Unanswered approval cards for public listings go stale (the listing closes or fills); close them so the
+// owner's DM only shows cards that can still be acted on.
+const PENDING_TTL_MS = Number(process.env.AUTOPILOT_PENDING_TTL_H ?? 72) * 3600_000;
+async function expireStale() {
+  for (const item of S.listByStatus("pending_approval")) {
+    if (!/_project$/.test(item.kind) || Date.now() - Date.parse(item.created_at) < PENDING_TTL_MS) continue;
+    if (DRY) { console.log(`[dry] expire ${item.id}`); continue; }
+    S.update(item.id, { status: "rejected", result: "expired" });
+    S.log(item.id, "expire", `pending since ${item.created_at}`);
