+import { homedir } from "node:os";
+import { createHash } from "node:crypto";
+import * as S from "./state.ts";
+import { GateError, ReportGate, socketTransport, type MutationState, type Report } from "./report-gate.ts";
+import { ReportOutbox, type StoredDelivery } from "./report-outbox.ts";
+const gate = new ReportGate(socketTransport(process.env.FERRYX_HUB_CONTROL_SOCKET ?? `${homedir()}/.ferryx/hub/control.sock`));
+const outbox = new ReportOutbox(S.db, gate);
+// Card edits are durable intents: ordered per card, one identity across retries and restarts.
+// Legacy cards (no hub-owned parent receipt) keep their intents as 'legacy', in order, for later adoption.
+S.db.exec(`CREATE TABLE IF NOT EXISTS report_card_intents (seq INTEGER PRIMARY KEY AUTOINCREMENT,
+  card TEXT NOT NULL, item_id TEXT, change_json TEXT NOT NULL, mutation_id TEXT NOT NULL UNIQUE,
+  state TEXT NOT NULL DEFAULT 'pending', detail TEXT)`);
+export async function flushReports(): Promise<void> {
+  await outbox.flush();
+  const cards = S.db.query<{ card: string }, []>("SELECT card FROM report_card_intents WHERE state IN ('pending','legacy') GROUP BY card ORDER BY MIN(seq)").all();
+  for (const { card } of cards) await drainCard(card);
+}
+const stateHash = (value: unknown) => createHash("sha256").update(JSON.stringify(value)).digest("hex");
+export async function resolveRef(ref: string): Promise<string | null> {
+  try {
+    if (ref.startsWith("report:")) {
+      const result = await outbox.deliver(ref.slice(7));
+      return result.kind === "delivered" ? result.ref : null;
+    }
+    if (ref.startsWith("outbox:")) {
+      const result = await gate.status(Number(ref.slice(7)));
+      return result.kind === "delivered" ? result.ref : null;
+    }
+    return ref;
+  } catch (error) {
+    if (!(error instanceof GateError)) throw error;
+    S.log(null, "report:reference-unavailable", error.message);
+    return null;
+  }
+}
+
+export const CHANNEL = process.env.AUTOPILOT_SLACK_CHANNEL ?? "U04M1JNJM8T";
+export const NAMESPACE = "autopilot";
+
+// Raw Slack refs map to their hub-owned card unless intents already live under the raw ref (legacy).
+function cardKey(ref: string): string {
+  if (ref.startsWith("report:") || S.db.query("SELECT 1 FROM report_card_intents WHERE card=? LIMIT 1").get(ref)) return ref;
+  const owner = S.db.query<{ id: string }, [string]>("SELECT id FROM report_outbox WHERE ref=? AND approval=1 ORDER BY rowid DESC LIMIT 1").get(ref);
+  return owner ? `report:${owner.id}` : ref;
+}
+
+// Persisted before reference resolution or any hub call; an identical unsent tail is the same edit.
+function queueCardIntent(chatRef: string, change: Record<string, unknown>): string {
+  const card = cardKey(chatRef);
+  const encoded = JSON.stringify(change);
+  S.db.transaction(() => {
+    const tail = S.db.query<{ change_json: string; state: string }, [string]>(
+      "SELECT change_json,state FROM report_card_intents WHERE card=? ORDER BY seq DESC LIMIT 1").get(card);
+    if ((tail?.state === "pending" || tail?.state === "legacy") && tail.change_json === encoded) return;
+    const item = S.db.query<{ id: string }, [string, string]>("SELECT id FROM items WHERE chat_ref IN (?,?) ORDER BY rowid DESC LIMIT 1").get(chatRef, card);
+    S.db.query("INSERT INTO report_card_intents(card,item_id,change_json,mutation_id) VALUES(?,?,?,?)").run(card, item?.id ?? null, encoded, crypto.randomUUID());
+  })();
+  return card;
+}
+
+// Pending stays retryable under its identity and never blocks a newer desired card; uncertain or failed
+// blocks later edits and is never replayed; legacy holds the queue.
+async function drainCard(card: string): Promise<void> {
+  const open = S.db.query<{ seq: number; change_json: string; mutation_id: string; state: string }, [string]>(
+    "SELECT seq,change_json,mutation_id,state FROM report_card_intents WHERE card=? AND state IN ('pending','legacy','uncertain','failed') ORDER BY seq").all(card);
+  const head = open[0];
+  if (!head) return;
+  if (head.state === "legacy") {
+    holdLegacy(card);
+    const item = S.db.query<{ item_id: string | null }, [string]>("SELECT item_id FROM report_card_intents WHERE card=? AND item_id IS NOT NULL ORDER BY seq LIMIT 1").get(card);
+    if (!item?.item_id) return;
+    const split = card.indexOf(":");
+    if (split < 1) throw new GateError("protocol", "Legacy card has no Slack receipt");
+    let adopted: number | null;
+    try { adopted = await gate.adopt(card.slice(0, split), card.slice(split + 1), "autopilot", `autopilot:item:${item.item_id}`); }
+    catch (error) { S.log(item.item_id, "report:adoption-failed", String(error)); return; }
+    if (adopted === null) return;
+    S.db.transaction(() => {
+      S.db.query("INSERT OR IGNORE INTO report_outbox(id,request,item_id,approval,ref,state,reason) VALUES(?,'{}',?,1,?,'delivered',?)").run(`adopt:${card}`, item.item_id, card, String(adopted));
+      S.db.query("UPDATE report_card_intents SET state='pending',detail=NULL WHERE card=? AND state='legacy'").run(card);
+    })();
+    return drainCard(card);
+  }
+  if (head.state !== "pending") {
+    S.log(null, "report:card-blocked", `${card} waits behind ${head.state} edit ${head.mutation_id}`);
+    return;
+  }
+  const resolved = await resolveRef(card);
+  if (resolved === null) {
+    if (card.startsWith("report:") && S.db.query("SELECT 1 FROM report_outbox WHERE id=? AND state='suppressed'").get(card.slice(7)))
+      S.db.query("UPDATE report_card_intents SET state='suppressed',detail='parent suppressed' WHERE card=? AND state='pending'").run(card);
+    return;
+  }
+  const parent = S.db.query<{ reason: string }, [string, string]>(
+    "SELECT reason FROM report_outbox WHERE (id=? OR ref=?) AND state='delivered' AND approval=1 ORDER BY rowid DESC LIMIT 1")
+    .get(card.startsWith("report:") ? card.slice(7) : "", resolved);
+  if (!parent) { holdLegacy(card); return; }
+  for (const intent of open) {
+    if (intent.state !== "pending") return;
+    let state: MutationState;
+    try {
+      state = await gate.mutate(Number(parent.reason), intent.mutation_id, JSON.parse(intent.change_json));
+    } catch (error) {
+      if (!(error instanceof GateError)) throw error;
+      if (error.code === "unavailable") return;
+      S.db.query("UPDATE report_card_intents SET state='failed',detail=? WHERE seq=? AND state='pending'").run(`${error.code}: ${error.message}`, intent.seq);
+      S.log(null, "report:card-failed", `${intent.mutation_id}: ${error.message}`);
+      return;
+    }
+    // Admission or hub progress is not delivery: the intent stays pending and is re-queried next run, while
+    // the newer desired card is still submitted. Submission in seq order fixes the hub's card generations.
+    if (state === "pending" || state === "in_flight" || state === "recovering") {
+      S.db.query("UPDATE report_card_intents SET detail=? WHERE seq=? AND state='pending'").run(state, intent.seq);
+      continue;
+    }
+    // A late receipt (delivered, suppressed, superseded) may settle an intent another run saw as uncertain.
+    S.db.query("UPDATE report_card_intents SET state=?,detail=NULL WHERE seq=? AND (state='pending' OR (state='uncertain' AND ?<>'uncertain'))")
+      .run(state, intent.seq, state);
+    if (state === "uncertain") { S.log(null, "report:card-uncertain", `${intent.mutation_id} not replayed`); return; }
+  }
+}
+
+// Adoption is unresolved: nothing is sent and no receipt is invented; adoption later returns 'legacy' rows to 'pending'.
+function holdLegacy(card: string): void {
+  const held = S.db.query("UPDATE report_card_intents SET state='legacy',detail='no hub-owned parent receipt' WHERE card=? AND state='pending'").run(card).changes;
+  if (held) S.log(null, "report:legacy-card", "Card update withheld: no hub-owned parent receipt");
+}
+
+async function mutateCard(chatRef: string, change: Record<string, unknown>): Promise<void> {
+  await drainCard(queueCardIntent(chatRef, change));
+}
+
+export async function reportOnCard(chatRef: string, text: string, closeLabel: string | null, itemId: string, action: string, failed: boolean, outcomeCode: string): Promise<void> {
+  const card = closeLabel ? queueCardIntent(chatRef, { kind: "action_row", row: { type: "context", elements: [{ type: "mrkdwn", text: closeLabel }] } }) : null;
+  const resolved = await resolveRef(chatRef);
+  await outbox.enqueue({ source: "autopilot", topic: `autopilot:item:${itemId}:result`,
+    salience: failed ? "action" : "result", body: text,
+    state: stateHash([action, failed, outcomeCode]), ...(resolved ? { thread: resolved.split(":")[1] } : {}) });
+  if (card) await drainCard(card);
+}
+
+export async function markProcessing(chatRef: string, label: string): Promise<void> {
+  await mutateCard(chatRef, { kind: "action_row", row: { type: "context", block_id: "autopilot-status", elements: [{ type: "mrkdwn", text: label + " 처리 중" }] } });
+}
+
+export async function restoreButtons(chatRef: string): Promise<void> {
+  await mutateCard(chatRef, { kind: "restore_actions" });
+}
+
+
+export type Button = { label: string; action: string; style?: "primary" | "danger" };
+const clip = (s: string, n: number) => (s.length <= n ? s : s.slice(0, n - 1) + "…");
+
+export async function postCard(title: string, fields: [string, string][], url: string, shortId: string, buttons: Button[], itemId: string): Promise<StoredDelivery> {
+  const header = `*<${url}|${clip(title, 200)}>*  ·  autopilot #${shortId}`;
+  const blocks = [
+    { type: "section", text: { type: "mrkdwn", text: header } },
+    ...fields.map(([name, value]) => ({ type: "section", text: { type: "mrkdwn", text: clip(`*${name}*\n${value || "-"}`, 2900) } })),
+    {
+      type: "actions",
+      elements: buttons.map((b) => {
+        const id = `omon:btn:${NAMESPACE}:${b.action}:${shortId}`;
+        return { type: "button", text: { type: "plain_text", text: b.label }, action_id: id, value: id, ...(b.style ? { style: b.style } : {}) };
+      }),
+    },
+  ];
+  return outbox.enqueue({ source: "autopilot", topic: `autopilot:item:${itemId}`,
+    salience: "decision", body: "외주 작업 승인이 필요합니다.", quote: title, origin: url,
+    state: stateHash([fields, buttons]), blocks }, itemId, true);
+}
+
+export async function postText(text: string, identity: Pick<Report, "topic" | "state" | "salience" | "incident">): Promise<void> {
+  await outbox.enqueue({ source: "autopilot", body: text, ...identity });
+}
+
+export function saveCard(itemId: string, delivery: StoredDelivery): void {
+  if (delivery.kind === "suppressed") S.log(itemId, "report:suppressed", delivery.reason);
+}
