+    { label: "승인·지원", action: "apply", style: "primary" }, { label: "다시 쓰기", action: "redo" }, { label: "패스", action: "reject", style: "danger" },
+  ]);
+}
+
+async function mercor() {
+  let judged = 0;
+  for (const p of await M.listProjects()) {
+    const id = `mercor_project:${p.id}:1`;
+    const existing = S.get(id);
+    if (existing && existing.status !== "new") continue;
+    if (judged >= MERCOR_PER_RUN) break;
+    judged++;
+    const rate = `$${p.rateMin}~$${p.rateMax} / ${p.payRateFrequency} · ${p.commitment} · 남은 슬롯: ${p.remainingSlots ?? "상시"}`;
+    if (!existing) {
+      S.upsertNew({
+        id, kind: "mercor_project", external_id: p.id, url: p.url,
+        title: p.title.slice(0, 120), body: `${p.title}\n${rate}\n\n${p.description.slice(0, 5000)}`,
+      });
+    }
+    await draftMercorApplication(S.get(id)!);
+  }
+}
+
+if (import.meta.main) {
+  if (!DRY) await flushReports();
+  const steps: [string, () => Promise<void>][] = [["expire", expireStale], ["kmong-messages", kmongMessages], ["kmong-orders", kmongOrders], ["wishket", wishket], ["freelancer", freelancer], ["freemoa", freemoa], ["fiverr", fiverr]];
+  const failures: StepFailure[] = [];
+  for (const [name, fn] of steps) {
+    if (ONLY && ONLY !== name) continue;
+    try { await fn(); } catch (e) {
+      failures.push({ step: name, error: e });
+      S.log(null, "error", `${name}: ${(e as Error).stack}`);
+    }
+  }
+  const noticeFile = `${S.HOME}/auth-notice.json`;
+  const outcome = decide(failures, loadNoticeState(noticeFile));
+  saveNoticeState(noticeFile, outcome.state);
+  if (outcome.notices.length) console.log(outcome.notices.join("\n"));
+  for (const { step, error } of outcome.errors) {
+    if (!(error instanceof TransientAsideError)) transientOnly = false;
+    errors.push(`${step}: ${(error as Error).message}`);
+  }
+  const outageFlag = Bun.file(`${S.HOME}/outage-since`);
+  if (errors.length && transientOnly) {
+    const since = (await outageFlag.exists()) ? Date.parse(await outageFlag.text()) : Date.now();
+    if (!(await outageFlag.exists())) await Bun.write(outageFlag, new Date(since).toISOString());
+    if (Date.now() - since < OUTAGE_GRACE_MS) {
+      console.log(`transient network/Aside outage since ${new Date(since).toISOString()}; next run retries\n${errors.join("\n")}`);
+      process.exit(0);
+    }
+  } else {
+    await outageFlag.delete().catch(() => {});
+  }
+  if (errors.length) {
+    if (!DRY) await postText(`외주 수집을 완료하지 못했습니다. 실패한 수집 단계: ${[...new Set(outcome.errors.map(({ step }) => step))].join(", ")}. 오류 상세는 수집 로그에 저장했습니다.`,
+      { topic: "autopilot:collect-error", state: JSON.stringify([...errors].sort()), salience: "action",
+        ...(process.env.FERRYX_CRON_RUN_ID ? { incident: process.env.FERRYX_CRON_RUN_ID } : {}) });
+    console.error(errors.join("\n"));
+    process.exit(1);
+  }
+}
