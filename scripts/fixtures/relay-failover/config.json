{
  "schemaVersion": 1,
  "publicHostname": "relay.ferryx.dev",
  "deploymentMode": "commercial",
  "port": 8787,
  "primary": {
    "name": "relay-primary",
    "ssh": "relay@primary.example.net",
    "user": "relay",
    "binary": "/home/relay/bin/ferryx-relay",
    "dataDir": "/home/relay/.ferryx/account-data",
    "relayDataDir": "/home/relay/.ferryx/relay",
    "uiDistDir": "/home/relay/ferryx-relay-web/dist",
    "directHostname": "relay-1.ferryx.dev",
    "originAddress": "primary-origin.example.net"
  },
  "standby": {
    "name": "relay-standby",
    "ssh": "root@standby.example.net",
    "user": "ferryx",
    "binary": "/usr/local/bin/ferryx-relay",
    "dataDir": "/var/lib/ferryx/account-data",
    "relayDataDir": "/var/lib/ferryx/relay",
    "uiDistDir": "/var/lib/ferryx/ui-dist",
    "directHostname": "relay-2.ferryx.dev",
    "originAddress": null
  },
  "litestream": {
    "version": "0.3.13",
    "bucket": "ferryx-relay-litestream",
    "path": "account-store",
    "endpoint": "https://account-id.r2.cloudflarestorage.com"
  },
  "cloudflare": {
    "mode": "load-balancer",
    "zone": "ferryx.dev",
    "monitorIntervalSeconds": 15
  },
  "drill": {
    "probeHost": "windows-probe-host",
    "stopSeconds": 120,
    "probeEverySeconds": 5,
    "evidenceDir": ".omo/evidence/ferryx-adoption-objections-remediation/task-37"
  }
}
