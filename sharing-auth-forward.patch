+/// Canonical share-grant target check: route prefix, host scope, and session id
+/// must all agree, because the host scope is part of the routed target's
+/// identity. A raw grant never authorizes `host-a::s1` (the scope would alias
+/// two hosts' same raw session id), and a grant for `host-a::s1` never
+/// authorizes `host-b::s1` or the bare `s1`.
+pub fn share_target_matches(grant_session_id: &str, requested_target: &str) -> bool {
+    let Some(requested_id) = requested_target.strip_prefix("/api/v1/terminal/") else {
+        return false;
+    };
+    match (
+        crate::worktree::parse_host_scoped_session_id(grant_session_id),
+        crate::worktree::parse_host_scoped_session_id(requested_id),
+    ) {
+        (None, None) => grant_session_id == requested_id,
+        (Some((grant_host, grant_sid)), Some((target_host, target_sid))) => {
+            grant_host == target_host && grant_sid == target_sid
+        }
+        (Some(_), None) | (None, Some(_)) => false,
+    }
+}
+
+#[cfg(test)]
+mod share_target_tests {
+    use super::share_target_matches;
+
+    #[test]
+    fn raw_grant_matches_only_the_bare_target() {
+        assert!(share_target_matches("s1", "/api/v1/terminal/s1"));
+        assert!(!share_target_matches("s1", "/api/v1/terminal/host-a::s1"));
+        assert!(!share_target_matches("s1", "/api/v1/terminal/host-b::s1"));
+        assert!(!share_target_matches("s1", "/api/v1/terminal/s2"));
+    }
+
+    #[test]
+    fn scoped_grant_matches_only_its_own_canonical_target() {
+        assert!(share_target_matches(
+            "host-a::s1",
+            "/api/v1/terminal/host-a::s1"
+        ));
+        assert!(!share_target_matches(
+            "host-a::s1",
+            "/api/v1/terminal/host-b::s1"
+        ));
+        assert!(!share_target_matches("host-a::s1", "/api/v1/terminal/s1"));
+    }
+
+    #[test]
+    fn rejects_targets_outside_the_terminal_route() {
+        assert!(!share_target_matches("s1", "/api/v1/events"));
+        assert!(!share_target_matches("s1", "/api/v1/browser/s1"));
+    }
+}
