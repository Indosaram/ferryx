+//! Collaborator presence for shared terminal sessions.
+//!
+//! The registry tracks every client holding a live `/api/v1/terminal/{id}` socket and
+//! fans out one `session_presence_changed` push on each connect and disconnect, so
+//! header badges are derived from real socket lifecycle events instead of polling or
+//! constants. Serialized participants never carry device names, repository paths,
+//! tokens, or raw client ids: the public alias is an opaque role-prefixed FNV-1a hash
+//! and the raw client id stays internal to the registry for cleanup bookkeeping.
+
+use std::collections::HashMap;
+use std::sync::Arc;
+
+use axum::extract::{Path as AxumPath, State};
+use axum::http::{header, HeaderMap, StatusCode};
+use axum::response::{IntoResponse, Response};
+use axum::Json;
+use parking_lot::Mutex;
+use serde::{Deserialize, Serialize};
+use std::sync::atomic::{AtomicU64, Ordering};
+
+use super::protocol::RemoteEventMessage;
+use super::server::extract_token;
+use super::share_token::standard_security_headers;
+use super::state::RemoteGatewayState;
+
+/// Event name pushed on every presence change over `/api/v1/events`.
+pub const SESSION_PRESENCE_EVENT: &str = "session_presence_changed";
+
+/// Bound on concurrently tracked sessions. Admission beyond it is rejected for a new
+/// session; a live entry is never evicted, so no other socket silently loses presence.
+const MAX_TRACKED_SESSIONS: usize = 64;
+
+/// Bound on distinct participants projected for one session. Admission of a further
+/// client is rejected rather than truncating or evicting anyone already live.
+const MAX_PARTICIPANTS_PER_SESSION: usize = 32;
+
+/// Public participant shape. Deliberately carries no client id, device name, host
+/// name, path, or token: only the opaque alias, the coarse role, and connect time.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct PresenceParticipant {
+    pub alias: String,
+    pub role: String,
+    pub connected_at: u64,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+struct ClientPresence {
+    participant: PresenceParticipant,
+    /// Per-connection tokens held by this client right now. The projection shows the
+    /// client once (refcounted) and only the guard holding a given token may remove it.
+    connections: Vec<u64>,
+}
+
+/// Result of registering one socket. `Rejected` means capacity would require evicting
+/// another live entry; `Attached` carries the per-connection token plus the projected
+/// snapshot only when the public projection actually changed, so pushes stay event-true.
+enum JoinOutcome {
+    Rejected,
+    Attached {
+        token: u64,
+        changed: Option<Vec<PresenceParticipant>>,
+    },
+}
+
+fn unix_now_secs() -> u64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_secs())
+        .unwrap_or(0)
+}
+
+/// Deterministic display alias (FNV-1a over the client id, 24 bits of output).
+/// Two different clients can only collide by hash chance, and the alias never
+/// encodes anything derived from a device name, hostname, path, or credential.
+pub fn alias_for(client_id: &str, role: &str) -> String {
+    let mut hash: u32 = 0x811c_9dc5;
+    for byte in client_id.as_bytes() {
+        hash ^= u32::from(*byte);
+        hash = hash.wrapping_mul(0x0100_0193);
+    }
+    let label = if role == "view" { "Viewer" } else { "Control" };
+    format!("{label}-{:06x}", hash & 0x00ff_ffff)
+}
+
+/// Session-keyed collaborator registry. Each socket join is stored under a unique
+/// per-connection token; the public projection collapses a client's overlapping
+/// connections by refcount, so an old guard's drop can never remove a newer live
+/// connection. Only the projection is ever serialized or broadcast.
+pub struct PresenceRegistry {
+    sessions: Mutex<HashMap<String, HashMap<String, ClientPresence>>>,
+    next_token: AtomicU64,
+}
+
+impl Default for PresenceRegistry {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl PresenceRegistry {
+    pub fn new() -> Self {
+        Self {
+            sessions: Mutex::new(HashMap::new()),
+            next_token: AtomicU64::new(1),
+        }
+    }
+
+    fn project(clients: &HashMap<String, ClientPresence>) -> Vec<PresenceParticipant> {
+        let mut participants: Vec<PresenceParticipant> = clients
+            .values()
+            .map(|client| client.participant.clone())
+            .collect();
+        participants.sort_by(|a, b| {
+            a.alias
+                .cmp(&b.alias)
+                .then(a.connected_at.cmp(&b.connected_at))
+        });
+        participants.truncate(MAX_PARTICIPANTS_PER_SESSION);
+        participants
+    }
+
+    /// Register one socket under a fresh connection token. A further connection from
+    /// the same client joins its refcount and leaves the projection untouched (no
+    /// push); the projection changes only when a client first appears. Capacity never
+    /// evicts a live entry — the new admission is rejected instead.
+    fn join(&self, session_id: &str, client_id: &str, role: &str) -> JoinOutcome {
+        let participant = PresenceParticipant {
+            alias: alias_for(client_id, role),
+            role: role.to_string(),
+            connected_at: unix_now_secs(),
+        };
+        let token = self.next_token.fetch_add(1, Ordering::Relaxed);
+        let mut sessions = self.sessions.lock();
+        if let Some(clients) = sessions.get_mut(session_id) {
+            if let Some(existing) = clients.get_mut(client_id) {
+                existing.connections.push(token);
+                return JoinOutcome::Attached {
+                    token,
+                    changed: None,
+                };
+            }
+            if clients.len() >= MAX_PARTICIPANTS_PER_SESSION {
+                return JoinOutcome::Rejected;
+            }
+            clients.insert(
+                client_id.to_string(),
+                ClientPresence {
+                    participant,
+                    connections: vec![token],
+                },
+            );
+            let changed = Self::project(clients);
+            return JoinOutcome::Attached {
+                token,
+                changed: Some(changed),
+            };
+        }
+        if sessions.len() >= MAX_TRACKED_SESSIONS {
+            return JoinOutcome::Rejected;
+        }
+        let mut clients = HashMap::new();
+        clients.insert(
+            client_id.to_string(),
+            ClientPresence {
+                participant,
+                connections: vec![token],
+            },
+        );
+        let changed = Self::project(&clients);
+        sessions.insert(session_id.to_string(), clients);
+        JoinOutcome::Attached {
+            token,
+            changed: Some(changed),
+        }
+    }
+
+    /// Remove exactly the connection identified by its guard token. Returns the new
+    /// snapshot only when a client actually left the projection; while a sibling
+    /// connection from the same client is still live the projection is unchanged, so
+    /// an old socket's drop can never remove a newer live connection (and pushes no-op).
+    /// Returns `None` when the token is already gone. Empty sessions are dropped.
+    fn leave(&self, session_id: &str, token: u64) -> Option<Vec<PresenceParticipant>> {
+        let mut sessions = self.sessions.lock();
+        let clients = sessions.get_mut(session_id)?;
+        let client_id = clients.iter().find_map(|(client_id, client)| {
+            client
+                .connections
+                .iter()
+                .any(|held| *held == token)
+                .then(|| client_id.clone())
+        })?;
+        let client = clients.get_mut(&client_id).expect("client just found");
+        let Some(position) = client.connections.iter().position(|held| *held == token) else {
+            return None;
+        };
+        client.connections.remove(position);
+        if !client.connections.is_empty() {
+            return None;
+        }
+        clients.remove(&client_id);
+        let snapshot = Self::project(clients);
+        if clients.is_empty() {
+            sessions.remove(session_id);
+        }
+        Some(snapshot)
+    }
+
+    /// Public snapshot for the REST route (no raw ids, bounded).
+    pub fn snapshot(&self, session_id: &str) -> Vec<PresenceParticipant> {
+        let sessions = self.sessions.lock();
+        sessions
+            .get(session_id)
+            .map(|entries| Self::project(entries))
+            .unwrap_or_default()
+    }
+
+    /// Explicit removal for share revocation: drops every connection held by the
+    /// `share-{client_id}` client, so a revoke clears all of its overlapping sockets
+    /// in one projection change.
+    pub fn remove_share_client(&self, session_id: &str, client_id: &str) -> Option<Vec<PresenceParticipant>> {
+        let mut sessions = self.sessions.lock();
+        let clients = sessions.get_mut(session_id)?;
+        clients.remove(&format!("share-{client_id}"))?;
+        let snapshot = Self::project(clients);
+        if clients.is_empty() {
+            sessions.remove(session_id);
+        }
+        Some(snapshot)
+    }
+}
+
+#[derive(Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+struct PresenceEventPayload {
+    session_id: String,
+    participants: Vec<PresenceParticipant>,
+    count: usize,
+}
+
+/// Fan out a full participant snapshot so any late or reconnecting subscriber
+/// converges from the next push without polling.
+pub fn broadcast_presence(
+    state: &RemoteGatewayState,
+    session_id: &str,
+    participants: Vec<PresenceParticipant>,
+) {
+    let payload = PresenceEventPayload {
+        session_id: session_id.to_string(),
+        count: participants.len(),
+        participants,
+    };
+    let payload = match serde_json::to_value(payload) {
+        Ok(value) => value,
+        Err(_) => return,
+    };
+    let frame = serde_json::to_string(&RemoteEventMessage {
+        event: SESSION_PRESENCE_EVENT.to_string(),
+        payload,
+    });
+    if let Ok(frame) = frame {
+        state.emit_event(frame);
+    }
+}
+
+/// RAII attach for one terminal socket: joins on creation and leaves on drop, so
+/// every exit path (socket close, revocation watch, upgrade teardown) cleans up and
+/// pushes exactly one disconnect for the connection it registered — never for a
+/// sibling connection sharing the same client id. Returns `None` when presence
+/// admission is rejected at capacity (the socket still runs, simply untracked).
+pub struct PresenceGuard {
+    state: Arc<RemoteGatewayState>,
+    session_id: String,
+    token: u64,
+}
+
+impl PresenceGuard {
+    pub fn attach(
+        state: Arc<RemoteGatewayState>,
+        session_id: &str,
+        client_id: &str,
+        role: &'static str,
+    ) -> Option<Self> {
+        match state.presence.join(session_id, client_id, role) {
+            JoinOutcome::Rejected => None,
+            JoinOutcome::Attached { token, changed } => {
+                if let Some(participants) = changed {
+                    broadcast_presence(&state, session_id, participants);
+                }
+                Some(Self {
+                    state,
+                    session_id: session_id.to_string(),
+                    token,
+                })
+            }
+        }
+    }
+}
+
+impl Drop for PresenceGuard {
+    fn drop(&mut self) {
+        if let Some(participants) = self.state.presence.leave(&self.session_id, self.token) {
+            broadcast_presence(&self.state, &self.session_id, participants);
+        }
+    }
+}
+
+#[derive(Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct SessionPresenceResponse {
+    session_id: String,
+    participants: Vec<PresenceParticipant>,
+    count: usize,
+}
+
+/// `GET /api/v1/sessions/{sessionId}/presence` — one authoritative snapshot for the
+/// initial badge render; live updates arrive as `session_presence_changed` pushes.
+/// Authorized for gateway device tokens and for a share token scoped to this session
+/// under the SAME canonical target policy as the socket-ticket and terminal checks
+/// (`share_target_matches` on the requested path with its host scope preserved);
+/// unauthorized or foreign-scope credentials are refused before any data is read.
+/// The snapshot is keyed by the CANONICAL requested id — the same host-scoped key
+/// the terminal socket attached under — never a stripped raw id.
+pub async fn get_session_presence_handler(
+    State(state): State<Arc<RemoteGatewayState>>,
+    AxumPath(session_id): AxumPath<String>,
+    headers: HeaderMap,
+) -> Result<Response, (StatusCode, String)> {
+    let token = extract_token(&headers)
+        .ok_or((StatusCode::UNAUTHORIZED, "Missing auth token".into()))?;
+
+    // Canonical grant policy, identical to the socket-ticket and terminal checks:
+    // the requested id keeps its host scope for the match, so `host-a::s1` and
+    // `host-b::s1` can never alias into an unauthorized snapshot. No unwrap
+    // happens anywhere on this path — the canonical requested id is both the
+    // authorized target and the registry key.
+    let canonical_target = format!("/api/v1/terminal/{}", session_id);
+    let authorized = if state.auth_manager.validate_token(&token).is_ok() {
+        true
+    } else if let Ok(grant) = state.share_manager.validate_share_token(&token) {
+        super::share_token::share_target_matches(&grant.session_id, &canonical_target)
+    } else {
+        false
+    };
+    if !authorized {
+        return Err((StatusCode::UNAUTHORIZED, "Invalid or revoked token".into()));
+    }
+
+    // Canonical requested id end-to-end: presence is keyed the way the socket
+    // attached (host scope kept), so this snapshot can never read an identically
+    // named raw session of another host's registry bucket.
+    let participants = state.presence.snapshot(&session_id);
+    let count = participants.len();
+    Ok((
+        standard_security_headers(),
+        Json(SessionPresenceResponse {
+            session_id,
+            participants,
+            count,
+        }),
+    )
+        .into_response())
+}
+
