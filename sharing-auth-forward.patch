+        match self {
+            Self::InvalidOrExpiredCode => write!(f, "Invalid or expired exchange code"),
+            Self::ShareNotFound => write!(f, "Share grant not found"),
+            Self::RevokedToken => write!(f, "Share token has been revoked"),
+            Self::ExpiredToken => write!(f, "Share token has expired"),
+            Self::Unauthorized => write!(f, "Unauthorized access"),
+            Self::ForbiddenPermission => write!(f, "Insufficient permission for share operation"),
+            Self::SessionMismatch => write!(f, "Target session mismatch"),
