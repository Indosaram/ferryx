+    pub fn exchange_code(
+        &self,
+        code: &str,
+        client_name: Option<String>,
+    ) -> Result<ExchangedShareGrant, ShareError> {
+        let code_hash = hash_token_sha256(code);
+        let share_token = generate_csprng_token_128();
+        let token_hash = hash_token_sha256(&share_token);
+        let client_id = uuid::Uuid::new_v4().to_string();
+        let now = unix_now_secs();
+
+        // Single authority transaction: atomicity and tombstone check prevents resurrection races
+        let mut state = self.state.lock();
+        state.prune_expired(now);
+
+        let pending = state
+            .pending_codes
+            .remove(&code_hash)
+            .ok_or(ShareError::InvalidOrExpiredCode)?;
+
+        // Expiry >= boundary consistent enforcement
+        if now >= pending.expires_at {
+            return Err(ShareError::InvalidOrExpiredCode);
+        }
+
+        // Tombstone check: if share was revoked while pending, reject immediately
+        if state.revoked_share_ids.contains(&pending.share_id) {
+            return Err(ShareError::RevokedToken);
+        }
+
+        if state.active_grants.len() >= MAX_ACTIVE_SHARE_GRANTS {
+            return Err(ShareError::RateLimited);
+        }
+
+        let expires_at = pending.grant_expires_at;
+        if now >= expires_at {
+            return Err(ShareError::ExpiredToken);
+        }
+
+        let grant = ActiveShareGrant {
+            token_hash,
+            share_id: pending.share_id.clone(),
+            session_id: pending.session_id.clone(),
+            permission: pending.permission,
+            created_at: pending.created_at,
+            expires_at,
+            client_id: client_id.clone(),
+            client_name,
+            revoked: false,
+        };
+
+        state.active_grants.insert(token_hash, grant);
+
+        Ok(ExchangedShareGrant {
+            share_token,
+            share_id: pending.share_id,
+            session_id: pending.session_id,
+            permission: pending.permission,
+            expires_at,
+            client_id,
+        })
+    }
+
+    pub fn validate_share_token(&self, token: &str) -> Result<ActiveShareGrant, ShareError> {
+        let candidate_hash = hash_token_sha256(token);
+        let now = unix_now_secs();
+
+        let state = self.state.lock();
+        for (stored_hash, grant) in state.active_grants.iter() {
+            if constant_time_eq_32(stored_hash, &candidate_hash) {
+                if grant.revoked || state.revoked_share_ids.contains(&grant.share_id) {
+                    return Err(ShareError::RevokedToken);
+                }
+                // Expiry >= boundary consistent enforcement
+                if now >= grant.expires_at {
+                    return Err(ShareError::ExpiredToken);
+                }
+                return Ok(grant.clone());
+            }
+        }
+
+        Err(ShareError::Unauthorized)
+    }
+
+    pub fn revoke_share(&self, share_id: &str) -> Result<(), ShareError> {
+        let mut state = self.state.lock();
+        let mut found = false;
+
+        // 1. Remove pending exchange code if present
+        let before_pending = state.pending_codes.len();
+        state.pending_codes.retain(|_, p| p.share_id != share_id);
+        if state.pending_codes.len() < before_pending {
+            found = true;
+        }
+
+        // 2. Mark active grants revoked
+        for grant in state.active_grants.values_mut() {
+            if grant.share_id == share_id {
+                grant.revoked = true;
+                found = true;
+            }
+        }
+
+        // 3. Atomically record tombstone under same lock to prevent concurrent resurrection
+        state.revoked_share_ids.insert(share_id.to_string());
+
+        // 4. Retain revoked state via send_replace so watch channel never loses state even if 0 receivers
+        if let Some(tx) = state.revocation_channels.get_mut(share_id) {
+            let _ = tx.send_replace(true);
+            found = true;
+        } else {
+            let (tx, _) = watch::channel(true);
+            state.revocation_channels.insert(share_id.to_string(), tx);
+            found = true;
+        }
+
+        if found {
+            Ok(())
+        } else {
+            Err(ShareError::ShareNotFound)
+        }
+    }
+
+    pub fn revocation_receiver(&self, share_id: &str) -> Result<watch::Receiver<bool>, ShareError> {
+        let mut state = self.state.lock();
+        let is_tombstone = state.revoked_share_ids.contains(share_id);
+
+        let tx = state
+            .revocation_channels
+            .entry(share_id.to_string())
+            .or_insert_with(|| {
+                let (tx, _) = watch::channel(is_tombstone);
+                tx
+            });
+
+        if is_tombstone {
+            let _ = tx.send_replace(true);
+        }
+
+        Ok(tx.subscribe())
+    }
