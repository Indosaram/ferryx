+pub struct ShareManager {
+    state: Mutex<ShareAuthorityState>,
+}
+
+impl Default for ShareManager {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl ShareManager {
+    pub fn new() -> Self {
+        Self {
+            state: Mutex::new(ShareAuthorityState::new()),
+        }
+    }
+
+    pub fn create_exchange_code(
+        &self,
+        session_id: &str,
+        permission: SharePermission,
+        ttl_seconds: Option<u64>,
+    ) -> Result<(String, String, u64, u64), ShareError> {
+        let code = generate_csprng_token_128();
+        let share_id = uuid::Uuid::new_v4().to_string();
+        let now = unix_now_secs();
+        let code_expires_at = now.saturating_add(DEFAULT_EXCHANGE_CODE_TTL_SECS);
+
+        // Checked, clamped TTL preventing arithmetic overflow
+        let grant_ttl = ttl_seconds
+            .unwrap_or(DEFAULT_SHARE_GRANT_TTL_SECS)
+            .clamp(MIN_SHARE_GRANT_TTL_SECS, MAX_SHARE_GRANT_TTL_SECS);
+        let grant_expires_at = now.saturating_add(grant_ttl);
+
+        let code_hash = hash_token_sha256(&code);
+        let pending = PendingExchange {
+            _code_hash: code_hash,
+            share_id: share_id.clone(),
+            session_id: session_id.to_string(),
+            permission,
+            created_at: now,
+            expires_at: code_expires_at,
+            grant_expires_at,
+        };
+
+        {
+            let mut state = self.state.lock();
+            state.prune_expired(now);
+            if state.pending_codes.len() >= MAX_PENDING_EXCHANGE_CODES {
+                return Err(ShareError::RateLimited);
+            }
+            state.pending_codes.insert(code_hash, pending);
+            state.revocation_channels.entry(share_id.clone()).or_insert_with(|| {
+                let (tx, _) = watch::channel(false);
+                tx
+            });
+        }
+
+        Ok((share_id, code, code_expires_at, grant_expires_at))
+    }
