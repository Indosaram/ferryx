+        // Attach presence
+        let presence = super::presence::PresenceGuard::attach(
+            Arc::clone(&state),
+            &join_body.session_id,
+            &format!("share-{}", join_body.client_id),
+            "control",
+        );
+        assert!(presence.is_some());
+        assert_eq!(state.presence.count(&join_body.session_id), 1);
+
+        // 1. Simulate live terminal socket pump under while_authorized
+        let (input_tx, mut input_rx) = tokio::sync::mpsc::channel::<Vec<u8>>(10);
+        let mut term_rev = revocation.clone();
+        let term_state = Arc::clone(&state);
+        let term_sid = join_body.session_id.clone();
+        let term_handle = tokio::spawn(async move {
+            let _p = presence;
+            super::server::while_authorized(&mut term_rev, Some(deadline), async move {
+                while let Some(data) = input_rx.recv().await {
