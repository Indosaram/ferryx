+    #[tokio::test]
+    async fn test_atomic_revoke_exchange_race_barrier_deterministic() {
+        // Deterministic synchronization barrier: no sleeps
+        let mgr = Arc::new(ShareManager::new());
+        let (share_id, code, _, _) = mgr
+            .create_exchange_code("session-atomic-race", SharePermission::Control, None)
+            .unwrap();
+
+        let barrier = Arc::new(tokio::sync::Barrier::new(2));
+
+        let barrier_rev = Arc::clone(&barrier);
+        let mgr_rev = Arc::clone(&mgr);
+        let sid_rev = share_id.clone();
+        let revoke_task = tokio::spawn(async move {
+            barrier_rev.wait().await;
+            mgr_rev.revoke_share(&sid_rev)
+        });
+
+        let barrier_exc = Arc::clone(&barrier);
+        let mgr_exc = Arc::clone(&mgr);
+        let code_exc = code.clone();
+        let exchange_task = tokio::spawn(async move {
+            barrier_exc.wait().await;
+            mgr_exc.exchange_code(&code_exc, Some("racer".into()))
+        });
+
+        let (revoke_outcome, exchange_outcome) = tokio::join!(revoke_task, exchange_task);
+        let revoke_res = revoke_outcome.unwrap();
+        let exchange_res = exchange_outcome.unwrap();
+
+        // Either revoke succeeded and exchange failed (InvalidOrExpiredCode/RevokedToken),
+        // OR exchange succeeded and revoke succeeded immediately afterwards.
+        // In ALL possible execution interleavings:
+        // No valid, unrevoked grant can ever be returned or remain valid!
+        assert!(revoke_res.is_ok(), "Revocation must succeed");
+        if let Ok(grant) = exchange_res {
+            // If exchange won the race, the grant must have been revoked by revoke_share
+            assert_eq!(
+                mgr.validate_share_token(&grant.share_token).unwrap_err(),
+                ShareError::RevokedToken,
+                "Resurrection must be impossible: grant must be marked revoked"
+            );
+        }
+
+        // Revocation receiver must consistently observe true
+        let rx = mgr.revocation_receiver(&share_id).unwrap();
+        assert!(*rx.borrow(), "Revocation receiver must observe true via send_replace");
+    }
