+        // Before expiry: PTY input succeeds
+        assert!(input_tx.send(b"hello".to_vec()).await.is_ok());
+
+        // Fast-forward virtual clock past expiry deadline (10 seconds)
+        tokio::time::advance(std::time::Duration::from_secs(10)).await;
+
+        // Terminal socket must cancel immediately at >= expiry
+        let term_res = term_handle.await.unwrap();
+        assert_eq!(term_res, None, "Terminal socket must close on deadline");
+
+        // Events socket must cancel immediately at >= expiry
+        let events_res = events_handle.await.unwrap();
+        assert_eq!(events_res, None, "Events socket must close on deadline");
