+pub async fn create_share_handler(
+    State(state): State<Arc<super::state::RemoteGatewayState>>,
+    headers: HeaderMap,
+    Json(payload): Json<CreateShareRequest>,
+) -> Result<Response, (StatusCode, String)> {
+    let token = super::server::extract_token(&headers)
+        .ok_or((StatusCode::UNAUTHORIZED, "Missing auth token".into()))?;
+
+    let device = state
+        .auth_manager
+        .validate_token(&token)
+        .map_err(|_| (StatusCode::UNAUTHORIZED, "Invalid or revoked token".into()))?;
+
+    if device.permission != super::auth::DevicePermission::Control {
+        return Err((
+            StatusCode::FORBIDDEN,
+            "Forbidden: read-only clients cannot issue shares".into(),
+        ));
+    }
+
+    // Owner scope: issuing a share is owner authority — not a capability any
+    // paired mirror-scoped control device may exercise.
+    if device.access_scope != super::auth::DeviceAccessScope::Machine {
+        return Err((
+            StatusCode::FORBIDDEN,
+            "Forbidden: owner device scope required to issue shares".into(),
+        ));
+    }
+
+    let session_exists = state
+        .session_backend
+        .list_sessions()
+        .await
+        .contains(&payload.session_id)
+        || state.terminal_service.list_sessions().contains(&payload.session_id);
+
+    if !session_exists {
+        return Err((StatusCode::NOT_FOUND, "Target session not found".into()));
+    }
+
+    let (share_id, code, code_expires_at, expires_at) = state
+        .share_manager
+        .create_exchange_code(
+            &payload.session_id,
+            payload.permission,
+            payload.ttl_seconds,
+        )
+        .map_err(|e| (StatusCode::TOO_MANY_REQUESTS, e.to_string()))?;
+
+    let join_url = format!("/join?code={}", code);
+
+    let response = CreateShareResponse {
+        share_id,
+        exchange_code: code,
+        session_id: payload.session_id,
+        permission: payload.permission,
+        expires_at,
+        code_expires_at,
+        join_url,
+    };
+
+    Ok((standard_security_headers(), Json(response)).into_response())
+}
+
+pub async fn exchange_share_handler(
+    State(state): State<Arc<super::state::RemoteGatewayState>>,
+    Json(payload): Json<ExchangeShareRequest>,
+) -> Result<Response, (StatusCode, String)> {
+    let grant = state
+        .share_manager
+        .exchange_code(&payload.code, payload.client_name)
+        .map_err(|e| match e {
+            ShareError::InvalidOrExpiredCode => (
+                StatusCode::GONE,
+                "Invalid or expired one-time exchange code".into(),
+            ),
+            ShareError::RevokedToken => (
+                StatusCode::FORBIDDEN,
+                "Share has already been revoked".into(),
+            ),
+            ShareError::RateLimited => (
+                StatusCode::TOO_MANY_REQUESTS,
+                "Too many pending exchange requests".into(),
+            ),
+            _ => (StatusCode::BAD_REQUEST, "Exchange failed".into()),
+        })?;
+
+    let response = ExchangeShareResponse {
+        share_token: grant.share_token,
+        share_id: grant.share_id,
+        session_id: grant.session_id,
+        permission: grant.permission,
+        expires_at: grant.expires_at,
+        client_id: grant.client_id,
+    };
+
+    Ok((standard_security_headers(), Json(response)).into_response())
+}
+
+pub async fn get_share_handler(
+    State(state): State<Arc<super::state::RemoteGatewayState>>,
+    AxumPath(share_id): AxumPath<String>,
+    headers: HeaderMap,
+) -> Result<Response, (StatusCode, String)> {
+    let token = super::server::extract_token(&headers)
+        .ok_or((StatusCode::UNAUTHORIZED, "Missing auth token".into()))?;
+
+    // Owner devices only: Machine access scope with Control — never any device.
+    // A share token instead takes the binding path below.
+    let presented_grant = if let Ok(device) = state.auth_manager.validate_token(&token) {
+        if device.access_scope != super::auth::DeviceAccessScope::Machine
+            || device.permission != super::auth::DevicePermission::Control
+        {
+            return Err((
+                StatusCode::FORBIDDEN,
+                "Forbidden: owner scope with control permission required to read share grants"
+                    .into(),
+            ));
+        }
+        None
+    } else {
+        // Bind BEFORE any lookup: a share token may read exactly its own grant.
+        // A foreign or unknown share id must never reach get_share — no metadata
+        // disclosure, no existence oracle.
+        let grant = state
+            .share_manager
+            .validate_share_token(&token)
+            .map_err(|_| (StatusCode::UNAUTHORIZED, "Unauthorized".into()))?;
+        if grant.share_id != share_id {
+            return Err((
+                StatusCode::FORBIDDEN,
+                "Forbidden: share token can only read its own grant".into(),
+            ));
+        }
+        Some(grant)
+    };
+
+    let grant = if let Some(presented) = presented_grant {
+        presented
+    } else {
+        state
+            .share_manager
+            .get_share(&share_id)
+            .ok_or((StatusCode::NOT_FOUND, "Share grant not found".into()))?
+    };
+
+    // Canonical session-target bind (the second half of the binding): the record
+    // served for this share must match the presented grant's session under the
+    // same canonical policy as the ticket, terminal and presence checks.
+    if let Some(presented) = &presented_grant {
+        if !share_target_matches(
+            &presented.session_id,
+            &format!("/api/v1/terminal/{}", grant.session_id),
+        ) {
+            return Err((
+                StatusCode::FORBIDDEN,
+                "Forbidden: share token is not bound to this grant's session target".into(),
+            ));
+        }
+    }
+
+    let response = ShareInfoResponse {
+        share_id: grant.share_id,
+        session_id: grant.session_id,
+        permission: grant.permission,
+        expires_at: grant.expires_at,
+        revoked: grant.revoked,
+    };
+
+    Ok((standard_security_headers(), Json(response)).into_response())
+}
+
+pub async fn revoke_share_handler(
+    State(state): State<Arc<super::state::RemoteGatewayState>>,
+    AxumPath(share_id): AxumPath<String>,
+    headers: HeaderMap,
+) -> Result<Response, (StatusCode, String)> {
+    let token = super::server::extract_token(&headers)
+        .ok_or((StatusCode::UNAUTHORIZED, "Missing auth token".into()))?;
+
+    let device = state
+        .auth_manager
+        .validate_token(&token)
+        .map_err(|_| (StatusCode::UNAUTHORIZED, "Invalid or revoked token".into()))?;
+
+    if device.permission != super::auth::DevicePermission::Control {
+        return Err((
+            StatusCode::FORBIDDEN,
+            "Forbidden: control permission required to revoke shares".into(),
+        ));
+    }
+
+    // Owner scope: revocation is owner authority — not any device's.
+    if device.access_scope != super::auth::DeviceAccessScope::Machine {
+        return Err((
+            StatusCode::FORBIDDEN,
+            "Forbidden: owner device scope required to revoke shares".into(),
+        ));
+    }
+
+    state.share_manager.revoke_share(&share_id).map_err(|e| match e {
+        ShareError::ShareNotFound => (StatusCode::NOT_FOUND, "Share grant not found".into()),
+        _ => (StatusCode::INTERNAL_SERVER_ERROR, "Revocation failed".into()),
+    })?;
+
+    // Revocation also drops the grant holder from collaborator presence so the
+    // header badge converges even if the viewer's socket lingers past revocation.
+    if let Some(grant) = state.share_manager.get_share(&share_id) {
+        // Presence is keyed by the CANONICAL requested id (host scope kept — the
+        // same form this grant was minted with). Never strip the scope here:
+        // unwrapping `host-a::s1` to `s1` would aim the removal at the raw bucket
+        // and could hit another host's identically named session — cross-host
+        // alias with collateral removal.
+        if let Some(participants) =
+            state.presence.remove_share_client(&grant.session_id, &grant.client_id)
+        {
+            super::presence::broadcast_presence(&state, &grant.session_id, participants);
+        }
+    }
+
+    let response = RevokeShareResponse {
+        revoked: true,
+        share_id,
+    };
+
+    Ok((standard_security_headers(), Json(response)).into_response())
+}
+
+pub async fn list_shares_handler(
+    State(state): State<Arc<super::state::RemoteGatewayState>>,
+    Query(query): Query<ListSharesQuery>,
+    headers: HeaderMap,
+) -> Result<Response, (StatusCode, String)> {
+    let token = super::server::extract_token(&headers)
+        .ok_or((StatusCode::UNAUTHORIZED, "Missing auth token".into()))?;
+
+    let device = state
+        .auth_manager
+        .validate_token(&token)
+        .map_err(|_| (StatusCode::UNAUTHORIZED, "Invalid or revoked token".into()))?;
+
+    if device.permission != super::auth::DevicePermission::Control {
+        return Err((
+            StatusCode::FORBIDDEN,
+            "Forbidden: control permission required to list shares".into(),
+        ));
+    }
+
+    // Owner scope: share metadata stays inside the owner's device scope.
+    if device.access_scope != super::auth::DeviceAccessScope::Machine {
+        return Err((
+            StatusCode::FORBIDDEN,
+            "Forbidden: owner device scope required to list shares".into(),
+        ));
+    }
+
+    let shares = state
+        .share_manager
+        .list_active_shares(query.session_id.as_deref())
+        .into_iter()
+        .map(|grant| ShareInfoResponse {
+            share_id: grant.share_id,
+            session_id: grant.session_id,
+            permission: grant.permission,
+            expires_at: grant.expires_at,
+            revoked: grant.revoked,
+        })
+        .collect();
+
+    Ok((standard_security_headers(), Json(ListSharesResponse { shares })).into_response())
+}
