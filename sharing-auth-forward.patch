+/// Share sockets receive only events canonically targeted at their own session:
+/// the frame's `payload.sessionId` must pass the same canonical triad comparison
+/// that authorizes the terminal route, so a host-scoped grant can never read an
+/// identically named raw session of another host. Frames without a session target
+/// (the desktop selection/focus stream, workspace inventory) and unparseable
+/// frames are dropped by default, and the event TYPE must be on the explicit
+/// allowlist — presence only — regardless of target.
+fn share_event_forwardable(frame: &str, grant_session_id: &str) -> bool {
+    let Ok(value) = serde_json::from_str::<serde_json::Value>(frame) else {
+        return false;
+    };
+    // Explicit allowlist: no plan authorizes arbitrary sessionId-bearing event
+    // types for share sockets (superlogical-parity-plan names presence only),
+    // so every other type — selection, inventory, agent/transcript frames,
+    // unknown future events — is denied even when its payload names the
+    // grant's own canonical session.
+    if value.get("event").and_then(|event| event.as_str())
+        != Some(super::presence::SESSION_PRESENCE_EVENT)
+    {
+        return false;
+    }
+    let Some(target_session) = value
+        .get("payload")
+        .and_then(|payload| payload.get("sessionId"))
+        .and_then(|value| value.as_str())
+    else {
+        return false;
+    };
+    super::share_token::share_target_matches(
+        grant_session_id,
+        &format!("/api/v1/terminal/{target_session}"),
+    )
+}
+
+/// Events pump for a share grant: no initial snapshot, per-event canonical-target
+/// filtering, and the same biased revocation cancellation the device path uses —
+/// revocation wins over an in-flight event send and closes the socket.
+async fn handle_share_events_socket(
+    mut socket: WebSocket,
+    mut rx: broadcast::Receiver<String>,
+    grant_session_id: String,
+) {
+    while let Ok(msg) = rx.recv().await {
+        if !share_event_forwardable(&msg, &grant_session_id) {
+            continue;
+        }
+        if socket.send(Message::Text(msg.into())).await.is_err() {
+            break;
+        }
+    }
+}
