+    /// The metadata-authorization fix at the ACTUAL production route: a real
+    /// HTTP GET through `create_remote_router` lets share A read its own
+    /// metadata and refuses share B / an unknown id with 403 before lookup;
+    /// after production revoke or expiry the same bearer is 401 at the route.
+    #[tokio::test]
+    async fn test_route_get_share_http_cross_share_metadata() {
+        let (state, control_token, _) = create_test_state(vec![
+            "session-http-a".into(),
+            "session-http-b".into(),
+            "session-http-c".into(),
+        ]);
+        let (share_a, code_a, _, _) = state
+            .share_manager
+            .create_exchange_code("session-http-a", SharePermission::View, None)
+            .unwrap();
+        let grant_a = state.share_manager.exchange_code(&code_a, None).unwrap();
+        let (share_b, _, _, _) = state
+            .share_manager
+            .create_exchange_code("session-http-b", SharePermission::View, None)
+            .unwrap();
+        let (share_c, code_c, _, _) = state
+            .share_manager
+            .create_exchange_code("session-http-c", SharePermission::View, None)
+            .unwrap();
+        let grant_c = state.share_manager.exchange_code(&code_c, None).unwrap();
+
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let addr = listener.local_addr().unwrap();
+        let router = super::server::create_remote_router(Arc::clone(&state));
+        let (stop_tx, stop_rx) = tokio::sync::oneshot::channel::<()>();
+        tokio::spawn(async move {
+            let _ = axum::serve(listener, router)
+                .with_graceful_shutdown(async {
+                    let _ = stop_rx.await;
+                })
+                .await;
+        });
+
+        let client = reqwest::Client::new();
+        let bearer = format!("Bearer {}", grant_a.share_token);
+        let get = |share: String, token: String| {
+            let client = client.clone();
+            async move {
+                client
+                    .get(format!("http://{addr}/api/v1/shares/{share}"))
+                    .header(header::AUTHORIZATION, token)
+                    .send()
+                    .await
+                    .unwrap()
+                    .status()
+            }
+        };
+
+        // Own metadata 200; cross-share and unknown ids 403 before any lookup.
+        assert_eq!(get(share_a.clone(), bearer.clone()).await, StatusCode::OK);
+        assert_eq!(
+            get(share_b.clone(), bearer.clone()).await,
+            StatusCode::FORBIDDEN
+        );
+        assert_eq!(
+            get("share-unknown".into(), bearer.clone()).await,
+            StatusCode::FORBIDDEN
+        );
+
+        // Production revoke first; the same bearer is then 401 at the route.
+        let revoke = revoke_share_handler(
+            State(Arc::clone(&state)),
+            AxumPath(share_a.clone()),
+            auth_headers(&control_token),
+        )
+        .await
+        .unwrap();
+        assert_eq!(revoke.status(), StatusCode::OK);
+        assert_eq!(
+            get(share_a.clone(), bearer.clone()).await,
+            StatusCode::UNAUTHORIZED
+        );
+
+        // Expiry equally refuses at the actual route.
+        state.share_manager.expire_grant_for_test(&share_c);
+        assert_eq!(
+            get(share_c, format!("Bearer {}", grant_c.share_token)).await,
+            StatusCode::UNAUTHORIZED
+        );
+
+        let _ = stop_tx.send(());
+    }
