+pub fn generate_csprng_token_128() -> String {
+    let mut bytes = [0u8; 16];
+    rand::rngs::OsRng.fill_bytes(&mut bytes);
+    let mut hex = String::with_capacity(32);
+    for b in bytes {
+        use std::fmt::Write;
+        let _ = write!(hex, "{:02x}", b);
+    }
+    hex
+}
+
+pub fn hash_token_sha256(token: &str) -> [u8; 32] {
+    let mut hasher = Sha256::new();
+    hasher.update(token.as_bytes());
+    hasher.finalize().into()
+}
+
+pub fn constant_time_eq_32(a: &[u8; 32], b: &[u8; 32]) -> bool {
+    let mut diff = 0u8;
+    for (x, y) in a.iter().zip(b.iter()) {
+        diff |= x ^ y;
+    }
+    diff == 0
+}
+
+fn unix_now_secs() -> u64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_secs())
+        .unwrap_or(0)
+}
+
+#[derive(Clone)]
+struct PendingExchange {
+    _code_hash: [u8; 32],
+    share_id: String,
+    session_id: String,
+    permission: SharePermission,
+    created_at: u64,
+    expires_at: u64,
+    grant_expires_at: u64,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ActiveShareGrant {
+    #[serde(skip)]
+    pub token_hash: [u8; 32],
+    pub share_id: String,
+    pub session_id: String,
+    pub permission: SharePermission,
+    pub created_at: u64,
+    pub expires_at: u64,
+    pub client_id: String,
+    pub client_name: Option<String>,
+    pub revoked: bool,
+}
+
+#[derive(Debug, Clone)]
+pub struct ExchangedShareGrant {
+    pub share_token: String,
+    pub share_id: String,
+    pub session_id: String,
+    pub permission: SharePermission,
+    pub expires_at: u64,
+    pub client_id: String,
+}
+
+struct ShareAuthorityState {
+    pending_codes: HashMap<[u8; 32], PendingExchange>,
+    active_grants: HashMap<[u8; 32], ActiveShareGrant>,
+    revoked_share_ids: HashSet<String>,
+    revocation_channels: HashMap<String, watch::Sender<bool>>,
+}
+
+impl ShareAuthorityState {
+    fn new() -> Self {
+        Self {
+            pending_codes: HashMap::new(),
+            active_grants: HashMap::new(),
+            revoked_share_ids: HashSet::new(),
+            revocation_channels: HashMap::new(),
+        }
+    }
+
+    fn prune_expired(&mut self, now: u64) {
+        self.pending_codes.retain(|_, p| p.expires_at > now);
+
+        for grant in self.active_grants.values() {
+            if grant.revoked || now >= grant.expires_at {
+                self.revoked_share_ids.insert(grant.share_id.clone());
+                if let Some(tx) = self.revocation_channels.get_mut(&grant.share_id) {
+                    let _ = tx.send_replace(true);
+                }
+            }
+        }
+        self.active_grants.retain(|_, g| !g.revoked && g.expires_at > now);
+
+        let mut live_shares: HashSet<&str> = HashSet::new();
+        for p in self.pending_codes.values() {
+            live_shares.insert(&p.share_id);
+        }
+        for g in self.active_grants.values() {
+            live_shares.insert(&g.share_id);
+        }
+
+        // Bounded revocation registry: keep channels and tombstones only for live shares or bounded window
+        if self.revocation_channels.len() > MAX_REVOCATION_REGISTRY_ENTRIES {
+            self.revocation_channels.retain(|id, _| live_shares.contains(id.as_str()));
+        }
+        if self.revoked_share_ids.len() > MAX_REVOCATION_REGISTRY_ENTRIES {
+            self.revoked_share_ids.retain(|id| live_shares.contains(id.as_str()));
+        }
+    }
+}
