+    /// Revoking a HOST-SCOPED grant must clear exactly that host's holder from
+    /// the presence registry (keyed by the canonical requested id) and push the
+    /// convergence event under that same key — with NO collateral removal of a
+    /// same-named session under another host's scope.
+    #[tokio::test]
+    async fn test_route_revoke_clears_scoped_grant_presence_without_collateral() {
+        let (state, control_token, _) =
+            create_test_state(vec!["host-a::session-revoke-scoped".into()]);
+
+        let req = CreateShareRequest {
+            session_id: "host-a::session-revoke-scoped".into(),
+            permission: SharePermission::View,
+            ttl_seconds: None,
+        };
+        let res = create_share_handler(
+            State(Arc::clone(&state)),
+            auth_headers(&control_token),
+            Json(req),
+        )
+        .await
+        .unwrap();
+        let body_bytes = axum::body::to_bytes(res.into_body(), 64 * 1024).await.unwrap();
+        let issue: CreateShareResponse = serde_json::from_slice(&body_bytes).unwrap();
+        let grant = state
+            .share_manager
+            .exchange_code(&issue.exchange_code, None)
+            .unwrap();
+
+        // The holder's terminal socket attaches under the canonical requested id
+        // with the `share-{client_id}` device id the server builds for share
+        // sockets (server ws attach contract)…
+        let holder = crate::remote::presence::PresenceGuard::attach(
+            Arc::clone(&state),
+            "host-a::session-revoke-scoped",
+            &format!("share-{}", grant.client_id),
+            "view",
+        )
+        .expect("presence admission at capacity 1/64");
+        // …and another host's identically named session sits in its OWN bucket.
+        let other_host = crate::remote::presence::PresenceGuard::attach(
+            Arc::clone(&state),
+            "host-b::session-revoke-scoped",
+            "share-other-client",
+            "view",
+        )
+        .expect("presence admission at capacity 2/64");
+        assert_eq!(
+            state.presence.snapshot("host-a::session-revoke-scoped").len(),
+            1
+        );
+        assert_eq!(
+            state.presence.snapshot("host-b::session-revoke-scoped").len(),
+            1
+        );
+
+        let mut rx = state.event_tx.subscribe();
+
+        let revoke_res = revoke_share_handler(
+            State(Arc::clone(&state)),
+            AxumPath(issue.share_id.clone()),
+            auth_headers(&control_token),
+        )
+        .await
+        .expect("revoke should succeed");
+        assert_eq!(revoke_res.status(), StatusCode::OK);
+
+        // The revoked grant's host bucket is cleared…
+        assert!(
+            state
+                .presence
+                .snapshot("host-a::session-revoke-scoped")
+                .is_empty()
+        );
+        // …and the same-named session under another host's scope is untouched:
+        // no cross-host collateral from a scope-stripped removal.
+        assert_eq!(
+            state.presence.snapshot("host-b::session-revoke-scoped").len(),
+            1
+        );
+
+        // Drain the synchronous frames: the LAST must be the revoke push — the
+        // canonical key with an empty projection.
+        let mut last: Option<String> = None;
+        while let Some(Ok(frame)) = futures_util::FutureExt::now_or_never(rx.recv()) {
+            last = Some(frame);
+        }
+        let frame = last.expect("revoke pushes a presence frame");
+        let parsed: serde_json::Value = serde_json::from_str(&frame).unwrap();
+        assert_eq!(
+            parsed["payload"]["sessionId"].as_str(),
+            Some("host-a::session-revoke-scoped")
+        );
+        assert_eq!(parsed["payload"]["count"].as_u64(), Some(0));
+
+        drop(holder);
+        drop(other_host);
+    }
