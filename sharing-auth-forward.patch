+    /// Route-level access matrix for GET /api/v1/shares/{shareId} and the share
+    /// management surface: the share-id bind rejects BEFORE get_share (an unknown
+    /// id answers 403, never 404 — no existence oracle, no data access), the
+    /// canonical session-target bind guards the record, owner scope + Control
+    /// gate every device path (not any device), and revoked/expired grants are
+    /// refused at token validation.
+    #[tokio::test]
+    async fn test_get_share_route_access_matrix() {
+        let (state, control_token, view_token) = create_test_state(vec![
+            "session-matrix-a".into(),
+            "session-matrix-b".into(),
+        ]);
+
+        // A mirror-scoped CONTROL device: valid pairing, but not owner scope.
+        let mirror_code = state
+            .auth_manager
+            .create_pairing_code(crate::remote::auth::DevicePermission::Control);
+        let (mirror_token, _) = state
+            .auth_manager
+            .exchange_pairing_code(&mirror_code, "mirror-control")
+            .unwrap();
+
+        let (share_a_id, code_a, _, _) = state
+            .share_manager
+            .create_exchange_code("session-matrix-a", SharePermission::View, None)
+            .unwrap();
+        let grant_a = state.share_manager.exchange_code(&code_a, None).unwrap();
+        let (share_b_id, code_b, _, _) = state
+            .share_manager
+            .create_exchange_code("session-matrix-b", SharePermission::View, None)
+            .unwrap();
+        let _grant_b = state.share_manager.exchange_code(&code_b, None).unwrap();
+
+        // Owner (Machine + Control) device reads metadata.
+        let owner_read = get_share_handler(
+            State(Arc::clone(&state)),
+            AxumPath(share_a_id.clone()),
+            auth_headers(&control_token),
+        )
+        .await
+        .unwrap();
+        assert_eq!(owner_read.status(), StatusCode::OK);
+
+        // Mirror-scoped control device and view device: refused on get, list,
+        // issue and revoke — not any device.
+        for token in [&mirror_token, &view_token] {
+            let read = get_share_handler(
+                State(Arc::clone(&state)),
+                AxumPath(share_a_id.clone()),
+                auth_headers(token),
+            )
+            .await;
+            assert!(matches!(read, Err((StatusCode::FORBIDDEN, _))));
+
+            let list = list_shares_handler(
+                State(Arc::clone(&state)),
+                Query(ListSharesQuery {
+                    session_id: Some("session-matrix-a".into()),
+                }),
+                auth_headers(token),
+            )
+            .await;
+            assert!(matches!(list, Err((StatusCode::FORBIDDEN, _))));
+
+            let issue = create_share_handler(
+                State(Arc::clone(&state)),
+                auth_headers(token),
+                Json(CreateShareRequest {
+                    session_id: "session-matrix-a".into(),
+                    permission: SharePermission::View,
+                    ttl_seconds: None,
+                }),
+            )
+            .await;
+            assert!(matches!(issue, Err((StatusCode::FORBIDDEN, _))));
+
+            let revoke = revoke_share_handler(
+                State(Arc::clone(&state)),
+                AxumPath(share_a_id.clone()),
+                auth_headers(token),
+            )
+            .await;
+            assert!(matches!(revoke, Err((StatusCode::FORBIDDEN, _))));
+        }
+
+        // Token A against share B AND against an unknown id: 403 BEFORE the
+        // lookup — a post-lookup answer would be 404 (existence oracle) or B's
+        // metadata.
+        let cross = get_share_handler(
+            State(Arc::clone(&state)),
+            AxumPath(share_b_id.clone()),
+            auth_headers(&grant_a.share_token),
+        )
+        .await;
+        assert!(matches!(cross, Err((StatusCode::FORBIDDEN, _))));
+
+        let unknown = get_share_handler(
+            State(Arc::clone(&state)),
+            AxumPath("never-minted-share-id".into()),
+            auth_headers(&grant_a.share_token),
+        )
+        .await;
+        assert!(
+            matches!(unknown, Err((StatusCode::FORBIDDEN, _))),
+            "share-id bind must reject before get_share (404 would leak existence)"
+        );
+
+        // Token A against its own grant: allowed.
+        let own = get_share_handler(
+            State(Arc::clone(&state)),
+            AxumPath(share_a_id.clone()),
+            auth_headers(&grant_a.share_token),
+        )
+        .await
+        .expect("own grant reads its own metadata");
+        assert_eq!(own.status(), StatusCode::OK);
+
