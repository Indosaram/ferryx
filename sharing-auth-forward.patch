+            .values()
+            .filter(|g| g.share_id == share_id && !g.revoked && !state.revoked_share_ids.contains(&g.share_id) && g.expires_at > now)
+            .max_by_key(|g| g.expires_at)
+            .or_else(|| {
+                state
+                    .active_grants
+                    .values()
+                    .filter(|g| g.share_id == share_id)
+                    .max_by_key(|g| g.expires_at)
+            })
+            .cloned()
+    }
+
+    #[cfg(test)]
+    pub fn expire_code_for_test(&self, code: &str) {
+        let code_hash = hash_token_sha256(code);
+        let mut state = self.state.lock();
+        if let Some(entry) = state.pending_codes.get_mut(&code_hash) {
+            entry.expires_at = 0;
+        }
+    }
+
+    #[cfg(test)]
+    pub fn expire_grant_for_test(&self, share_id: &str) {
+        let mut state = self.state.lock();
+        for grant in state.active_grants.values_mut() {
+            if grant.share_id == share_id {
+                grant.expires_at = 0;
+            }
+        }
+    }
+}
