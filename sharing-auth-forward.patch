+    #[test]
+    fn test_alias_is_opaque_and_deterministic() {
+        let client = "share-0f0f1e2d-aaaa-bbbb-cccc-0123456789ab";
+        let first = alias_for(client, "view");
+        let second = alias_for(client, "view");
+        assert_eq!(first, second);
+        assert!(first.starts_with("Viewer-"));
+        assert!(!first.contains(client));
+        assert!(!first.contains("share-"));
+        assert_ne!(first, alias_for(client, "control"));
+        assert_ne!(first, alias_for("share-0f0f1e2d-aaaa-bbbb-cccc-0123456789ac", "view"));
+        assert!(alias_for("other", "control").starts_with("Control-"));
+    }
+
+    #[test]
+    fn test_join_leave_snapshot_and_idempotent_cleanup() {
+        let registry = PresenceRegistry::new();
+        let first = match registry.join("session-a", "device-1", "control") {
+            JoinOutcome::Attached { token, changed } => {
+                assert_eq!(changed.expect("first join changes projection").len(), 1);
+                token
+            }
+            JoinOutcome::Rejected => panic!("first join must attach"),
+        };
+        assert_eq!(registry.snapshot("session-a").len(), 1);
+
+        let second = match registry.join("session-a", "device-1", "control") {
+            JoinOutcome::Attached { token, changed } => {
+                assert!(changed.is_none(), "sibling join leaves projection unchanged");
+                token
+            }
+            JoinOutcome::Rejected => panic!("sibling join must attach"),
+        };
+        assert_eq!(registry.snapshot("session-a").len(), 1);
+
+        assert!(registry.leave("session-a", first).is_none());
+        assert_eq!(registry.snapshot("session-a").len(), 1);
+        assert!(registry.leave("session-a", first).is_none());
+        assert!(registry.leave("session-a", second).is_some());
+        assert!(registry.snapshot("session-a").is_empty());
+        assert!(registry.leave("session-a", second).is_none());
+        assert!(registry.sessions.lock().get("session-a").is_none());
+    }
