+    #[test]
+    fn test_registry_bounds_reject_admission_without_evicting_lives() {
+        let registry = PresenceRegistry::new();
+        for i in 0..MAX_PARTICIPANTS_PER_SESSION {
+            assert!(matches!(
+                registry.join("session-bounded", &format!("client-{i}"), "view"),
+                JoinOutcome::Attached { .. }
+            ));
+        }
+        assert!(matches!(
+            registry.join("session-bounded", "client-late", "view"),
+            JoinOutcome::Rejected
+        ));
+        assert_eq!(
+            registry.snapshot("session-bounded").len(),
+            MAX_PARTICIPANTS_PER_SESSION
+        );
+
+        let registry = PresenceRegistry::new();
+        for i in 0..MAX_TRACKED_SESSIONS {
+            assert!(matches!(
+                registry.join(&format!("session-{i}"), "device-1", "control"),
+                JoinOutcome::Attached { .. }
+            ));
+        }
+        assert!(matches!(
+            registry.join("session-new", "device-1", "control"),
+            JoinOutcome::Rejected
+        ));
+        let sessions = registry.sessions.lock();
+        assert_eq!(sessions.len(), MAX_TRACKED_SESSIONS);
+        assert!(
+            sessions.contains_key("session-0"),
+            "a live session must never be evicted to make room"
+        );
+        assert!(!sessions.contains_key("session-new"));
+        drop(sessions);
+
+        let state = test_state();
+        for i in 0..MAX_PARTICIPANTS_PER_SESSION {
+            assert!(PresenceGuard::attach(
+                Arc::clone(&state),
+                "session-ful",
+                &format!("client-{i}"),
+                "view",
+            )
+            .is_some());
+        }
+        assert!(
+            PresenceGuard::attach(Arc::clone(&state), "session-ful", "client-late", "view")
+                .is_none(),
+            "capacity rejects the new admission instead of evicting a live socket"
+        );
+    }
